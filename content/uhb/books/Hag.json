{"translation":"uhb","osis":"Hag","name":"Haggai","testament":"ot","title":"Haggai","chapters":[{"n":1,"verses":[{"n":1,"text":"בִּשְׁנַ֤ת שְׁתַּ֨יִם֙ לְדָרְיָ֣וֶשׁ הַמֶּ֔לֶךְ בַּחֹ֨דֶשׁ֙ הַשִּׁשִּׁ֔י בְּי֥וֹם אֶחָ֖ד לַחֹ֑דֶשׁ הָיָ֨ה דְבַר־יְהוָ֜ה בְּיַד־חַגַּ֣י הַנָּבִ֗יא אֶל־זְרֻבָּבֶ֤ל בֶּן־שְׁאַלְתִּיאֵל֙ פַּחַ֣ת יְהוּדָ֔ה וְאֶל־יְהוֹשֻׁ֧עַ בֶּן־יְהוֹצָדָ֛ק הַכֹּהֵ֥ן הַגָּד֖וֹל לֵאמֹֽר׃","br":1,"sp":{"w":[[0,10,"b:H8141","שָׁנָה","He,R:Ncfsc"],[11,22,"H8147","שְׁנַיִם","He,Acfda"],[23,36,"l:H1867","דָּֽרְיָוֵשׁ","He,R:Np"],[37,47,"d:H4428","מֶלֶךְ","He,Td:Ncmsa"],[48,59,"b:H2320","חֹדֶשׁ","He,Rd:Ncmsa"],[60,72,"d:H8345","שִׁשִּׁי","He,Td:Aomsa"],[73,81,"b:H3117","יוֹם","He,R:Ncmsa"],[82,88,"H0259","אֶחָד","He,Acmsa"],[89,98,"l:H2320","חֹדֶשׁ","He,Rd:Ncmsa"],[99,105,"H1961","הָיָה","He,Vqp3ms"],[106,111,"H1697","דָּבָר","He,Ncmsc"],[112,119,"H3068","יְהֹוָה","He,Np"],[120,126,"b:H3027","יָד","He,R:Ncbsc"],[127,134,"H2292a","חַגַּי","He,Np"],[135,145,"d:H5030","נָבִיא","He,Td:Ncmsa"],[146,149,"H0413","אֵל","He,R"],[150,161,"H2216","זְרֻבָּבֶל","He,Np"],[162,166,"H1121a","בֵּן","He,Ncmsc"],[167,182,"H7597a","שְׁאַלְתִּיאֵל","He,Np"],[183,190,"H6346","פֶּחָה","He,Ncmsc"],[191,200,"H3063","יְהוּדָה","He,Np"],[201,206,"c:H0413","אֵל","He,C:R"],[207,218,"H3091","יְהוֹשׁוּעַ","He,Np"],[219,223,"H1121a","בֵּן","He,Ncmsc"],[224,235,"H3087","יְהוֹצָדָק","He,Np"],[236,245,"d:H3548","כֹּהֵן","He,Td:Ncmsa"],[246,256,"d:H1419a","גָּדוֹל","He,Td:Aamsa"],[257,264,"l:H0559","אָמַר","He,R:Vqc"]]}},{"n":2,"text":"כֹּ֥ה אָמַ֛ר יְהוָ֥ה צְבָא֖וֹת לֵאמֹ֑ר הָעָ֤ם הַזֶּה֙ אָֽמְר֔וּ לֹ֥א עֶת־בֹּ֛א עֶת־בֵּ֥ית יְהוָ֖ה לְהִבָּנֽוֹת׃פ","sp":{"w":[[0,5,"H3541","כֹּה","He,D"],[6,12,"H0559","אָמַר","He,Vqp3ms"],[13,20,"H3068","יְהֹוָה","He,Np"],[21,30,"H6635b","צָבָא","He,Ncbpa"],[31,38,"l:H0559","אָמַר","He,R:Vqc"],[39,45,"d:H5971a","עַם","He,Td:Ncmsa"],[46,53,"d:H2088","זֶה","He,Td:Pdxms"],[54,63,"H0559","אָמַר","He,Vqp3cp"],[64,68,"H3808","לֹא","He,Tn"],[69,72,"H6256","עֵת","He,Ncbsc"],[73,78