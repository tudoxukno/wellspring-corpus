{"translation":"ult","osis":"Phlm","name":"Philemon","testament":"nt","title":"Philemon","chapters":[{"n":1,"verses":[{"n":1,"text":"Paul, a prisoner of Christ Jesus, and our brother Timothy to Philemon, the beloved and our fellow worker,","br":1,"sp":{"w":[[0,4,"G39720"],[6,7,"G11980"],[8,16,"G11980"],[17,19,"G55470"],[20,26,"G55470"],[27,32,"G24240"],[34,37,"G25320"],[38,41,"G35880"],[42,49,"G00800"],[50,57,"G50950"],[58,60,"G53710"],[61,69,"G53710"],[71,74,"G35880"],[75,82,"G00270"],[83,86,"G25320"],[87,90,"G14730"],[91,97,"G49040"],[98,104,"G49040"]]}},{"n":2,"text":"and to Apphia our sister, and to Archippus our fellow soldier, and to the church in your house.","sp":{"w":[[0,3,"G25320"],[4,6,"G06820"],[7,13,"G06820"],[14,17,"G35880"],[18,24,"G00790"],[26,29,"G25320"],[30,32,"G07510"],[33,42,"G07510"],[43,46,"G14730"],[47,53,"G49610"],[54,61,"G49610"],[63,66,"G25320"],[67,69,"G15770"],[70,73,"G15770"],[74,80,"G15770"],[81,83,"G25960"],[84,88,"G47710"],[89,94,"G36240"]]}},{"n":3,"text":"Grace to you and peace from God our Father and our Lord Jesus Christ.","sp":{"w":[[0,5,"G54850"],[6,8,"G47710"],[9,12,"G47710"],[13,16,"G25320"],[17,22,"G15150"],[23,27,"G05750"],[28,31,"G23160"],[32,35,"G14730"],[36,42,"G39620"],[43,46,"G25320"],[47,50,"G14730"],[51,55,"G29620"],[56,61,"G24240"],[62,68,"G55470"]]}},{"n":4,"text":"I always thank my God, making mention of you in my prayers,","br":1,"sp":{"w":[[0,1,"G21680"],[2,8,"G38420"],[9,14,"G21680"],[15,17,"G14730"],[18,21,"G23160"],[23,29,"G41600"],[30,37,"G34170"],[38,40,"G47710"],[41,44,"G47710"],[45,47,"G19090"],[48,50,"G14730"],[51,58,"G43350"]]}},{"n":5,"text":"hearing of your love and the faith that you have in the Lord Jesus and for all the saints,","sp":{"w":[[0,7,"G01910"],[8,10,"G01910"],[11,15,"G47710"],[16,20,"G00260"],[21,24,"G25320"],[25,28,"G35880"],[29,34,"G41020"],[35,39,"G37390"],[40,43,"G21920"],[44,48,"G21920"],[49,51,"G43140"],[52,55,"G35880"],[56,60,"G29620"],[61,66,"G24240"],[67,70,"G25320"],[71,74,"G15190"],[75,78,"G39560"],[79,82,"G35880"],[83,89,"G00400"]]}},{"n":6,"text":"that the fellowship of your faith may become effective through the knowledge of everything good {that is} among us for Christ.","sp":{"w":[[0,4,"G37040"],[5,8,"G35880"],[9,19,"G28420"],[20,22,"G41020"],[23,27,"G47710"],[28,33,"G41020"],[34,37,"G10960"],[38,44,"G10960"],[45,54,"G17560"],[55,62,"G17220"],[63,66,"G19220"],[67,76,"G19220"],[77,79,"G39560"],[80,90,"G39560"],[91,95,"G00180"],[97,101,"G35880"],[102,104,"G35880"],[106,111,"G17220"],[112,114,"G14730"],[115,118,"G15190"],[119,125,"G55470"]]}},{"n":7,"text":"For I had much joy and comfort because of your love, because the inner parts of the saints are being refreshed by you, brother.","sp":{"w":[[0,3,"G10630"],[4,5,"G21920"],[6,9,"G21920"],[10,14,"G41830"],[15,18,"G54790"],[19,22,"G25320"],[23,30,"G38740"],[31,38,"G19090"],[39,41,"G19090"],[42,46,"G47710"],[47,51,"G00260"],[53,60,"G37540"],[61,64,"G35880"],[65,70,"G46980"],[71,76,"G46980"],[77,79,"G00400"],[80,83,"G00400"],[84,90,"G00400"],[91,94,"G03730"],[95,100,"G03730"],[101,110,"G03730"],[111,113,"G12230"],[114,117,"G47710"],[119,126,"G00800"]]}},{"n":8,"text":"Therefore, having much boldness in Christ to command you the {thing that} is proper {to do},","br":1,"sp":{"w":[[0,9,"G13520"],[11,17,"G21920"],[18,22,"G41830"],[23,31,"G39540"],[32,34,"G17220"],[35,41,"G55470"],[42,44,"G20040"],[45,52,"G20040"],[53,56,"G47710"],[57,60,"G35880"],[62,67,"G35880"],[68,72,"G35880"],[74,76,"G04330"],[77,83,"G04330"],[85,87,"G04330"],[88,90,"G04330"]]}},{"n":9,"text":"because of love I appeal to you instead—being such a one as Paul, an elder, and now also a prisoner of Christ Jesus.","sp":{"w":[[0,7,"G12230"],[8,10,"G12230"],[11,15,"G00260"],[16,17,"G38700"],[18,24,"G38700"],[25,27,"G38700"],[28,31,"G38700"],[32,39,"G31230"],[40,45,"G15100"],[46,50,"G51080"],[51,52,"G51080"],[53,56,"G51080"],[57,59,"G56130"],[60,64,"G39720"],[66,68,"G42460"],[69,74,"G42460"],[76,79,"G11610"],[80,83,"G35680"],[84,88,"G25320"],[89,90,"G11980"],[91,99,"G11980"],[100,102,"G55470"],[103,109,"G55470"],[110,115,"G24240"]]}},{"n":10,"text":"I am appealing to you on behalf of my child Onesimus, whom I have fathered in my chains.","sp":{"w":[[0,1,"G38700"],[2,4,"G38700"],[5,14,"G38700"],[15,17,"G38700"],[18,21,"G47710"],[22,24,"G40120"],[25,31,"G40120"],[32,34,"G40120"],[35,37,"G16990"],[38,43,"G50430"],[44,52,"G36820"],[54,58,"G37390"],[59,60,"G10800"],[61,65,"G10800"],[66,74,"G10800"],[75,77,"G17220"],[78,80,"G35880"],[81,87,"G11990"]]}},{"n":11,"text":"The one formerly useless to you, but now useful both to you and to me,","sp":{"w":[[0,3,"G35880"],[4,7,"G35880"],[8,16,"G42180"],[17,24,"G08900"],[25,27,"G47710"],[28,31,"G47710"],[33,36,"G11610"],[37,40,"G35680"],[41,47,"G21730"],[48,52,"G25320"],[53,55,"G47710"],[56,59,"G47710"],[60,63,"G25320"],[64,66,"G14730"],[67,69,"G14730"]]}},{"n":12,"text":"whom I have sent back to you—him—this one is my inner parts;","sp":{"w":[[0,4,"G37390"],[5,6,"G03750"],[7,11,"G03750"],[12,16,"G03750"],[17,21,"G03750"],[22,24,"G47710"],[25,28,"G47710"],[29,32,"G08460"],[33,37,"G37780"],[38,41,"G37780"],[42,44,"G15100"],[45,47,"G16990"],[48,53,"G46980"],[54,59,"G46980"]]}},{"n":13,"text":"whom I desired to keep with me, so that he might serve me on behalf of you in the chains of the gospel.","sp":{"w":[[0,4,"G37390"],[5,6,"G14730"],[7,14,"G10140"],[15,17,"G27220"],[18,22,"G27220"],[23,27,"G43140"],[28,30,"G16830"],[32,34,"G24430"],[35,39,"G24430"],[40,42,"G12470"],[43,48,"G12470"],[49,54,"G12470"],[55,57,"G14730"],[58,60,"G52280"],[61,67,"G52280"],[68,70,"G52280"],[71,74,"G47710"],[75,77,"G17220"],[78,81,"G35880"],[82,88,"G11990"],[89,91,"G20980"],[92,95,"G20980"],[96,102,"G20980"]]}},{"n":14,"text":"But I did not want to do anything without your consent, so that your good {deed} might not be as according to compulsion but according to good will.","sp":{"w":[[0,3,"G11610"],[4,5,"G23090"],[6,9,"G23090"],[10,13,"G37620"],[14,18,"G23090"],[19,21,"G41600"],[22,24,"G41600"],[25,33,"G37620"],[34,41,"G55650"],[42,46,"G46740"],[47,54,"G11060"],[56,58,"G24430"],[59,63,"G24430"],[64,68,"G47710"],[69,73,"G00180"],[75,79,"G00180"],[81,86,"G15100"],[87,90,"G33610"],[91,93,"G15100"],[94,96,"G56130"],[97,106,"G25960"],[107,109,"G25960"],[110,120,"G03180"],[121,124,"G02350"],[125,134,"G25960"],[135,137,"G25960"],[138,142,"G15950"],[143,147,"G15950"]]}},{"n":15,"text":"For perhaps because of this he was separated from {you} for an hour, so that you might have him back forever,","sp":{"w":[[0,3,"G10630"],[4,11,"G50290"],[12,19,"G12230"],[20,22,"G12230"],[23,27,"G37780"],[28,30,"G55630"],[31,34,"G55630"],[35,44,"G55630"],[45,49,"G55630"],[51,54,"G55630"],[56,59,"G43140"],[60,62,"G56100"],[63,67,"G56100"],[69,71,"G24430"],[72,76,"G24430"],[77,80,"G05680"],[81,86,"G05680"],[87,91,"G05680"],[92,95,"G08460"],[96,100,"G05680"],[101,108,"G01660"]]}},{"n":16,"text":"no longer as a slave, but better than a slave—a beloved brother, especially to me, but much more so to you, in both the flesh and in the Lord.","sp":{"w":[[0,2,"G37650"],[3,9,"G37650"],[10,12,"G56130"],[13,14,"G14010"],[15,20,"G14010"],[22,25,"G02350"],[26,32,"G52280"],[33,37,"G52280"],[38,39,"G14010"],[40,45,"G14010"],[46,47,"G00800"],[48,55,"G00270"],[56,63,"G00800"],[65,75,"G31220"],[76,78,"G14730"],[79,81,"G14730"],[83,86,"G11610"],[87,91,"G42140"],[92,96,"G31230"],[97,99,"G31230"],[100,102,"G47710"],[103,106,"G47710"],[108,110,"G17220"],[111,115,"G25320"],[116,119,"G45610"],[120,125,"G45610"],[126,129,"G25320"],[130,132,"G17220"],[133,136,"G29620"],[137,141,"G29620"]]}},{"n":17,"text":"Therefore, if you have me {as} a partner, receive him as me.","sp":{"w":[[0,9,"G37670"],[11,13,"G14870"],[14,17,"G21920"],[18,22,"G21920"],[23,25,"G14730"],[27,29,"G21920"],[31,32,"G28440"],[33,40,"G28440"],[42,49,"G43550"],[50,53,"G08460"],[54,56,"G56130"],[57,59,"G14730"]]}},{"n":18,"text":"But if he has wronged you or owes {you} anything, charge that to me.","sp":{"w":[[0,3,"G11610"],[4,6,"G14870"],[7,9,"G00910"],[10,13,"G00910"],[14,21,"G00910"],[22,25,"G47710"],[26,28,"G22280"],[29,33,"G37840"],[35,38,"G37840"],[40,48,"G51000"],[50,56,"G16770"],[57,61,"G37780"],[62,64,"G14730"],[65,67,"G14730"]]}},{"n":19,"text":"I, Paul, wrote this with my own hand. I myself will pay it back—in order not to say to you that you also owe me even your own self!","sp":{"w":[[0,1,"G14730"],[3,7,"G39720"],[9,14,"G11250"],[15,19,"G11250"],[20,24,"G54950"],[25,27,"G16990"],[28,31,"G16990"],[32,36,"G54950"],[38,39,"G06610"],[40,46,"G14730"],[47,51,"G06610"],[52,55,"G06610"],[56,58,"G06610"],[59,63,"G06610"],[64,66,"G24430"],[67,72,"G24430"],[73,76,"G33610"],[77,79,"G30040"],[80,83,"G30040"],[84,86,"G47710"],[87,90,"G47710"],[91,95,"G37540"],[96,99,"G43590"],[100,104,"G43590"],[105,108,"G43590"],[109,111,"G14730"],[112,116,"G25320"],[117,121,"G45720"],[122,125,"G45720"],[126,130,"G45720"]]}},{"n":20,"text":"Yes, brother, may I benefit from you in the Lord; refresh my inner parts in Christ.","sp":{"w":[[0,3,"G34830"],[5,12,"G00800"],[14,17,"G36850"],[18,19,"G14730"],[20,27,"G36850"],[28,32,"G47710"],[33,36,"G47710"],[37,39,"G17220"],[40,43,"G29620"],[44,48,"G29620"],[50,57,"G03730"],[58,60,"G14730"],[61,66,"G46980"],[67,72,"G46980"],[73,75,"G17220"],[76,82,"G55470"]]}},{"n":21,"text":"Having become confident in your obedience, I wrote to you, having known that you will do even beyond what I am saying.","br":1,"sp":{"w":[[0,6,"G39820"],[7,13,"G39820"],[14,23,"G39820"],[24,26,"G52180"],[27,31,"G47710"],[32,41,"G52180"],[43,44,"G11250"],[45,50,"G11250"],[51,53,"G47710"],[54,57,"G47710"],[59,65,"G14920"],[66,71,"G14920"],[72,76,"G37540"],[77,80,"G41600"],[81,85,"G41600"],[86,88,"G41600"],[89,93,"G25320"],[94,100,"G52280"],[101,105,"G37390"],[106,107,"G30040"],[108,110,"G30040"],[111,117,"G30040"]]}},{"n":22,"text":"But at the same time, also prepare a guest room for me, for I hope that through your prayers I will be given back to you.","sp":{"w":[[0,3,"G11610"],[4,6,"G02600"],[7,10,"G02600"],[11,15,"G02600"],[16,20,"G02600"],[22,26,"G25320"],[27,34,"G20900"],[35,36,"G35780"],[37,42,"G35780"],[43,47,"G35780"],[48,51,"G14730"],[52,54,"G14730"],[56,59,"G10630"],[60,61,"G16790"],[62,66,"G16790"],[67,71,"G37540"],[72,79,"G12230"],[80,84,"G47710"],[85,92,"G43350"],[93,94,"G54830"],[95,99,"G54830"],[100,102,"G54830"],[103,108,"G54830"],[109,113,"G54830"],[114,116,"G47710"],[117,120,"G47710"]]}},{"n":23,"text":"Epaphras, my fellow prisoner in Christ Jesus, greets you,","br":1,"sp":{"w":[[0,8,"G18890"],[10,12,"G14730"],[13,19,"G48690"],[20,28,"G48690"],[29,31,"G17220"],[32,38,"G55470"],[39,44,"G24240"],[46,52,"G07820"],[53,56,"G47710"]]}},{"n":24,"text":"Mark, Aristarchus, Demas, {and} Luke, my fellow workers.","sp":{"w":[[0,4,"G31380"],[6,17,"G07080"],[19,24,"G12140"],[27,30,"G30650"],[32,36,"G30650"],[38,40,"G14730"],[41,47,"G49040"],[48,55,"G49040"]]}},{"n":25,"text":"The grace of our Lord Jesus Christ {be} with your spirit. Amen.","br":1,"sp":{"w":[[0,3,"G35880"],[4,9,"G54850"],[10,12,"G29620"],[13,16,"G14730"],[17,21,"G29620"],[22,27,"G24240"],[28,34,"G55470"],[36,38,"G33260"],[40,44,"G33260"],[45,49,"G47710"],[50,56,"G41510"],[58,62,"G02810"]]}}]}]}
