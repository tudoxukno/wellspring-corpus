8"],[24,28,"c:H1961"],[29,31,"b:H3027"],[32,35,"b:H3027"],[36,40,"b:H3027"],[41,43,"b:H3027"],[44,50,"H2292a"],[51,54,"d:H5030"],[55,62,"d:H5030"],[64,70,"l:H0559"]]}},{"n":4,"text":"“{Is it} a time for you yourselves to live in your paneled houses, while this house {is} desolate?","sp":{"w":[[2,4,"i:H6256"],[5,7,"i:H6256"],[9,10,"i:H6256"],[11,15,"i:H6256"],[16,19,"l"],[20,23,"l"],[24,34,"H0859d"],[35,37,"l:H3427"],[38,42,"l:H3427"],[43,45,"b:H1004b"],[46,50,"b:H1004b"],[51,58,"H5603"],[59,65,"b:H1004b"],[67,72,"c:d:H1004b"],[73,77,"d:H2088"],[78,83,"c:d:H1004b"],[85,87,"H2720b"],[89,97,"H2720b"]]}},{"n":5,"text":"So now, thus says Yahweh of Armies: ‘Set your heart upon your ways!","sp":{"w":[[0,2,"c:H6258"],[3,6,"c:H6258"],[8,12,"H3541"],[13,17,"H0559"],[18,24,"H3068"],[25,27,"H3068"],[28,34,"H6635b"],[37,40,"H7760a"],[41,45,"H3824"],[46,51,"H3824"],[52,56,"H5921a"],[57,61,"H1870"],[62,66,"H1870"]]}},{"n":6,"text":"You have sown much, but you have brought in little. You eat, but not to satiety. You drink, but not {enough} to become drunk. One wears clothes, but he does not warm himself. And the wage earner earns wages into a punctured bag!’","q":1,"sp":{"w":[[0,3,"H2232"],[4,8,"H2232"],[9,13,"H2232"],[14,18,"H7235a"],[20,23,"c:H0935"],[24,27,"c:H0935"],[28,32,"c:H0935"],[33,40,"c:H0935"],[41,43,"c:H0935"],[44,50,"H4592"],[52,55,"H0398"],[56,59,"H0398"],[61,64,"c:H0369"],[65,68,"c:H0369"],[69,71,"l:H7654"],[72,79,"l:H7654"],[81,84,"H8354"],[85,90,"H8354"],[92,95,"c:H0369"],[96,99,"c:H0369"],[101,107,"c:H0369"],[109,111,"l:H7937"],[112,118,"l:H7937"],[119,124,"l:H7937"],[126,129,"H3847"],[130,135,"H3847"],[136,143,"H3847"],[145,148,"c:H0369"],[149,151,"l:H2527"],[152,156,"l:H2527"],[157,160,"c:H0369"],[161,165,"l:H2527"],[166,173,"l"],[175,178,"c:d:H7936b"],[179,182,"c:d:H7936b"],[183,187,"c:d:H7936b"],[188,194,"c:d:H7936b"],[195,200,"H7936b"],[201,206,"H7936b"],[207,211,"H0413"],[212,213,"H6872a"],[214,223,"H5344a"],[224,227,"H6872a"]]}},{"n":7,"text":"Thus says Yahweh of Armies: ‘Set your heart upon your ways!","q":1,"sp":{"w":[[0,4,"H3541"],[5,9,"H0559"],[10,16,"H3068"],[17,19,"H3068"],[20,26,"H6635b"],[29,32,"H7760a"],[33,37,"H3824"],[38,43,"H3824"],[44,48,"H5921a"],[49,53,"H1870"],[54,58,"H1870"]]}},{"n":8,"text":"Go up {to} the mountain and bring timber and build the house, and I will take pleasure in it, and I will be glorified,’ says Yahweh.","q":1,"sp":{"w":[[0,2,"H5927"],[3,5,"H5927"],[7,9,"d:H2022"],[11,14,"d:H2022"],[15,23,"d:H2022"],[24,27,"c:H0935"],[28,33,"c:H0935"],[34,40,"H6086"],[41,44,"c:H1129"],[45,50,"c:H1129"],[51,54,"d:H1004b"],[55,60,"d:H1004b"],[62,65,"c:H7521"],[66,67,"c:H7521"],[68,72,"c:H7521"],[73,77,"c:H7521"],[78,86,"c:H7521"],[87,89,"b"],[90,92,"b"],[94,97,"c:H3513"],[98,99,"c:H3513"],[100,104,"c:H3513"],[105,107,"c:H3513"],[108,117,"c:H3513"],[120,124,"H0559"],[125,131,"H3068"]]}},{"n":9,"text":"‘You looked for much, but behold, little! And you brought {it} home, but I blew upon it! ‘Because of my house, that it {is} desolate, but you are running, a man to his house.","q":1,"sp":{"w":[[1,4,"H6437"],[5,11,"H6437"],[12,15,"H0413"],[16,20,"H7235a"],[22,25,"c:H2009"],[26,32,"c:H2009"],[34,40,"l:H4592"],[42,45,"c:H0935"],[46,49,"c:H0935"],[50,57,"c:H0935"],[59,61,"c:H0935"],[63,67,"d:H1004b"],[69,72,"c:H5301"],[73,74,"c:H5301"],[75,79,"c:H5301"],[80,84,"b"],[85,87,"b"],[90,97,"H3282"],[98,100,"H3282"],[101,103,"H1004b"],[104,109,"H1004b"],[111,115,"H0834a"],[116,118,"H1931"],[120,122,"H1931"],[124,132,"H2720b"],[134,137,"c:H0859d"],[138,141,"c:H0859d"],[142,145,"H7323"],[146,153,"H7323"],[155,156,"H0376"],[157,160,"H0376"],[161,163,"l:H1004b"],[164,167,"l:H1004b"],[168,173,"l:H1004b"]]}},{"n":10,"text":"Therefore the heavens above you refrain from dew and the earth withholds its produce.","q":1,"br":1,"sp":{"w":[[0,9,"H3651c"],[10,13,"H8064"],[14,21,"H8064"],[22,27,"H5921a"],[28,31,"H5921a"],[32,39,"H3607"],[40,44,"m:H2919"],[45,48,"m:H2919"],[49,52,"c:d:H0776"],[53,56,"c:d:H0776"],[57,62,"c:d:H0776"],[63,72,"H3607"],[73,76,"H2981"],[77,84,"H2981"]]}},{"n":11,"text":"And I have called for desolation upon the land and upon the mountains and upon the grain and upon the new wine and upon the oil and upon what the ground produces and upon the man and upon the beast and upon all the labor of {your} hands!’”","q":1,"sp":{"w":[[0,3,"c:H7121"],[4,5,"c:H7121"],[6,10,"c:H7121"],[11,17,"c:H7121"],[18,21,"c:H7121"],[22,32,"H2721a"],[33,37,"H5921a"],[38,41,"d:H0776"],[42,46,"d:H0776"],[47,50,"c:H5921a"],[51,55,"c:H5921a"],[56,59,"d:H2022"],[60,69,"d:H2022"],[70,73,"c:H5921a"],[74,78,"c:H5921a"],[79,82,"d:H1715"],[83,88,"d:H1715"],[89,92,"c:H5921a"],[93,97,"c:H5921a"],[98,101,"d:H8492"],[102,105,"d:H8492"],[106,110,"d:H8492"],[111,114,"c:H5921a"],[115,119,"c:H5921a"],[120,123,"d:H3323"],[124,127,"d:H3323"],[128,131,"c:H5921a"],[132,136,"c:H5921a"],[137,141,"H0834a"],[142,145,"d:H0127"],[146,152,"d:H0127"],[153,161,"H3318"],[162,165,"c:H5921a"],[166,170,"c:H5921a"],[171,174,"d:H0120"],[175,178,"d:H0120"],[179,182,"c:H5921a"],[183,187,"c:H5921a"],[188,191,"d:H0929"],[192,197,"d:H0929"],[198,201,"c:H5921a"],[202,206,"c:H5921a"],[207,210,"H3605"],[211,214,"H3018"],[215,220,"H3018"],[221,223,"H3018"],[225,229,"H3709"],[231,236,"H3709"]]}},{"n":12,"text":"Then Zerubbabel son of Shealtiel and Joshua son of Jehozadak, the high priest, and all of the remnant of the people listened to the voice of Yahweh their God and to the words of Haggai the prophet, because Yahweh their God had sent him and the people feared the face of Yahweh.","br":1,"sp":{"w":[[0,4,"c:H8085"],[5,15,"H2216"],[16,19,"H1121a"],[20,22,"H1121a"],[23,32,"H7597b"],[33,36,"c:H3091"],[37,43,"c:H3091"],[44,47,"H1121a"],[48,50,"H1121a"],[51,60,"H3087"],[62,65,"d:H3548"],[66,70,"d:H1419a"],[71,77,"d:H3548"],[79,82,"c:H3605"],[83,86,"c:H3605"],[87,89,"c:H3605"],[90,93,"H7611"],[94,101,"H7611"],[102,104,"H7611"],[105,108,"d:H5971a"],[109,115,"d:H5971a"],[116,124,"c:H8085"],[125,127,"b:H6963a"],[128,131,"b:H6963a"],[132,137,