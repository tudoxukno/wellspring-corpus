{"translation":"ult","osis":"1Thess","name":"1 Thessalonians","testament":"nt","title":"First Thessalonians","chapters":[{"n":1,"verses":[{"n":1,"text":"Paul and Silvanus and Timothy, to the church of the Thessalonians in God the Father and the Lord Jesus Christ. Grace to you and peace.","br":1,"sp":{"w":[[0,4,"G39720"],[5,8,"G25320"],[9,17,"G46100"],[18,21,"G25320"],[22,29,"G50950"],[31,33,"G15770"],[34,37,"G15770"],[38,44,"G15770"],[45,47,"G23310"],[48,51,"G23310"],[52,65,"G23310"],[66,68,"G17220"],[69,72,"G23160"],[73,76,"G39620"],[77,83,"G39620"],[84,87,"G25320"],[88,91,"G29620"],[92,96,"G29620"],[97,102,"G24240"],[103,109,"G55470"],[111,116,"G54850"],[117,119,"G47710"],[120,123,"G47710"],[124,127,"G25320"],[128,133,"G15150"]]}},{"n":2,"text":"We give thanks to God always for all of you, making mention {of you} in our prayers continually,","br":1,"sp":{"w":[[0,2,"G21680"],[3,7,"G21680"],[8,14,"G21680"],[15,17,"G23160"],[18,21,"G23160"],[22,28,"G38420"],[29,32,"G40120"],[33,36,"G39560"],[37,39,"G47710"],[40,43,"G47710"],[45,51,"G41600"],[52,59,"G34170"],[61,63,"G34170"],[64,67,"G34170"],[69,71,"G19090"],[72,75,"G14730"],[76,83,"G43350"],[84,95,"G00890"]]}},{"n":3,"text":"remembering your work of faith and labor of love and endurance of hope of our Lord Jesus Christ before our God and Father;","sp":{"w":[[0,11,"G34210"],[12,16,"G47710"],[17,21,"G20410"],[22,24,"G41020"],[25,30,"G41020"],[31,34,"G25320"],[35,40,"G28730"],[41,43,"G00260"],[44,48,"G00260"],[49,52,"G25320"],[53,62,"G52810"],[63,65,"G16800"],[66,70,"G16800"],[71,73,"G29620"],[74,77,"G14730"],[78,82,"G29620"],[83,88,"G24240"],[89,95,"G55470"],[96,102,"G17150"],[103,106,"G14730"],[107,110,"G23160"],[111,114,"G25320"],[115,121,"G39620"]]}},{"n":4,"text":"knowing, brothers loved by God, your election,","sp":{"w":[[0,7,"G14920"],[9,17,"G00800"],[18,23,"G00250"],[24,26,"G52590"],[27,30,"G23160"],[32,36,"G47710"],[37,45,"G15890"]]}},{"n":5,"text":"because our gospel did not come to you in word only, but also in power and in the Holy Spirit and in much assurance—just as you know what kind {of men} we were among you for your sake.","sp":{"w":[[0,7,"G37540"],[8,11,"G14730"],[12,18,"G20980"],[19,22,"G10960"],[23,26,"G37560"],[27,31,"G10960"],[32,34,"G15190"],[35,38,"G47710"],[39,41,"G17220"],[42,46,"G30560"],[47,51,"G34400"],[53,56,"G02350"],[57,61,"G25320"],[62,64,"G17220"],[65,70,"G14110"],[71,74,"G25320"],[75,77,"G17220"],[78,81,"G41510"],[82,86,"G00400"],[87,93,"G41510"],[94,97,"G25320"],[98,100,"G41360"],[101,105,"G41830"],[106,115,"G41360"],[116,120,"G25310"],[121,123,"G25310"],[124,127,"G14920"],[128,132,"G14920"],[133,137,"G36340"],[138,142,"G36340"],[144,146,"G36340"],[147,150,"G36340"],[152,154,"G10960"],[155,159,"G10960"],[160,165,"G17220"],[166,169,"G47710"],[170,173,"G12230"],[174,178,"G47710"],[179,183,"G12230"]]}},{"n":6,"text":"And you yourselves became imitators of us and of the Lord, having received the word in much affliction, with joy of the Holy Spirit,","sp":{"w":[[0,3,"G25320"],[4,7,"G10960"],[8,18,"G47710"],[19,25,"G10960"],[26,35,"G34020"],[36,38,"G14730"],[39,41,"G14730"],[42,45,"G25320"],[46,48,"G29620"],[49,52,"G29620"],[53,57,"G29620"],[59,65,"G12090"],[66,74,"G12090"],[75,78,"G35880"],[79,83,"G30560"],[84,86,"G17220"],[87,91,"G41830"],[92,102,"G23470"],[104,108,"G33260"],[109,112,"G54790"],[113,115,"G41510"],[116,119,"G41510"],[120,124,"G00400"],[125,131,"G41510"]]}},{"n":7,"text":"so that you became examples to all the ones believing in Macedonia and in Achaia.","sp":{"w":[[0,2,"G56200"],[3,7,"G56200"],[8,11,"G47710"],[12,18,"G10960"],[19,27,"G51790"],[28,30,"G35880"],[31,34,"G39560"],[35,38,"G35880"],[39,43,"G35880"],[44,53,"G41000"],[54,56,"G17220"],[57,66,"G31090"],[67,70,"G25320"],[71,73,"G17220"],[74,80,"G08820"]]}},{"n":8,"text":"For from you the word of the Lord has been sounded out not only in Macedonia and in Achaia, but your faith toward God has gone out into every place, so that we do not have need to say anything.","sp":{"w":[[0,3,"G10630"],[4,8,"G05750"],[9,12,"G47710"],[13,16,"G35880"],[17,21,"G30560"],[22,24,"G29620"],[25,28,"G29620"],[29,33,"G29620"],[34,37,"G18370"],[38,42,"G18370"],[43,50,"G18370"],[51,54,"G18370"],[55,58,"G37560"],[59,63,"G34400"],[64,66,"G17220"],[67,76,"G31090"],[77,80,"G25320"],[81,83,"G17220"],[84,90,"G08820"],[92,95,"G02350"],[96,100,"G47710"],[101,106,"G41020"],[107,113,"G43140"],[114,117,"G23160"],[118,121,"G18310"],[122,126,"G18310"],[127,130,"G18310"],[131,135,"G17220"],[136,141,"G39560"],[142,147,"G51170"],[149,151,"G56200"],[152,156,"G56200"],[157,159,"G14730"],[160,162,"G21920"],[163,166,"G33610"],[167,171,"G21920"],[172,176,"G55320"],[177,179,"G29800"],[180,183,"G29800"],[184,192,"G51000"]]}},{"n":9,"text":"For they themselves report concerning us what kind of entrance we had to you and how you turned to God from the idols to serve the living and true God","sp":{"w":[[0,3,"G10630"],[4,8,"G05180"],[9,19,"G08460"],[20,26,"G05180"],[27,37,"G40120"],[38,40,"G14730"],[41,45,"G36970"],[46,50,"G36970"],[51,53,"G36970"],[54,62,"G15290"],[63,65,"G21920"],[66,69,"G21920"],[70,72,"G43140"],[73,76,"G47710"],[77,80,"G25320"],[81,84,"G44590"],[85,88,"G19940"],[89,95,"G19940"],[96,98,"G43140"],[99,102,"G23160"],[103,107,"G05750"],[108,111,"G35880"],[112,117,"G14970"],[118,120,"G13980"],[121,126,"G13980"],[127,130,"G23160"],[131,137,"G21980"],[138,141,"G25320"],[142,146,"G02280"],[147,150,"G23160"]]}},{"n":10,"text":"and to wait for his Son from the heavens, whom he raised from the dead—Jesus, the one rescuing us from the coming wrath.","sp":{"w":[[0,3,"G25320"],[4,6,"G03620"],[7,11,"G03620"],[12,15,"G03620"],[16,19,"G08460"],[20,23,"G52070"],[24,28,"G15370"],[29,32,"G35880"],[33,40,"G37720"],[42,46,"G37390"],[47,49,"G14530"],[50,56,"G14530"],[57,61,"G15370"],[62,65,"G35880"],[66,70,"G34980"],[71,76,"G24240"],[78,81,"G35880"],[82,85,"G35880"],[86,94,"G45060"],[95,97,"G14730"],[98,102,"G15370"],[103,106,"G35880"],[107,113,"G20640"],[114,119,"G37090"]]}}]},{"n":2,"verses":[{"n":1,"text":"For you yourselves know, brothers, that our entrance to you has not been in vain.","br":1,"sp":{"w":[[0,3,"G10630"],[4,7,"G14920"],[8,18,"G08460"],[19,23,"G14920"],[25,33,"G00800"],[35,39,"G37540"],[40,43,"G14730"],[44,52,"G15290"],[53,55,"G43140"],[56,59,"G47710"],[60,63,"G10960"],[64,67,"G37560"],[68,72,"G10960"],[73,75,"G27560"],[76,80,"G27560"]]}},{"n":2,"text":"But having previously suffered and having been mistreated at Philippi, just as you know, we were bold in our God to speak to you the gospel of God in much struggle.","sp":{"w":[[0,3,"G02350"],[4,10,"G43100"],[11,21,"G43100"],[22,30,"G43100"],[31,34,"G25320"],[35,41,"G51950"],[42,46,"G51950"],[47,57,"G51950"],[58,60,"G17220"],[61,69,"G53750"],[71,75,"G25310"],[76,78,"G25310"],[79,82,"G14920"],[83,87,"G14920"],[89,91,"G39550"],[92,96,"G39550"],[97,101,"G39550"],[102,104,"G17220"],[105,108,"G14730"],[109,112,"G23160"],[113,115,"G29800"],[116,121,"G29800"],[122,124,"G43140"],[125,128,"G47710"],[129,132,"G35880"],[133,139,"G20980"],[140,142,"G23160"],[143,146,"G23160"],[147,149,"G17220"],[150,154,"G41830"],[155,163,"G00730"]]}},{"n":3,"text":"For our exhortation {was} neither from error, nor from impurity, nor in deceit,","sp":{"w":[[0,3,"G10630"],[4,7,"G14730"],[8,19,"G38740"],[21,24,"G15370"],[26,33,"G37560"],[34,38,"G15370"],[39,44,"G41060"],[46,49,"G37610"],[50,54,"G15370"],[55,63,"G01670"],[65,68,"G37610"],[69,71,"G17220"],[72,78,"G13880"]]}},{"n":4,"text":"but just as we have been examined by God to be entrusted with the gospel, so we speak, not as pleasing to men, but to God, the one examining our hearts.","sp":{"w":[[0,3,"G02350"],[4,8,"G25310"],[9,11,"G25310"],[12,14,"G13810"],[15,19,"G13810"],[20,24,"G13810"],[25,33,"G13810"],[34,36,"G52590"],[37,40,"G23160"],[41,43,"G41000"],[44,46,"G41000"],[47,56,"G41000"],[57,61,"G41000"],[62,65,"G35880"],[66,72,"G20980"],[74,76,"G37790"],[77,79,"G29800"],[80,85,"G29800"],[87,90,"G37560"],[91,93,"G56130"],[94,102,"G07000"],[103,105,"G04440"],[106,109,"G04440"],[111,114,"G02350"],[115,117,"G23160"],[118,121,"G23160"],[123,126,"G35880"],[127,130,"G35880"],[131,140,"G13810"],[141,144,"G14730"],[145,151,"G25880"]]}},{"n":5,"text":"For we were not at that time in a word of flattery, just as you know, nor in a pretext of greed—God {is} witness—","sp":{"w":[[0,3,"G10630"],[4,6,"G10960"],[7,11,"G10960"],[12,15,"G37770"],[16,18,"G42180"],[19,23,"G42180"],[24,28,"G42180"],[29,31,"G17220"],[32,33,"G30560"],[34,38,"G30560"],[39,41,"G28500"],[42,50,"G28500"],[52,56,"G25310"],[57,59,"G25310"],[60,63,"G14920"],[64,68,"G14920"],[70,73,"G37770"],[74,76,"G17220"],[77,78,"G43920"],[79,86,"G43920"],[87,89,"G41240"],[90,95,"G41240"],[96,99,"G23160"],[101,103,"G31440"],[105,112,"G31440"]]}},{"n":6,"text":"nor seeking glory from men, neither from you nor from others,","sp":{"w":[[0,3,"G37770"],[4,11,"G22120"],[12,17,"G13910"],[18,22,"G15370"],[23,26,"G04440"],[28,35,"G37770"],[36,40,"G05750"],[41,44,"G47710"],[45,48,"G37770"],[49,53,"G05750"],[54,60,"G02430"]]}},{"n":7,"text":"being able to be a burden as apostles of Christ; but we became little children in the midst of you, as if a mother might comfort her own children.","sp":{"w":[[0,5,"G14100"],[6,10,"G14100"],[11,13,"G15100"],[14,16,"G15100"],[17,18,"G09220"],[19,25,"G09220"],[26,28,"G56130"],[29,37,"G06520"],[38,40,"G55470"],[41,47,"G55470"],[49,52,"G02350"],[53,55,"G10960"],[56,62,"G10960"],[63,69,"G35160"],[70,78,"G35160"],[79,81,"G17220"],[82,85,"G33190"],[86,91,"G33190"],[92,94,"G33190"],[95,98,"G47710"],[100,102,"G56130"],[103,105,"G14370"],[106,107,"G51620"],[108,114,"G51620"],[115,120,"G22820"],[121,128,"G22820"],[129,132,"G35880"],[133,136,"G14380"],[137,145,"G50430"]]}},{"n":8,"text":"Longing for you in this manner, we were pleased to share with you not only the gospel of God, but also our own souls. For you became beloved to us.","sp":{"w":[[0,7,"G24420"],[8,11,"G24420"],[12,15,"G47710"],[16,18,"G37790"],[19,23,"G37790"],[24,30,"G37790"],[32,34,"G21060"],[35,39,"G21060"],[40,47,"G21060"],[48,50,"G33300"],[51,56,"G33300"],[57,61,"G47710"],[62,65,"G47710"],[66,69,"G37560"],[70,74,"G34400"],[75,78,"G35880"],[79,85,"G20980"],[86,88,"G23160"],[89,92,"G23160"],[94,97,"G02350"],[98,102,"G25320"],[103,106,"G35880"],[107,110,"G14380"],[111,116,"G55900"],[118,121,"G13600"],[122,125,"G10960"],[126,132,"G10960"],[133,140,"G00270"],[141,143,"G14730"],[144,146,"G14730"]]}},{"n":9,"text":"For you remember, brothers, our labor and toil, night and day working in order not to burden any of you, we preached to you the gospel of God.","sp":{"w":[[0,3,"G10630"],[4,7,"G34210"],[8,16,"G34210"],[18,26,"G00800"],[28,31,"G14730"],[32,37,"G28730"],[38,41,"G25320"],[42,46,"G34490"],[48,53,"G35710"],[54,57,"G25320"],[58,61,"G22500"],[62,69,"G20380"],[70,72,"G35880"],[73,78,"G35880"],[79,82,"G33610"],[83,85,"G19120"],[86,92,"G19120"],[93,96,"G51000"],[97,99,"G47710"],[100,103,"G47710"],[105,107,"G27840"],[108,116,"G27840"],[117,119,"G15190"],[120,123,"G47710"],[124,127,"G35880"],[128,134,"G20980"],[135,137,"G23160"],[138,141,"G23160"]]}},{"n":10,"text":"You and God {are} witnesses, how piously and righteously and blamelessly we were to you, the ones believing,","sp":{"w":[[0,3,"G47710"],[4,7,"G25320"],[8,11,"G23160"],[13,16,"G31440"],[18,27,"G31440"],[29,32,"G56130"],[33,40,"G37430"],[41,44,"G25320"],[45,56,"G13460"],[57,60,"G25320"],[61,72,"G02740"],[73,75,"G10960"],[76,80,"G10960"],[81,83,"G47710"],[84,87,"G47710"],[89,92,"G35880"],[93,97,"G35880"],[98,107,"G41000"]]}},{"n":11,"text":"just as you know how, {with} each one of you, as a father his own children,","sp":{"w":[[0,4,"G25090"],[5,7,"G25090"],[8,11,"G14920"],[12,16,"G14920"],[17,20,"G56130"],[23,27,"G15380"],[29,33,"G15380"],[34,37,"G15200"],[38,40,"G47710"],[41,44,"G47710"],[46,48,"G56130"],[49,50,"G39620"],[51,57,"G39620"],[58,61,"G14380"],[62,65,"G14380"],[66,74,"G50430"]]}},{"n":12,"text":"exhorting you and encouraging and testifying in order that you might walk worthily of God, the one calling you into his own kingdom and glory.","sp":{"w":[[0,9,"G38700"],[10,13,"G47710"],[14,17,"G25320"],[18,29,"G38880"],[30,33,"G25320"],[34,44,"G31430"],[45,47,"G15190"],[48,53,"G15190"],[54,58,"G15190"],[59,62,"G47710"],[63,68,"G40430"],[69,73,"G40430"],[74,82,"G05160"],[83,85,"G23160"],[86,89,"G23160"],[91,94,"G35880"],[95,98,"G35880"],[99,106,"G25640"],[107,110,"G47710"],[111,115,"G15190"],[116,119,"G35880"],[120,123,"G14380"],[124,131,"G09320"],[132,135,"G25320"],[136,141,"G13910"]]}},{"n":13,"text":"And because of this, we also thank God continually, that having received the word of hearing of God from us, you received it not {as} the word of men, but just as it truly is, the word of God, which is also working in you, the ones believing.","br":1,"sp":{"w":[[0,3,"G25320"],[4,11,"G12230"],[12,14,"G12230"],[15,19,"G37780"],[21,23,"G14730"],[24,28,"G25320"],[29,34,"G21680"],[35,38,"G23160"],[39,50,"G00890"],[52,56,"G37540"],[57,63,"G38800"],[64,72,"G38800"],[73,76,"G30560"],[77,81,"G30560"],[82,84,"G01890"],[85,92,"G01890"],[93,95,"G23160"],[96,99,"G23160"],[100,104,"G38440"],[105,107,"G14730"],[109,112,"G12090"],[113,121,"G12090"],[122,124,"G12090"],[125,128,"G37560"],[130,132,"G30560"],[134,137,"G30560"],[138,142,"G30560"],[143,145,"G04440"],[146,149,"G04440"],[151,154,"G02350"],[155,159,"G25310"],[160,162,"G25310"],[163,165,"G15100"],[166,171,"G02300"],[172,174,"G15100"],[176,179,"G30560"],[180,184,"G30560"],[185,187,"G23160"],[188,191,"G23160"],[193,198,"G37390"],[199,201,"G17540"],[202,206,"G25320"],[207,214,"G17540"],[215,217,"G17220"],[218,221,"G47710"],[223,226,"G35880"],[227,231,"G35880"],[232,241,"G41000"]]}},{"n":14,"text":"For you, brothers, became imitators of the churches of God that are in Judea in Christ Jesus, because the same things you also suffered from your own countrymen, just as they also from the Jews,","sp":{"w":[[0,3,"G10630"],[4,7,"G47710"],[9,17,"G00800"],[19,25,"G10960"],[26,35,"G34020"],[36,38,"G15770"],[39,42,"G15770"],[43,51,"G15770"],[52,54,"G23160"],[55,58,"G23160"],[59,63,"G35880"],[64,67,"G15100"],[68,70,"G17220"],[71,76,"G24490"],[77,79,"G17220"],[80,86,"G55470"],[87,92,"G24240"],[94,101,"G37540"],[102,105,"G35880"],[106,110,"G08460"],[111,117,"G35880"],[118,121,"G47710"],[122,126,"G25320"],[127,135,"G39580"],[136,140,"G52590"],[141,145,"G35880"],[146,149,"G23980"],[150,160,"G48530"],[162,166,"G25310"],[167,169,"G25310"],[170,174,"G08460"],[175,179,"G25320"],[180,184,"G52590"],[185,188,"G35880"],[189,193,"G24530"]]}},{"n":15,"text":"the ones having killed both the Lord Jesus and the prophets and having persecuted us and not being pleasing to God and {being} hostile to all men,","sp":{"w":[[0,3,"G35880"],[4,8,"G35880"],[9,15,"G06150"],[16,22,"G06150"],[23,27,"G25320"],[28,31,"G35880"],[32,36,"G29620"],[37,42,"G24240"],[43,46,"G25320"],[47,50,"G35880"],[51,59,"G43960"],[60,63,"G25320"],[64,70,"G15590"],[71,81,"G15590"],[82,84,"G14730"],[85,88,"G25320"],[89,92,"G33610"],[93,98,"G07000"],[99,107,"G07000"],[108,110,"G23160"],[111,114,"G23160"],[115,118,"G25320"],[120,125,"G17270"],[127,134,"G17270"],[135,137,"G04440"],[138,141,"G39560"],[142,145,"G04440"]]}},{"n":16,"text":"forbidding us to speak to the Gentiles so that they might be saved, so that {they} always fill up their sins. But the wrath has come upon them to the end.","sp":{"w":[[0,10,"G29670"],[11,13,"G14730"],[14,16,"G29800"],[17,22,"G29800"],[23,25,"G14840"],[26,29,"G14840"],[30,38,"G14840"],[39,41,"G24430"],[42,46,"G24430"],[47,51,"G49820"],[52,57,"G49820"],[58,60,"G49820"],[61,66,"G49820"],[68,70,"G15190"],[71,75,"G15190"],[77,81,"G03780"],[83,89,"G38420"],[90,94,"G03780"],[95,97,"G03780"],[98,103,"G08460"],[104,108,"G02660"],[110,113,"G11610"],[114,117,"G35880"],[118,123,"G37090"],[124,127,"G53480"],[128,132,"G53480"],[133,137,"G19090"],[138,142,"G08460"],[143,145,"G15190"],[146,149,"G50560"],[150,153,"G50560"]]}},{"n":17,"text":"But we, brothers, having been separated from you for the time of an hour, by face, not by heart, became extremely eager to see your face, in much desire.","br":1,"sp":{"w":[[0,3,"G11610"],[4,6,"G14730"],[8,16,"G00800"],[18,24,"G06420"],[25,29,"G06420"],[30,39,"G06420"],[40,44,"G05750"],[45,48,"G47710"],[49,52,"G43140"],[53,56,"G25400"],[57,61,"G25400"],[62,64,"G56100"],[65,67,"G56100"],[68,72,"G56100"],[74,76,"G43830"],[77,81,"G43830"],[83,86,"G37560"],[87,89,"G25880"],[90,95,"G25880"],[97,103,"G47040"],[104,113,"G40560"],[114,119,"G47040"],[120,122,"G37080"],[123,126,"G37080"],[127,131,"G47710"],[132,136,"G43830"],[138,140,"G17220"],[141,145,"G41830"],[146,152,"G19390"]]}},{"n":18,"text":"For we desired to come to you—indeed I, Paul, both once and twice—but Satan hindered us.","sp":{"w":[[0,3,"G13600"],[4,6,"G23090"],[7,14,"G23090"],[15,17,"G20640"],[18,22,"G20640"],[23,25,"G43140"],[26,29,"G47710"],[30,36,"G33030"],[37,38,"G14730"],[40,44,"G39720"],[46,50,"G25320"],[51,55,"G05300"],[56,59,"G25320"],[60,65,"G13640"],[66,69,"G25320"],[70,75,"G45660"],[76,84,"G14650"],[85,87,"G14730"]]}},{"n":19,"text":"For what {is} our hope or joy or crown of boasting? Or {is it} not also you before our Lord Jesus at his coming?","sp":{"w":[[0,3,"G10630"],[4,8,"G51010"],[10,12,"G51010"],[14,17,"G14730"],[18,22,"G16800"],[23,25,"G22280"],[26,29,"G54790"],[30,32,"G22280"],[33,38,"G47350"],[39,41,"G27460"],[42,50,"G27460"],[52,54,"G22280"],[56,58,"G37800"],[59,61,"G37800"],[63,66,"G37800"],[67,71,"G25320"],[72,75,"G47710"],[76,82,"G17150"],[83,86,"G14730"],[87,91,"G29620"],[92,97,"G24240"],[98,100,"G17220"],[101,104,"G08460"],[105,111,"G39520"]]}},{"n":20,"text":"For you are our glory and joy.","sp":{"w":[[0,3,"G10630"],[4,7,"G47710"],[8,11,"G15100"],[12,15,"G14730"],[16,21,"G13910"],[22,25,"G25320"],[26,29,"G54790"]]}}]},{"n":3,"verses":[{"n":1,"text":"Therefore, enduring {it} no longer, we thought it good to be left behind in Athens alone,","br":1,"sp":{"w":[[0,9,"G13520"],[11,19,"G47220"],[21,23,"G47220"],[25,27,"G33710"],[28,34,"G33710"],[36,38,"G21060"],[39,46,"G21060"],[47,49,"G21060"],[50,54,"G21060"],[55,57,"G26410"],[58,60,"G26410"],[61,65,"G26410"],[66,72,"G26410"],[73,75,"G17220"],[76,82,"G01160"],[83,88,"G34410"]]}},{"n":2,"text":"and we sent Timothy, our brother and a servant of God in the gospel of Christ, to strengthen and encourage you regarding your faith,","sp":{"w":[[0,3,"G25320"],[4,6,"G39920"],[7,11,"G39920"],[12,19,"G50950"],[21,24,"G14730"],[25,32,"G00800"],[33,36,"G25320"],[37,38,"G12490"],[39,46,"G12490"],[47,49,"G23160"],[50,53,"G23160"],[54,56,"G17220"],[57,60,"G35880"],[61,67,"G20980"],[68,70,"G55470"],[71,77,"G55470"],[79,81,"G15190"],[82,92,"G47410"],[93,96,"G25320"],[97,106,"G38700"],[107,110,"G47710"],[111,120,"G52280"],[121,125,"G47710"],[126,131,"G41020"]]}},{"n":3,"text":"that no one be disturbed by these afflictions. For you yourselves know that for this we are appointed.","sp":{"w":[[0,4,"G35880"],[5,7,"G33670"],[8,11,"G33670"],[12,14,"G45250"],[15,24,"G45250"],[25,27,"G17220"],[28,33,"G37780"],[34,45,"G23470"],[47,50,"G10630"],[51,54,"G14920"],[55,65,"G08460"],[66,70,"G14920"],[71,75,"G37540"],[76,79,"G15190"],[80,84,"G37780"],[85,87,"G27490"],[88,91,"G27490"],[92,101,"G27490"]]}},{"n":4,"text":"For also when we were with you, we were telling you in advance that we are about to be afflicted, just as also it happened and you know.","sp":{"w":[[0,3,"G10630"],[4,8,"G25320"],[9,13,"G37530"],[14,16,"G15100"],[17,21,"G15100"],[22,26,"G43140"],[27,30,"G47710"],[32,34,"G43020"],[35,39,"G43020"],[40,47,"G43020"],[48,51,"G47710"],[52,54,"G43020"],[55,62,"G43020"],[63,67,"G37540"],[68,70,"G31950"],[71,74,"G31950"],[75,80,"G31950"],[81,83,"G23460"],[84,86,"G23460"],[87,96,"G23460"],[98,102,"G25310"],[103,105,"G25310"],[106,110,"G25320"],[111,113,"G10960"],[114,122,"G10960"],[123,126,"G25320"],[127,130,"G14920"],[131,135,"G14920"]]}},{"n":5,"text":"Because of this, I also, no longer enduring {it}, sent to know about your faith, lest somehow the tempter had tempted you, and our labor might have been in vain.","sp":{"w":[[0,7,"G12230"],[8,10,"G12230"],[11,15,"G37780"],[17,18,"G25040"],[19,23,"G25040"],[25,27,"G33710"],[28,34,"G33710"],[35,43,"G47220"],[45,47,"G47220"],[50,54,"G39920"],[55,57,"G10970"],[58,62,"G10970"],[63,68,"G10970"],[69,73,"G47710"],[74,79,"G41020"],[81,85,"G33610"],[86,93,"G44580"],[94,97,"G35880"],[98,105,"G39850"],[106,109,"G39850"],[110,117,"G39850"],[118,121,"G47710"],[123,126,"G25320"],[127,130,"G14730"],[131,136,"G28730"],[137,142,"G10960"],[143,147,"G10960"],[148,152,"G10960"],[153,155,"G15190"],[156,160,"G27560"]]}},{"n":6,"text":"But just now Timothy has come to us from you and has told us the good news about your faith and love and that you always have good memory of us, longing to see us just as we also, you.","sp":{"w":[[0,3,"G11610"],[4,8,"G07370"],[9,12,"G07370"],[13,20,"G50950"],[21,24,"G20640"],[25,29,"G20640"],[30,32,"G43140"],[33,35,"G14730"],[36,40,"G05750"],[41,44,"G47710"],[45,48,"G25320"],[49,52,"G20970"],[53,57,"G20970"],[58,60,"G14730"],[61,64,"G20970"],[65,69,"G20970"],[70,74,"G20970"],[75,80,"G20970"],[81,85,"G47710"],[86,91,"G41020"],[92,95,"G25320"],[96,100,"G00260"],[101,104,"G25320"],[105,109,"G37540"],[110,113,"G21920"],[114,120,"G38420"],[121,125,"G21920"],[126,130,"G00180"],[131,137,"G34170"],[138,140,"G14730"],[141,143,"G14730"],[145,152,"G19710"],[153,155,"G37080"],[156,159,"G37080"],[160,162,"G14730"],[163,167,"G25090"],[168,170,"G25090"],[171,173,"G14730"],[174,178,"G25320"],[180,183,"G47710"]]}},{"n":7,"text":"Because of this, brothers, we were encouraged about you in all our distress and affliction, through your faith.","sp":{"w":[[0,7,"G12230"],[8,10,"G12230"],[11,15,"G37780"],[17,25,"G00800"],[27,29,"G38700"],[30,34,"G38700"],[35,45,"G38700"],[46,51,"G19090"],[52,55,"G47710"],[56,58,"G19090"],[59,62,"G39560"],[63,66,"G14730"],[67,75,"G03180"],[76,79,"G25320"],[80,90,"G23470"],[92,99,"G12230"],[100,104,"G47710"],[105,110,"G41020"]]}},{"n":8,"text":"For now we live, if you yourselves stand firm in the Lord.","sp":{"w":[[0,3,"G37540"],[4,7,"G35680"],[8,10,"G21980"],[11,15,"G21980"],[17,19,"G14370"],[20,23,"G47390"],[24,34,"G47710"],[35,40,"G47390"],[41,45,"G47390"],[46,48,"G17220"],[49,52,"G29620"],[53,57,"G29620"]]}},{"n":9,"text":"For what thanks are we able to give back to God concerning you for all the joy with which we rejoice because of you before our God,","sp":{"w":[[0,3,"G10630"],[4,8,"G51010"],[9,15,"G21690"],[16,19,"G14100"],[20,22,"G14100"],[23,27,"G14100"],[28,30,"G04670"],[31,35,"G04670"],[36,40,"G04670"],[41,43,"G23160"],[44,47,"G23160"],[48,58,"G40120"],[59,62,"G47710"],[63,66,"G19090"],[67,70,"G39560"],[71,74,"G35880"],[75,78,"G54790"],[79,83,"G37390"],[84,89,"G37390"],[90,92,"G54630"],[93,100,"G54630"],[101,108,"G12230"],[109,111,"G12230"],[112,115,"G47710"],[116,122,"G17150"],[123,126,"G14730"],[127,130,"G23160"]]}},{"n":10,"text":"night and day pleading earnestly to see your face and to provide what {is} lacking in your faith?","sp":{"w":[[0,5,"G35710"],[6,9,"G25320"],[10,13,"G22500"],[14,22,"G12100"],[23,32,"G52380"],[33,35,"G37080"],[36,39,"G37080"],[40,44,"G47710"],[45,49,"G43830"],[50,53,"G25320"],[54,56,"G26750"],[57,64,"G26750"],[65,69,"G35880"],[71,73,"G35880"],[75,82,"G53030"],[83,85,"G41020"],[86,90,"G47710"],[91,96,"G41020"]]}},{"n":11,"text":"But may our God and Father himself and our Lord Jesus direct our way to you.","br":1,"sp":{"w":[[0,3,"G11610"],[4,7,"G27200"],[8,11,"G14730"],[12,15,"G23160"],[16,19,"G25320"],[20,26,"G39620"],[27,34,"G08460"],[35,38,"G25320"],[39,42,"G14730"],[43,47,"G29620"],[48,53,"G24240"],[54,60,"G27200"],[61,64,"G14730"],[65,68,"G35980"],[69,71,"G43140"],[72,75,"G47710"]]}},{"n":12,"text":"Now may the Lord make you increase and abound in love for one another and for all, just as we also toward you,","sp":{"w":[[0,3,"G11610"],[4,7,"G41210"],[8,11,"G35880"],[12,16,"G29620"],[17,21,"G41210"],[22,25,"G47710"],[26,34,"G41210"],[35,38,"G25320"],[39,45,"G40520"],[46,48,"G00260"],[49,53,"G00260"],[54,57,"G15190"],[58,61,"G02400"],[62,69,"G02400"],[70,73,"G25320"],[74,77,"G15190"],[78,81,"G39560"],[83,87,"G25090"],[88,90,"G25090"],[91,93,"G14730"],[94,98,"G25320"],[99,105,"G15190"],[106,109,"G47710"]]}},{"n":13,"text":"to strengthen your hearts, blameless in holiness before our God and Father, at the coming of our Lord Jesus with all his saints. Amen!","sp":{"w":[[0,2,"G47410"],[3,13,"G47410"],[14,18,"G47710"],[19,25,"G25880"],[27,36,"G02730"],[37,39,"G17220"],[40,48,"G00420"],[49,55,"G17150"],[56,59,"G14730"],[60,63,"G23160"],[64,67,"G25320"],[68,74,"G39620"],[76,78,"G17220"],[79,82,"G35880"],[83,89,"G39520"],[90,92,"G29620"],[93,96,"G14730"],[97,101,"G29620"],[102,107,"G24240"],[108,112,"G33260"],[113,116,"G39560"],[117,120,"G08460"],[121,127,"G00400"],[129,133,"G02810"]]}}]},{"n":4,"verses":[{"n":1,"text":"Therefore, finally, brothers, we ask and encourage you in the Lord Jesus, just as you received from us how it is necessary for you to walk and to please God (just as also you are walking), that you might abound even more.","br":1,"sp":{"w":[[0,9,"G37670"],[11,18,"G30617"],[20,28,"G00800"],[30,32,"G20650"],[33,36,"G20650"],[37,40,"G25320"],[41,50,"G38700"],[51,54,"G47710"],[55,57,"G17220"],[58,61,"G29620"],[62,66,"G29620"],[67,72,"G24240"],[74,78,"G25310"],[79,81,"G25310"],[82,85,"G38800"],[86,94,"G38800"],[95,99,"G38440"],[100,102,"G14730"],[103,106,"G44590"],[107,109,"G12100"],[110,112,"G12100"],[113,122,"G12100"],[123,126,"G12100"],[127,130,"G47710"],[131,133,"G40430"],[134,138,"G40430"],[139,142,"G25320"],[143,145,"G07000"],[146,152,"G07000"],[153,156,"G23160"],[158,162,"G25310"],[163,165,"G25310"],[166,170,"G25320"],[171,174,"G40430"],[175,178,"G40430"],[179,186,"G40430"],[189,193,"G24430"],[194,197,"G40520"],[198,203,"G40520"],[204,210,"G40520"],[211,215,"G31230"],[216,220,"G31230"]]}},{"n":2,"text":"For you know what commands we gave you through the Lord Jesus.","sp":{"w":[[0,3,"G10630"],[4,7,"G14920"],[8,12,"G14920"],[13,17,"G51010"],[18,26,"G38520"],[27,29,"G13250"],[30,34,"G13250"],[35,38,"G47710"],[39,46,"G12230"],[47,50,"G35880"],[51,55,"G29620"],[56,61,"G24240"]]}},{"n":3,"text":"For this is the will of God, your sanctification: that you keep yourselves from sexual immorality;","sp":{"w":[[0,3,"G10630"],[4,8,"G37780"],[9,11,"G15100"],[12,15,"G23070"],[16,20,"G23070"],[21,23,"G23160"],[24,27,"G23160"],[29,33,"G47710"],[34,48,"G00380"],[50,54,"G05680"],[55,58,"G47710"],[59,63,"G05680"],[64,74,"G05680"],[75,79,"G05750"],[80,86,"G42020"],[87,97,"G42020"]]}},{"n":4,"text":"that each of you knows to possess his own vessel in sanctification and honor,","sp":{"w":[[0,4,"G14920"],[5,9,"G15380"],[10,12,"G47710"],[13,16,"G47710"],[17,22,"G14920"],[23,25,"G29320"],[26,33,"G29320"],[34,37,"G35880"],[38,41,"G14380"],[42,48,"G46320"],[49,51,"G17220"],[52,66,"G00380"],[67,70,"G25320"],[71,76,"G50920"]]}},{"n":5,"text":"not in the passion of lust (just as also the Gentiles, the ones not knowing God);","sp":{"w":[[0,3,"G33610"],[4,6,"G17220"],[7,10,"G38060"],[11,18,"G38060"],[19,21,"G19390"],[22,26,"G19390"],[28,32,"G25090"],[33,35,"G25090"],[36,40,"G25320"],[41,44,"G35880"],[45,53,"G14840"],[55,58,"G35880"],[59,63,"G35880"],[64,67,"G33610"],[68,75,"G14920"],[76,79,"G23160"]]}},{"n":6,"text":"not to transgress and take advantage of his brother in this matter, for the Lord {is} an avenger concerning all these things, just as we also said before to you and testified.","sp":{"w":[[0,3,"G33610"],[4,6,"G35880"],[7,17,"G52330"],[18,21,"G25320"],[22,26,"G41220"],[27,36,"G41220"],[37,39,"G41220"],[40,43,"G08460"],[44,51,"G00800"],[52,54,"G17220"],[55,59,"G35880"],[60,66,"G42290"],[68,71,"G13600"],[72,75,"G29620"],[76,80,"G29620"],[82,84,"G15580"],[86,88,"G15580"],[89,96,"G15580"],[97,107,"G40120"],[108,111,"G39560"],[112,117,"G37780"],[118,124,"G37780"],[126,130,"G25310"],[131,133,"G25310"],[134,136,"G43020"],[137,141,"G25320"],[142,146,"G43020"],[147,153,"G43020"],[154,156,"G47710"],[157,160,"G47710"],[161,164,"G25320"],[165,174,"G12630"]]}},{"n":7,"text":"For God did not call us for uncleanness, but in sanctification.","sp":{"w":[[0,3,"G10630"],[4,7,"G23160"],[8,11,"G25640"],[12,15,"G37560"],[16,20,"G25640"],[21,23,"G14730"],[24,27,"G19090"],[28,39,"G01670"],[41,44,"G02350"],[45,47,"G17220"],[48,62,"G00380"]]}},{"n":8,"text":"Therefore, the one rejecting, rejects not man, but God, the one giving his Holy Spirit to you.","sp":{"w":[[0,9,"G51050"],[11,14,"G35880"],[15,18,"G35880"],[19,28,"G01140"],[30,37,"G01140"],[38,41,"G37560"],[42,45,"G04440"],[47,50,"G02350"],[51,54,"G23160"],[56,59,"G35880"],[60,63,"G35880"],[64,70,"G13250"],[71,74,"G08460"],[75,79,"G00400"],[80,86,"G41510"],[87,89,"G15190"],[90,93,"G47710"]]}},{"n":9,"text":"But concerning brotherly love, you have no need {for us} to write to you, for you yourselves are taught by God to love one another.","br":1,"sp":{"w":[[0,3,"G11610"],[4,14,"G40120"],[15,24,"G53600"],[25,29,"G53600"],[31,34,"G21920"],[35,39,"G21920"],[40,42,"G37560"],[43,47,"G55320"],[49,52,"G55320"],[53,55,"G55320"],[57,59,"G11250"],[60,65,"G11250"],[66,68,"G47710"],[69,72,"G47710"],[74,77,"G10630"],[78,81,"G47710"],[82,92,"G08460"],[93,96,"G15100"],[97,103,"G23120"],[104,106,"G23120"],[107,110,"G23120"],[111,113,"G00250"],[114,118,"G00250"],[119,122,"G02400"],[123,130,"G02400"]]}},{"n":10,"text":"For also you do it to all the brothers who {are} in all Macedonia. But we encourage you, brothers, to abound even more","sp":{"w":[[0,3,"G10630"],[4,8,"G25320"],[9,12,"G41600"],[13,15,"G41600"],[16,18,"G08460"],[19,21,"G15190"],[22,25,"G39560"],[26,29,"G35880"],[30,38,"G00800"],[39,42,"G35880"],[44,47,"G35880"],[49,51,"G17220"],[52,55,"G36500"],[56,65,"G31090"],[67,70,"G11610"],[71,73,"G38700"],[74,83,"G38700"],[84,87,"G47710"],[89,97,"G00800"],[99,101,"G40520"],[102,108,"G40520"],[109,113,"G31230"],[114,118,"G31230"]]}},{"n":11,"text":"and to strive to be quiet and to perform your own things and to work with your own hands, just as we commanded you,","sp":{"w":[[0,3,"G25320"],[4,6,"G53890"],[7,13,"G53890"],[14,16,"G22700"],[17,19,"G22700"],[20,25,"G22700"],[26,29,"G25320"],[30,32,"G42380"],[33,40,"G42380"],[41,45,"G23980"],[46,49,"G23980"],[50,56,"G35880"],[57,60,"G25320"],[61,63,"G20380"],[64,68,"G20380"],[69,73,"G54950"],[74,78,"G47710"],[79,82,"G23980"],[83,88,"G54950"],[90,94,"G25310"],[95,97,"G25310"],[98,100,"G38530"],[101,110,"G38530"],[111,114,"G47710"]]}},{"n":12,"text":"so that you may walk properly before the ones outside and have need of nothing.","sp":{"w":[[0,2,"G24430"],[3,7,"G24430"],[8,11,"G40430"],[12,15,"G40430"],[16,20,"G40430"],[21,29,"G21560"],[30,36,"G43140"],[37,40,"G35880"],[41,45,"G35880"],[46,53,"G18540"],[54,57,"G25320"],[58,62,"G21920"],[63,67,"G55320"],[68,70,"G33670"],[71,78,"G33670"]]}},{"n":13,"text":"Now we do not want you to be ignorant, brothers, concerning the ones sleeping, so that you may not grieve just as also the rest, the ones not having hope.","br":1,"sp":{"w":[[0,3,"G11610"],[4,6,"G23090"],[7,9,"G23090"],[10,13,"G37560"],[14,18,"G23090"],[19,22,"G47710"],[23,25,"G00500"],[26,28,"G00500"],[29,37,"G00500"],[39,47,"G00800"],[49,59,"G40120"],[60,63,"G35880"],[64,68,"G35880"],[69,77,"G28370"],[79,81,"G24430"],[82,86,"G24430"],[87,90,"G30760"],[91,94,"G30760"],[95,98,"G33610"],[99,105,"G30760"],[106,110,"G25310"],[111,113,"G25310"],[114,118,"G25320"],[119,122,"G35880"],[123,127,"G30620"],[129,132,"G35880"],[133,137,"G35880"],[138,141,"G33610"],[142,148,"G21920"],[149,153,"G16800"]]}},{"n":14,"text":"For if we believe that Jesus died and rose, thus also God will bring the ones having slept through Jesus with him.","sp":{"w":[[0,3,"G10630"],[4,6,"G14870"],[7,9,"G41000"],[10,17,"G41000"],[18,22,"G37540"],[23,28,"G24240"],[29,33,"G05990"],[34,37,"G25320"],[38,42,"G04500"],[44,48,"G37790"],[49,53,"G25320"],[54,57,"G23160"],[58,62,"G00710"],[63,68,"G00710"],[69,72,"G35880"],[73,77,"G35880"],[78,84,"G28370"],[85,90,"G28370"],[91,98,"G12230"],[99,104,"G24240"],[105,109,"G48620"],[110,113,"G08460"]]}},{"n":15,"text":"For this we say to you in a word of the Lord, that we, the ones living, the ones surviving to the coming of the Lord, will certainly not go before the ones having slept.","sp":{"w":[[0,3,"G10630"],[4,8,"G37780"],[9,11,"G30040"],[12,15,"G30040"],[16,18,"G47710"],[19,22,"G47710"],[23,25,"G17220"],[26,27,"G30560"],[28,32,"G30560"],[33,35,"G29620"],[36,39,"G29620"],[40,44,"G29620"],[46,50,"G37540"],[51,53,"G14730"],[55,58,"G35880"],[59,63,"G35880"],[64,70,"G21980"],[72,75,"G35880"],[76,80,"G35880"],[81,90,"G40350"],[91,93,"G15190"],[94,97,"G35880"],[98,104,"G39520"],[105,107,"G29620"],[108,111,"G29620"],[112,116,"G29620"],[118,122,"G53480"],[123,132,"G33610"],[133,136,"G33610"],[137,139,"G53480"],[140,146,"G53480"],[147,150,"G35880"],[151,155,"G35880"],[156,162,"G28370"],[163,168,"G28370"]]}},{"n":16,"text":"For the Lord himself, with a shout, with the voice of an archangel, and with a trumpet of God, will come down from heaven, and the dead in Christ will rise first.","sp":{"w":[[0,3,"G37540"],[4,7,"G35880"],[8,12,"G29620"],[13,20,"G08460"],[22,26,"G17220"],[27,28,"G27520"],[29,34,"G27520"],[36,40,"G17220"],[41,44,"G54560"],[45,50,"G54560"],[51,53,"G07430"],[54,56,"G07430"],[57,66,"G07430"],[68,71,"G25320"],[72,76,"G17220"],[77,78,"G45360"],[79,86,"G45360"],[87,89,"G23160"],[90,93,"G23160"],[95,99,"G25970"],[100,104,"G25970"],[105,109,"G25970"],[110,114,"G05750"],[115,121,"G37720"],[123,126,"G25320"],[127,130,"G35880"],[131,135,"G34980"],[136,138,"G17220"],[139,145,"G55470"],[146,150,"G04500"],[151,155,"G04500"],[156,161,"G44120"]]}},{"n":17,"text":"Then we, the ones living, the ones surviving, will be caught up together with them in the clouds to meet the Lord in the air, and in this way we will always be with the Lord.","sp":{"w":[[0,4,"G18990"],[5,7,"G14730"],[9,12,"G35880"],[13,17,"G35880"],[18,24,"G21980"],[26,29,"G35880"],[30,34,"G35880"],[35,44,"G40350"],[46,50,"G07260"],[51,53,"G07260"],[54,60,"G07260"],[61,63,"G07260"],[64,72,"G02600"],[73,77,"G48620"],[78,82,"G08460"],[83,85,"G17220"],[86,89,"G35070"],[90,96,"G35070"],[97,99,"G15190"],[100,104,"G05290"],[105,108,"G35880"],[109,113,"G29620"],[114,116,"G15190"],[117,120,"G01090"],[121,124,"G01090"],[126,129,"G25320"],[130,132,"G37790"],[133,137,"G37790"],[138,141,"G37790"],[142,144,"G15100"],[145,149,"G15100"],[150,156,"G38420"],[157,159,"G15100"],[160,164,"G48620"],[165,168,"G29620"],[169,173,"G29620"]]}},{"n":18,"text":"Therefore, encourage one another with these words.","sp":{"w":[[0,9,"G56200"],[11,20,"G38700"],[21,24,"G02400"],[25,32,"G02400"],[33,37,"G17220"],[38,43,"G37780"],[44,49,"G30560"]]}}]},{"n":5,"verses":[{"n":1,"text":"Now concerning the times and the seasons, brothers, you have no need {for anything} to be written to you.","br":1,"sp":{"w":[[0,3,"G11610"],[4,14,"G40120"],[15,18,"G35880"],[19,24,"G55500"],[25,28,"G25320"],[29,32,"G35880"],[33,40,"G25400"],[42,50,"G00800"],[52,55,"G21920"],[56,60,"G21920"],[61,63,"G37560"],[64,68,"G55320"],[70,73,"G11250"],[74,82,"G11250"],[84,86,"G11250"],[87,89,"G11250"],[90,97,"G11250"],[98,100,"G47710"],[101,104,"G47710"]]}},{"n":2,"text":"For you yourselves know perfectly well that the day of the Lord comes in this manner—as a thief in the night.","sp":{"w":[[0,3,"G10630"],[4,7,"G14920"],[8,18,"G08460"],[19,23,"G14920"],[24,33,"G01990"],[34,38,"G01990"],[39,43,"G37540"],[44,47,"G22500"],[48,51,"G22500"],[52,54,"G29620"],[55,58,"G29620"],[59,63,"G29620"],[64,69,"G20640"],[70,72,"G37790"],[73,77,"G37790"],[78,84,"G37790"],[85,87,"G56130"],[88,89,"G28120"],[90,95,"G28120"],[96,98,"G17220"],[99,102,"G35710"],[103,108,"G35710"]]}},{"n":3,"text":"Whenever they say, “Peace and safety,” then sudden destruction comes on them, just as the birth pain to the one having in the womb, and they will certainly not escape.","sp":{"w":[[0,8,"G37520"],[9,13,"G30040"],[14,17,"G30040"],[20,25,"G15150"],[26,29,"G25320"],[30,36,"G08030"],[39,43,"G51190"],[44,50,"G01600"],[51,62,"G36390"],[63,68,"G21860"],[69,71,"G08460"],[72,76,"G08460"],[78,82,"G56180"],[83,85,"G56180"],[86,89,"G35880"],[90,95,"G56040"],[96,100,"G56040"],[101,103,"G35880"],[104,107,"G35880"],[108,111,"G35880"],[112,118,"G21920"],[119,121,"G17220"],[122,125,"G10640"],[126,130,"G10640"],[132,135,"G25320"],[136,140,"G16280"],[141,145,"G16280"],[146,155,"G33610"],[156,159,"G33610"],[160,166,"G16280"]]}},{"n":4,"text":"But you, brothers, are not in darkness, so that the day might overtake you as a thief.","sp":{"w":[[0,3,"G11610"],[4,7,"G47710"],[9,17,"G00800"],[19,22,"G15100"],[23,26,"G37560"],[27,29,"G17220"],[30,38,"G46550"],[40,42,"G24430"],[43,47,"G24430"],[48,51,"G35880"],[52,55,"G22500"],[56,61,"G26380"],[62,70,"G26380"],[71,74,"G47710"],[75,77,"G56130"],[78,79,"G28120"],[80,85,"G28120"]]}},{"n":5,"text":"For you are all sons of light and sons of day. We are not of night, nor of darkness.","sp":{"w":[[0,3,"G10630"],[4,7,"G47710"],[8,11,"G15100"],[12,15,"G39560"],[16,20,"G52070"],[21,23,"G54570"],[24,29,"G54570"],[30,33,"G25320"],[34,38,"G52070"],[39,41,"G22500"],[42,45,"G22500"],[47,49,"G15100"],[50,53,"G15100"],[54,57,"G37560"],[58,60,"G35710"],[61,66,"G35710"],[68,71,"G37610"],[72,74,"G46550"],[75,83,"G46550"]]}},{"n":6,"text":"So then, let us not sleep as the rest, but let us keep watch and be sober.","sp":{"w":[[0,2,"G37670"],[3,7,"G06860"],[9,12,"G25180"],[13,15,"G25180"],[16,19,"G33610"],[20,25,"G25180"],[26,28,"G56130"],[29,32,"G35880"],[33,37,"G30620"],[39,42,"G02350"],[43,46,"G11270"],[47,49,"G11270"],[50,54,"G11270"],[55,60,"G11270"],[61,64,"G25320"],[65,67,"G35250"],[68,73,"G35250"]]}},{"n":7,"text":"For the ones sleeping sleep at night, and the ones getting drunk get drunk at night.","sp":{"w":[[0,3,"G10630"],[4,7,"G35880"],[8,12,"G35880"],[13,21,"G25180"],[22,27,"G25180"],[28,30,"G35710"],[31,36,"G35710"],[38,41,"G25320"],[42,45,"G35880"],[46,50,"G35880"],[51,58,"G31820"],[59,64,"G31820"],[65,68,"G31840"],[69,74,"G31840"],[75,77,"G35710"],[78,83,"G35710"]]}},{"n":8,"text":"But let us, being of day, be sober, having put on the breastplate of faith and of love, and a helmet—the hope of salvation.","sp":{"w":[[0,3,"G11610"],[4,7,"G35250"],[8,10,"G14730"],[12,17,"G15100"],[18,20,"G22500"],[21,24,"G22500"],[26,28,"G35250"],[29,34,"G35250"],[36,42,"G17460"],[43,46,"G17460"],[47,49,"G17460"],[50,53,"G23820"],[54,65,"G23820"],[66,68,"G41020"],[69,74,"G41020"],[75,78,"G25320"],[79,81,"G00260"],[82,86,"G00260"],[88,91,"G25320"],[92,93,"G40300"],[94,100,"G40300"],[101,104,"G16800"],[105,109,"G16800"],[110,112,"G49910"],[113,122,"G49910"]]}},{"n":9,"text":"For God did not appoint us for wrath, but for the obtaining of salvation through our Lord Jesus Christ,","sp":{"w":[[0,3,"G37540"],[4,7,"G23160"],[8,11,"G50870"],[12,15,"G37560"],[16,23,"G50870"],[24,26,"G14730"],[27,30,"G15190"],[31,36,"G37090"],[38,41,"G02350"],[42,45,"G15190"],[46,49,"G40470"],[50,59,"G40470"],[60,62,"G49910"],[63,72,"G49910"],[73,80,"G12230"],[81,84,"G14730"],[85,89,"G29620"],[90,95,"G24240"],[96,102,"G55470"]]}},{"n":10,"text":"the one having died for us so that, whether we keep watch or sleep, we will live together with him.","sp":{"w":[[0,3,"G35880"],[4,7,"G35880"],[8,14,"G05990"],[15,19,"G05990"],[20,23,"G40120"],[24,26,"G14730"],[27,29,"G24430"],[30,34,"G24430"],[36,43,"G15350"],[44,46,"G11270"],[47,51,"G11270"],[52,57,"G11270"],[58,60,"G15350"],[61,66,"G25180"],[68,70,"G21980"],[71,75,"G21980"],[76,80,"G21980"],[81,89,"G02600"],[90,94,"G48620"],[95,98,"G08460"]]}},{"n":11,"text":"Therefore, encourage one another and build up one the one, just as also you are doing.","sp":{"w":[[0,9,"G13520"],[11,20,"G38700"],[21,24,"G02400"],[25,32,"G02400"],[33,36,"G25320"],[37,42,"G36180"],[43,45,"G36180"],[46,49,"G15200"],[50,53,"G35880"],[54,57,"G15200"],[59,63,"G25310"],[64,66,"G25310"],[67,71,"G25320"],[72,75,"G41600"],[76,79,"G41600"],[80,85,"G41600"]]}},{"n":12,"text":"Now we ask you, brothers, to recognize the ones laboring among you and leading you in the Lord and admonishing you,","br":1,"sp":{"w":[[0,3,"G11610"],[4,6,"G20650"],[7,10,"G20650"],[11,14,"G47710"],[16,24,"G00800"],[26,28,"G14920"],[29,38,"G14920"],[39,42,"G35880"],[43,47,"G35880"],[48,56,"G28720"],[57,62,"G17220"],[63,66,"G47710"],[67,70,"G25320"],[71,78,"G42910"],[79,82,"G47710"],[83,85,"G17220"],[86,89,"G29620"],[90,94,"G29620"],[95,98,"G25320"],[99,110,"G35600"],[111,114,"G47710"]]}},{"n":13,"text":"and to regard them highly in love because of their work. Be at peace among yourselves.","sp":{"w":[[0,3,"G25320"],[4,6,"G22330"],[7,13,"G22330"],[14,18,"G08460"],[19,25,"G52380"],[26,28,"G17220"],[29,33,"G00260"],[34,41,"G12230"],[42,44,"G12230"],[45,50,"G08460"],[51,55,"G20410"],[57,59,"G15140"],[60,62,"G15140"],[63,68,"G15140"],[69,74,"G17220"],[75,85,"G14380"]]}},{"n":14,"text":"Now we encourage you, brothers: Admonish the disorderly, comfort the discouraged, help the weak, be patient toward all.","sp":{"w":[[0,3,"G11610"],[4,6,"G38700"],[7,16,"G38700"],[17,20,"G47710"],[22,30,"G00800"],[32,40,"G35600"],[41,44,"G35880"],[45,55,"G08130"],[57,64,"G38880"],[65,68,"G35880"],[69,80,"G36420"],[82,86,"G04720"],[87,90,"G35880"],[91,95,"G07720"],[97,99,"G31140"],[100,107,"G31140"],[108,114,"G43140"],[115,118,"G39560"]]}},{"n":15,"text":"See that no one repays evil for evil to anyone, but always pursue {what is} good, both for one another and for all.","sp":{"w":[[0,3,"G37080"],[4,8,"G37080"],[9,11,"G33610"],[12,15,"G51000"],[16,22,"G05910"],[23,27,"G25560"],[28,31,"G04730"],[32,36,"G25560"],[37,39,"G51000"],[40,46,"G51000"],[48,51,"G02350"],[52,58,"G38420"],[59,65,"G13770"],[67,71,"G35880"],[72,74,"G35880"],[76,80,"G00180"],[82,86,"G25320"],[87,90,"G15190"],[91,94,"G02400"],[95,102,"G02400"],[103,106,"G25320"],[107,110,"G15190"],[111,114,"G39560"]]}},{"n":16,"text":"Rejoice always.","sp":{"w":[[0,7,"G54630"],[8,14,"G38420"]]}},{"n":17,"text":"Pray continually.","sp":{"w":[[0,4,"G43360"],[5,16,"G00890"]]}},{"n":18,"text":"In everything give thanks, for this {is} the will of God in Christ Jesus for you.","sp":{"w":[[0,2,"G17220"],[3,13,"G39560"],[14,18,"G21680"],[19,25,"G21680"],[27,30,"G10630"],[31,35,"G37780"],[37,39,"G37780"],[41,44,"G23070"],[45,49,"G23070"],[50,52,"G23160"],[53,56,"G23160"],[57,59,"G17220"],[60,66,"G55470"],[67,72,"G24240"],[73,76,"G15190"],[77,80,"G47710"]]}},{"n":19,"text":"Do not quench the Spirit.","sp":{"w":[[0,2,"G45700"],[3,6,"G33610"],[7,13,"G45700"],[14,17,"G35880"],[18,24,"G41510"]]}},{"n":20,"text":"Do not despise prophecies.","sp":{"w":[[0,2,"G18480"],[3,6,"G33610"],[7,14,"G18480"],[15,25,"G43940"]]}},{"n":21,"text":"Test all things. Hold fast to what {is} good.","sp":{"w":[[0,4,"G13810"],[5,8,"G39560"],[9,15,"G39560"],[17,21,"G27220"],[22,26,"G27220"],[27,29,"G27220"],[30,34,"G35880"],[36,38,"G35880"],[40,44,"G25700"]]}},{"n":22,"text":"Keep yourselves from every form of evil.","sp":{"w":[[0,4,"G05680"],[5,15,"G05680"],[16,20,"G05750"],[21,26,"G39560"],[27,31,"G14910"],[32,34,"G41900"],[35,39,"G41900"]]}},{"n":23,"text":"Now may the God of peace himself sanctify you completely, and may your whole spirit, and soul, and body be kept blamelessly at the coming of our Lord Jesus Christ.","br":1,"sp":{"w":[[0,3,"G11610"],[4,7,"G00370"],[8,11,"G35880"],[12,15,"G23160"],[16,18,"G15150"],[19,24,"G15150"],[25,32,"G08460"],[33,41,"G00370"],[42,45,"G47710"],[46,56,"G36510"],[58,61,"G25320"],[62,65,"G50830"],[66,70,"G47710"],[71,76,"G36480"],[77,83,"G41510"],[85,88,"G25320"],[89,93,"G55900"],[95,98,"G25320"],[99,103,"G49830"],[104,106,"G50830"],[107,111,"G50830"],[112,123,"G02740"],[124,126,"G17220"],[127,130,"G35880"],[131,137,"G39520"],[138,140,"G29620"],[141,144,"G14730"],[145,149,"G29620"],[150,155,"G24240"],[156,162,"G55470"]]}},{"n":24,"text":"Faithful {is} the one calling you, who also will do {it}.","sp":{"w":[[0,8,"G41030"],[10,12,"G35880"],[14,17,"G35880"],[18,21,"G35880"],[22,29,"G25640"],[30,33,"G47710"],[35,38,"G37390"],[39,43,"G25320"],[44,48,"G41600"],[49,51,"G41600"],[53,55,"G41600"]]}},{"n":25,"text":"Brothers, pray also for us.","br":1,"sp":{"w":[[0,8,"G00800"],[10,14,"G43360"],[15,19,"G25320"],[20,23,"G40120"],[24,26,"G14730"]]}},{"n":26,"text":"Greet all the brothers with a holy kiss.","br":1,"sp":{"w":[[0,5,"G07820"],[6,9,"G39560"],[10,13,"G35880"],[14,22,"G00800"],[23,27,"G17220"],[28,29,"G53700"],[30,34,"G00400"],[35,39,"G53700"]]}},{"n":27,"text":"I solemnly charge you {by} the Lord to have this letter read to all the brothers.","sp":{"w":[[0,1,"G17745"],[2,10,"G17745"],[11,17,"G17745"],[18,21,"G47710"],[23,25,"G29620"],[27,30,"G29620"],[31,35,"G29620"],[36,38,"G03140"],[39,43,"G03140"],[44,48,"G35880"],[49,55,"G19920"],[56,60,"G03140"],[61,63,"G00800"],[64,67,"G39560"],[68,71,"G00800"],[72,80,"G00800"]]}},{"n":28,"text":"The grace of our Lord Jesus Christ {be} with you.","br":1,"sp":{"w":[[0,3,"G35880"],[4,9,"G54850"],[10,12,"G29620"],[13,16,"G14730"],[17,21,"G29620"],[22,27,"G24240"],[28,34,"G55470"],[36,38,"G33260"],[40,44,"G33260"],[45,48,"G47710"]]}}]}]}
