{"translation":"ult","osis":"2Thess","name":"2 Thessalonians","testament":"nt","title":"Second Thessalonians","chapters":[{"n":1,"verses":[{"n":1,"text":"Paul and Silvanus and Timothy, to the church of the Thessalonians in God our Father and the Lord Jesus Christ.","br":1,"sp":{"w":[[0,4,"G39720"],[5,8,"G25320"],[9,17,"G46100"],[18,21,"G25320"],[22,29,"G50950"],[31,33,"G15770"],[34,37,"G15770"],[38,44,"G15770"],[45,47,"G23310"],[48,51,"G23310"],[52,65,"G23310"],[66,68,"G17220"],[69,72,"G23160"],[73,76,"G14730"],[77,83,"G39620"],[84,87,"G25320"],[88,91,"G29620"],[92,96,"G29620"],[97,102,"G24240"],[103,109,"G55470"]]}},{"n":2,"text":"Grace to you and peace from God the Father and the Lord Jesus Christ.","sp":{"w":[[0,5,"G54850"],[6,8,"G47710"],[9,12,"G47710"],[13,16,"G25320"],[17,22,"G15150"],[23,27,"G05750"],[28,31,"G23160"],[32,35,"G39620"],[36,42,"G39620"],[43,46,"G25320"],[47,50,"G29620"],[51,55,"G29620"],[56,61,"G24240"],[62,68,"G55470"]]}},{"n":3,"text":"We ought always to give thanks to God for you, brothers, just as it is fitting, because your faith is increasing greatly, and the love of each one of you all for one another is increasing;","br":1,"sp":{"w":[[0,2,"G37840"],[3,8,"G37840"],[9,15,"G38420"],[16,18,"G21680"],[19,23,"G21680"],[24,30,"G21680"],[31,33,"G23160"],[34,37,"G23160"],[38,41,"G40120"],[42,45,"G47710"],[47,55,"G00800"],[57,61,"G25310"],[62,64,"G25310"],[65,67,"G15100"],[68,70,"G15100"],[71,78,"G05140"],[80,87,"G37540"],[88,92,"G47710"],[93,98,"G41020"],[99,101,"G52320"],[102,112,"G52320"],[113,120,"G52320"],[122,125,"G25320"],[126,129,"G35880"],[130,134,"G00260"],[135,137,"G15380"],[138,142,"G15380"],[143,146,"G15200"],[147,149,"G47710"],[150,153,"G47710"],[154,157,"G39560"],[158,161,"G15190"],[162,165,"G02400"],[166,173,"G02400"],[174,176,"G41210"],[177,187,"G41210"]]}},{"n":4,"text":"so that we ourselves boast concerning you among the churches of God about your endurance and faith in all your persecutions and afflictions that you endure,","sp":{"w":[[0,2,"G56200"],[3,7,"G56200"],[8,10,"G14730"],[11,20,"G08460"],[21,26,"G14605"],[27,37,"G17220"],[38,41,"G47710"],[42,47,"G17220"],[48,51,"G35880"],[52,60,"G15770"],[61,63,"G23160"],[64,67,"G23160"],[68,73,"G52280"],[74,78,"G47710"],[79,88,"G52810"],[89,92,"G25320"],[93,98,"G41020"],[99,101,"G17220"],[102,105,"G39560"],[106,110,"G47710"],[111,123,"G13750"],[124,127,"G25320"],[128,139,"G23470"],[140,144,"G37390"],[145,148,"G04300"],[149,155,"G04300"]]}},{"n":5,"text":"evidence of the righteous judgment of God, for you to be considered worthy of the kingdom of God, for which you also suffer;","sp":{"w":[[0,8,"G17300"],[9,11,"G29200"],[12,15,"G29200"],[16,25,"G13420"],[26,34,"G29200"],[35,37,"G23160"],[38,41,"G23160"],[43,46,"G47710"],[47,50,"G47710"],[51,53,"G26610"],[54,56,"G26610"],[57,67,"G26610"],[68,74,"G26610"],[75,77,"G09320"],[78,81,"G09320"],[82,89,"G09320"],[90,92,"G23160"],[93,96,"G23160"],[98,101,"G52280"],[102,107,"G37390"],[108,111,"G39580"],[112,116,"G25320"],[117,123,"G39580"]]}},{"n":6,"text":"if indeed {it is} righteous for God to return affliction to the ones afflicting you,","sp":{"w":[[0,2,"G14870"],[3,9,"G14870"],[11,13,"G13420"],[14,16,"G13420"],[18,27,"G13420"],[28,31,"G38440"],[32,35,"G23160"],[36,38,"G04670"],[39,45,"G04670"],[46,56,"G23470"],[57,59,"G35880"],[60,63,"G35880"],[64,68,"G35880"],[69,79,"G23460"],[80,83,"G47710"]]}},{"n":7,"text":"and relief to you, the ones being afflicted with us at the revealing of the Lord Jesus from heaven with his mighty angels,","sp":{"w":[[0,3,"G25320"],[4,10,"G04250"],[11,13,"G47710"],[14,17,"G47710"],[19,22,"G35880"],[23,27,"G35880"],[28,33,"G23460"],[34,43,"G23460"],[44,48,"G33260"],[49,51,"G14730"],[52,54,"G17220"],[55,58,"G35880"],[59,68,"G06020"],[69,71,"G29620"],[72,75,"G29620"],[76,80,"G29620"],[81,86,"G24240"],[87,91,"G05750"],[92,98,"G37720"],[99,103,"G33260"],[104,107,"G08460"],[108,114,"G14110"],[115,121,"G00320"]]}},{"n":8,"text":"in flaming fire taking vengeance on the ones not having known God and on the ones not obeying the gospel of our Lord Jesus,","sp":{"w":[[0,2,"G17220"],[3,10,"G53950"],[11,15,"G44420"],[16,22,"G13250"],[23,32,"G15570"],[33,35,"G35880"],[36,39,"G35880"],[40,44,"G35880"],[45,48,"G33610"],[49,55,"G14920"],[56,61,"G14920"],[62,65,"G23160"],[66,69,"G25320"],[70,72,"G35880"],[73,76,"G35880"],[77,81,"G35880"],[82,85,"G33610"],[86,93,"G52190"],[94,97,"G35880"],[98,104,"G20980"],[105,107,"G29620"],[108,111,"G14730"],[112,116,"G29620"],[117,122,"G24240"]]}},{"n":9,"text":"who will pay the penalty—eternal destruction away from the face of the Lord and from the glory of his power,","sp":{"w":[[0,3,"G37480"],[4,8,"G50990"],[9,12,"G50990"],[13,16,"G13490"],[17,24,"G13490"],[25,32,"G01660"],[33,44,"G36390"],[45,49,"G05750"],[50,54,"G05750"],[55,58,"G43830"],[59,63,"G43830"],[64,66,"G29620"],[67,70,"G29620"],[71,75,"G29620"],[76,79,"G25320"],[80,84,"G05750"],[85,88,"G35880"],[89,94,"G13910"],[95,97,"G24790"],[98,101,"G08460"],[102,107,"G24790"]]}},{"n":10,"text":"when he comes on that day to be glorified by his saints and to be marveled at by all the ones having believed, for our testimony to you has been believed.","sp":{"w":[[0,4,"G37520"],[5,7,"G20640"],[8,13,"G20640"],[14,16,"G17220"],[17,21,"G15650"],[22,25,"G22500"],[26,28,"G17400"],[29,31,"G17400"],[32,41,"G17400"],[42,44,"G17220"],[45,48,"G08460"],[49,55,"G00400"],[56,59,"G25320"],[60,62,"G22960"],[63,65,"G22960"],[66,74,"G22960"],[75,77,"G22960"],[78,80,"G17220"],[81,84,"G39560"],[85,88,"G35880"],[89,93,"G35880"],[94,100,"G41000"],[101,109,"G41000"],[111,114,"G37540"],[115,118,"G14730"],[119,128,"G31420"],[129,131,"G19090"],[132,135,"G47710"],[136,139,"G41000"],[140,144,"G41000"],[145,153,"G41000"]]}},{"n":11,"text":"For this we also pray always for you, so that our God may consider you worthy of the calling and he may fulfill every desire of goodness and work of faith in power","sp":{"w":[[0,3,"G15190"],[4,8,"G37390"],[9,11,"G43360"],[12,16,"G25320"],[17,21,"G43360"],[22,28,"G38420"],[29,32,"G40120"],[33,36,"G47710"],[38,40,"G24430"],[41,45,"G24430"],[46,49,"G14730"],[50,53,"G23160"],[54,57,"G05150"],[58,66,"G05150"],[67,70,"G47710"],[71,77,"G05150"],[78,80,"G28210"],[81,84,"G28210"],[85,92,"G28210"],[93,96,"G25320"],[97,99,"G41370"],[100,103,"G41370"],[104,111,"G41370"],[112,117,"G39560"],[118,124,"G21070"],[125,127,"G00190"],[128,136,"G00190"],[137,140,"G25320"],[141,145,"G20410"],[146,148,"G41020"],[149,154,"G41020"],[155,157,"G17220"],[158,163,"G14110"]]}},{"n":12,"text":"so that the name of our Lord Jesus might be glorified in you, and you in him, according to the grace of our God and the Lord Jesus Christ.","sp":{"w":[[0,2,"G37040"],[3,7,"G37040"],[8,11,"G35880"],[12,16,"G36860"],[17,19,"G29620"],[20,23,"G14730"],[24,28,"G29620"],[29,34,"G24240"],[35,40,"G17400"],[41,43,"G17400"],[44,53,"G17400"],[54,56,"G17220"],[57,60,"G47710"],[62,65,"G25320"],[66,69,"G47710"],[70,72,"G17220"],[73,76,"G08460"],[78,87,"G25960"],[88,90,"G25960"],[91,94,"G35880"],[95,100,"G54850"],[101,103,"G23160"],[104,107,"G14730"],[108,111,"G23160"],[112,115,"G25320"],[116,119,"G29620"],[120,124,"G29620"],[125,130,"G24240"],[131,137,"G55470"]]}}]},{"n":2,"verses":[{"n":1,"text":"Now about the coming of our Lord Jesus Christ and our gathering to him, we ask you, brothers,","br":1,"sp":{"w":[[0,3,"G11610"],[4,9,"G52280"],[10,13,"G35880"],[14,20,"G39520"],[21,23,"G29620"],[24,27,"G14730"],[28,32,"G29620"],[33,38,"G24240"],[39,45,"G55470"],[46,49,"G25320"],[50,53,"G14730"],[54,63,"G19970"],[64,66,"G19090"],[67,70,"G08460"],[72,74,"G20650"],[75,78,"G20650"],[79,82,"G47710"],[84,92,"G00800"]]}},{"n":2,"text":"for you not to be quickly shaken in your mind and not to be troubled neither by a spirit nor by a word nor by a letter as if from us, as if the day of the Lord has already come.","sp":{"w":[[0,3,"G47710"],[4,7,"G47710"],[8,11,"G33610"],[12,14,"G45310"],[15,17,"G45310"],[18,25,"G50300"],[26,32,"G45310"],[33,35,"G05750"],[36,40,"G35880"],[41,45,"G35630"],[46,49,"G33660"],[50,53,"G33660"],[54,56,"G23600"],[57,59,"G23600"],[60,68,"G23600"],[69,76,"G33830"],[77,79,"G12230"],[80,81,"G41510"],[82,88,"G41510"],[89,92,"G33830"],[93,95,"G12230"],[96,97,"G30560"],[98,102,"G30560"],[103,106,"G33830"],[107,109,"G12230"],[110,111,"G19920"],[112,118,"G19920"],[119,121,"G56130"],[122,124,"G56130"],[125,129,"G12230"],[130,132,"G14730"],[134,136,"G56130"],[137,139,"G56130"],[140,143,"G35880"],[144,147,"G22500"],[148,150,"G29620"],[151,154,"G29620"],[155,159,"G29620"],[160,163,"G17640"],[164,171,"G17640"],[172,176,"G17640"]]}},{"n":3,"text":"May no one deceive you in any way, for unless the apostasy comes first and the man of lawlessness is revealed, the son of destruction,","sp":{"w":[[0,3,"G18180"],[4,6,"G33610"],[7,10,"G51000"],[11,18,"G18180"],[19,22,"G47710"],[23,25,"G25960"],[26,29,"G33670"],[30,33,"G51580"],[35,38,"G37540"],[39,45,"G33610"],[46,49,"G35880"],[50,58,"G06460"],[59,64,"G20640"],[65,70,"G44120"],[71,74,"G25320"],[75,78,"G35880"],[79,82,"G04440"],[83,85,"G04580"],[86,97,"G04580"],[98,100,"G06010"],[101,109,"G06010"],[111,114,"G35880"],[115,118,"G52070"],[119,121,"G06840"],[122,133,"G06840"]]}},{"n":4,"text":"the one opposing and exalting himself against everything being called god or an object of worship. As a result, he himself sits in the temple of God, showing that he himself is God.","sp":{"w":[[0,3,"G35880"],[4,7,"G35880"],[8,16,"G04800"],[17,20,"G25320"],[21,29,"G52290"],[30,37,"G52290"],[38,45,"G19090"],[46,56,"G39560"],[57,62,"G30040"],[63,69,"G30040"],[70,73,"G23160"],[74,76,"G22280"],[77,79,"G45740"],[80,86,"G45740"],[87,89,"G45740"],[90,97,"G45740"],[99,101,"G56200"],[102,103,"G56200"],[104,110,"G56200"],[112,114,"G25230"],[115,122,"G08460"],[123,127,"G25230"],[128,130,"G15190"],[131,134,"G35880"],[135,141,"G34850"],[142,144,"G23160"],[145,148,"G23160"],[150,157,"G05840"],[158,162,"G37540"],[163,165,"G15100"],[166,173,"G14380"],[174,176,"G15100"],[177,180,"G23160"]]}},{"n":5,"text":"Do you not remember that, still being with you, I was telling you these things?","sp":{"w":[[0,2,"G34210"],[3,6,"G34210"],[7,10,"G37560"],[11,19,"G34210"],[20,24,"G37540"],[26,31,"G20890"],[32,37,"G15100"],[38,42,"G43140"],[43,46,"G47710"],[48,49,"G30040"],[50,53,"G30040"],[54,61,"G30040"],[62,65,"G47710"],[66,71,"G37780"],[72,78,"G37780"]]}},{"n":6,"text":"And now you know the one restraining {him}, until his revealing in his time.","sp":{"w":[[0,3,"G25320"],[4,7,"G35680"],[8,11,"G14920"],[12,16,"G14920"],[17,20,"G35880"],[21,24,"G35880"],[25,36,"G27220"],[38,41,"G27220"],[44,49,"G15190"],[50,53,"G08460"],[54,63,"G06010"],[64,66,"G17220"],[67,70,"G08460"],[71,75,"G25400"]]}},{"n":7,"text":"For the mystery of lawlessness is already working, only the one restraining {him} now will do so until he comes out of the way,","sp":{"w":[[0,3,"G10630"],[4,7,"G35880"],[8,15,"G34660"],[16,18,"G04580"],[19,30,"G04580"],[31,33,"G17540"],[34,41,"G22350"],[42,49,"G17540"],[51,55,"G34400"],[56,59,"G35880"],[60,63,"G35880"],[64,75,"G27220"],[77,80,"G27220"],[82,85,"G07370"],[86,90,"G21930"],[91,93,"G21930"],[94,96,"G21930"],[97,102,"G21930"],[103,105,"G10960"],[106,111,"G10960"],[112,115,"G15370"],[116,118,"G15370"],[119,122,"G33190"],[123,126,"G33190"]]}},{"n":8,"text":"and then the lawless one will be revealed, whom the Lord Jesus will kill with the breath of his mouth, and will bring to nothing by the appearance of his coming,","sp":{"w":[[0,3,"G25320"],[4,8,"G51190"],[9,12,"G35880"],[13,20,"G04590"],[21,24,"G04590"],[25,29,"G06010"],[30,32,"G06010"],[33,41,"G06010"],[43,47,"G37390"],[48,51,"G35880"],[52,56,"G29620"],[57,62,"G24240"],[63,67,"G03370"],[68,72,"G03370"],[73,77,"G41510"],[78,81,"G41510"],[82,88,"G41510"],[89,91,"G47500"],[92,95,"G08460"],[96,101,"G47500"],[103,106,"G25320"],[107,111,"G26730"],[112,117,"G26730"],[118,120,"G26730"],[121,128,"G26730"],[129,131,"G20150"],[132,135,"G20150"],[136,146,"G20150"],[147,149,"G39520"],[150,153,"G08460"],[154,160,"G39520"]]}},{"n":9,"text":"the arrival of whom is according to a work of Satan in all power and signs and false wonders","sp":{"w":[[0,3,"G35880"],[4,11,"G39520"],[12,14,"G37390"],[15,19,"G37390"],[20,22,"G15100"],[23,32,"G25960"],[33,35,"G25960"],[36,37,"G17530"],[38,42,"G17530"],[43,45,"G45660"],[46,51,"G45660"],[52,54,"G17220"],[55,58,"G39560"],[59,64,"G14110"],[65,68,"G25320"],[69,74,"G45920"],[75,78,"G25320"],[79,84,"G55790"],[85,92,"G50590"]]}},{"n":10,"text":"and in all deceit of unrighteousness to the ones perishing, because of which they did not receive the love of the truth for them to be saved.","sp":{"w":[[0,3,"G25320"],[4,6,"G17220"],[7,10,"G39560"],[11,17,"G05390"],[18,20,"G00930"],[21,36,"G00930"],[37,39,"G35880"],[40,43,"G35880"],[44,48,"G35880"],[49,58,"G06220"],[60,67,"G04730"],[68,70,"G37390"],[71,76,"G37390"],[77,81,"G12090"],[82,85,"G12090"],[86,89,"G37560"],[90,97,"G12090"],[98,101,"G35880"],[102,106,"G00260"],[107,109,"G02250"],[110,113,"G02250"],[114,119,"G02250"],[120,123,"G08460"],[124,128,"G08460"],[129,131,"G15190"],[132,134,"G49820"],[135,140,"G49820"]]}},{"n":11,"text":"And because of this, God is sending to them a working of error for them to believe the lie","sp":{"w":[[0,3,"G25320"],[4,11,"G12230"],[12,14,"G12230"],[15,19,"G37780"],[21,24,"G23160"],[25,27,"G39920"],[28,35,"G39920"],[36,38,"G08460"],[39,43,"G08460"],[44,45,"G17530"],[46,53,"G17530"],[54,56,"G41060"],[57,62,"G41060"],[63,66,"G15190"],[67,71,"G08460"],[72,74,"G41000"],[75,82,"G41000"],[83,86,"G35880"],[87,90,"G55790"]]}},{"n":12,"text":"so that they might all be judged, the ones not having believed the truth, but having taken pleasure in the unrighteousness.","sp":{"w":[[0,2,"G24430"],[3,7,"G24430"],[8,12,"G29190"],[13,18,"G29190"],[19,22,"G39560"],[23,25,"G29190"],[26,32,"G29190"],[34,37,"G35880"],[38,42,"G35880"],[43,46,"G33610"],[47,53,"G41000"],[54,62,"G41000"],[63,66,"G35880"],[67,72,"G02250"],[74,77,"G02350"],[78,84,"G21060"],[85,90,"G21060"],[91,99,"G21060"],[100,102,"G00930"],[103,106,"G00930"],[107,122,"G00930"]]}},{"n":13,"text":"Now we ought always to give thanks to God for you, brothers having been loved by the Lord. For God chose you {as} firstfruits for salvation in sanctification of the Spirit and belief in the truth.","br":1,"sp":{"w":[[0,3,"G11610"],[4,6,"G14730"],[7,12,"G37840"],[13,19,"G38420"],[20,22,"G21680"],[23,27,"G21680"],[28,34,"G21680"],[35,37,"G23160"],[38,41,"G23160"],[42,45,"G40120"],[46,49,"G47710"],[51,59,"G00800"],[60,66,"G00250"],[67,71,"G00250"],[72,77,"G00250"],[78,80,"G52590"],[81,84,"G29620"],[85,89,"G29620"],[91,94,"G37540"],[95,98,"G23160"],[99,104,"G01380"],[105,108,"G47710"],[110,112,"G05360"],[114,125,"G05360"],[126,129,"G15190"],[130,139,"G49910"],[140,142,"G17220"],[143,157,"G00380"],[158,160,"G41510"],[161,164,"G41510"],[165,171,"G41510"],[172,175,"G25320"],[176,182,"G41020"],[183,185,"G02250"],[186,189,"G02250"],[190,195,"G02250"]]}},{"n":14,"text":"He called you to this through our gospel, to the acquiring of the glory of our Lord Jesus Christ.","sp":{"w":[[0,2,"G25640"],[3,9,"G25640"],[10,13,"G47710"],[14,16,"G15190"],[17,21,"G37390"],[22,29,"G12230"],[30,33,"G14730"],[34,40,"G20980"],[42,44,"G15190"],[45,48,"G40470"],[49,58,"G40470"],[59,61,"G13910"],[62,65,"G13910"],[66,71,"G13910"],[72,74,"G29620"],[75,78,"G14730"],[79,83,"G29620"],[84,89,"G24240"],[90,96,"G55470"]]}},{"n":15,"text":"So then, brothers, stand firm and hold tight to the traditions that you were taught, whether by word or by our letter.","sp":{"w":[[0,2,"G06860"],[3,7,"G37670"],[9,17,"G00800"],[19,24,"G47390"],[25,29,"G47390"],[30,33,"G25320"],[34,38,"G29020"],[39,44,"G29020"],[45,47,"G29020"],[48,51,"G35880"],[52,62,"G38620"],[63,67,"G37390"],[68,71,"G13210"],[72,76,"G13210"],[77,83,"G13210"],[85,92,"G15350"],[93,95,"G12230"],[96,100,"G30560"],[101,103,"G15350"],[104,106,"G12230"],[107,110,"G14730"],[111,117,"G19920"]]}},{"n":16,"text":"Now our Lord Jesus Christ himself, and God our Father, who loved us and gave {us} eternal comfort and good hope through grace,","br":1,"sp":{"w":[[0,3,"G11610"],[4,7,"G14730"],[8,12,"G29620"],[13,18,"G24240"],[19,25,"G55470"],[26,33,"G08460"],[35,38,"G25320"],[39,42,"G23160"],[43,46,"G14730"],[47,53,"G39620"],[55,58,"G00250"],[59,64,"G00250"],[65,67,"G14730"],[68,71,"G25320"],[72,76,"G13250"],[78,80,"G13250"],[82,89,"G01660"],[90,97,"G38740"],[98,101,"G25320"],[102,106,"G00180"],[107,111,"G16800"],[112,119,"G17220"],[120,125,"G54850"]]}},{"n":17,"text":"may he comfort and strengthen your hearts in every good work and word.","sp":{"w":[[0,3,"G38700"],[4,6,"G38700"],[7,14,"G38700"],[15,18,"G25320"],[19,29,"G47410"],[30,34,"G47710"],[35,41,"G25880"],[42,44,"G17220"],[45,50,"G39560"],[51,55,"G00180"],[56,60,"G20410"],[61,64,"G25320"],[65,69,"G30560"]]}}]},{"n":3,"verses":[{"n":1,"text":"Finally, brothers, pray for us so that the word of the Lord might run and might be glorified, just as also with you,","br":1,"sp":{"w":[[0,7,"G30620"],[9,17,"G00800"],[19,23,"G43360"],[24,27,"G40120"],[28,30,"G14730"],[31,33,"G24430"],[34,38,"G24430"],[39,42,"G35880"],[43,47,"G30560"],[48,50,"G29620"],[51,54,"G29620"],[55,59,"G29620"],[60,65,"G51430"],[66,69,"G51430"],[70,73,"G25320"],[74,79,"G13920"],[80,82,"G13920"],[83,92,"G13920"],[94,98,"G25310"],[99,101,"G25310"],[102,106,"G25320"],[107,111,"G43140"],[112,115,"G47710"]]}},{"n":2,"text":"and so that we might be rescued from the perverse and evil men, for not everyone {has} the faith.","sp":{"w":[[0,3,"G25320"],[4,6,"G24430"],[7,11,"G24430"],[12,14,"G45060"],[15,20,"G45060"],[21,23,"G45060"],[24,31,"G45060"],[32,36,"G05750"],[37,40,"G35880"],[41,49,"G08240"],[50,53,"G25320"],[54,58,"G41900"],[59,62,"G04440"],[64,67,"G10630"],[68,71,"G37560"],[72,80,"G39560"],[82,85,"G41020"],[87,90,"G35880"],[91,96,"G41020"]]}},{"n":3,"text":"But the Lord is faithful, who will strengthen and keep you from the evil one.","sp":{"w":[[0,3,"G11610"],[4,7,"G35880"],[8,12,"G29620"],[13,15,"G15100"],[16,24,"G41030"],[26,29,"G37390"],[30,34,"G47410"],[35,45,"G47410"],[46,49,"G25320"],[50,54,"G54420"],[55,58,"G47710"],[59,63,"G05750"],[64,67,"G35880"],[68,72,"G41900"],[73,76,"G41900"]]}},{"n":4,"text":"We are also confident in the Lord about you that you are doing and will do what we command.","sp":{"w":[[0,2,"G39820"],[3,6,"G39820"],[7,11,"G11610"],[12,21,"G39820"],[22,24,"G17220"],[25,28,"G29620"],[29,33,"G29620"],[34,39,"G19090"],[40,43,"G47710"],[44,48,"G37540"],[49,52,"G41600"],[53,56,"G41600"],[57,62,"G41600"],[63,66,"G25320"],[67,71,"G41600"],[72,74,"G41600"],[75,79,"G37390"],[80,82,"G38530"],[83,90,"G38530"]]}},{"n":5,"text":"Now may the Lord direct your hearts to the love of God and to the endurance of Christ.","sp":{"w":[[0,3,"G11610"],[4,7,"G27200"],[8,11,"G35880"],[12,16,"G29620"],[17,23,"G27200"],[24,28,"G47710"],[29,35,"G25880"],[36,38,"G15190"],[39,42,"G35880"],[43,47,"G00260"],[48,50,"G23160"],[51,54,"G23160"],[55,58,"G25320"],[59,61,"G15190"],[62,65,"G35880"],[66,75,"G52810"],[76,78,"G55470"],[79,85,"G55470"]]}},{"n":6,"text":"Now we command you, brothers, in the name of our Lord Jesus Christ, for you to keep away from every brother walking disorderly and not according to the traditions which you received from us.","br":1,"sp":{"w":[[0,3,"G11610"],[4,6,"G38530"],[7,14,"G38530"],[15,18,"G47710"],[20,28,"G00800"],[30,32,"G17220"],[33,36,"G36860"],[37,41,"G36860"],[42,44,"G29620"],[45,48,"G14730"],[49,53,"G29620"],[54,59,"G24240"],[60,66,"G55470"],[68,71,"G47710"],[72,75,"G47710"],[76,78,"G47240"],[79,83,"G47240"],[84,88,"G47240"],[89,93,"G05750"],[94,99,"G39560"],[100,107,"G00800"],[108,115,"G40430"],[116,126,"G08140"],[127,130,"G25320"],[131,134,"G33610"],[135,144,"G25960"],[145,147,"G25960"],[148,151,"G35880"],[152,162,"G38620"],[163,168,"G37390"],[169,172,"G38800"],[173,181,"G38800"],[182,186,"G38440"],[187,189,"G14730"]]}},{"n":7,"text":"For you yourselves know in what manner it is necessary to imitate us, because we did not behave disorderly among you,","sp":{"w":[[0,3,"G10630"],[4,7,"G14920"],[8,18,"G08460"],[19,23,"G14920"],[24,26,"G44590"],[27,31,"G44590"],[32,38,"G44590"],[39,41,"G12100"],[42,44,"G12100"],[45,54,"G12100"],[55,57,"G34010"],[58,65,"G34010"],[66,68,"G14730"],[70,77,"G37540"],[78,80,"G08120"],[81,84,"G08120"],[85,88,"G37560"],[89,95,"G08120"],[96,106,"G08120"],[107,112,"G17220"],[113,116,"G47710"]]}},{"n":8,"text":"nor did we eat bread from anyone for free, but, working night and day in toil and hardship not to burden any of you,","sp":{"w":[[0,3,"G37610"],[4,7,"G20680"],[8,10,"G20680"],[11,14,"G20680"],[15,20,"G07400"],[21,25,"G38440"],[26,32,"G51000"],[33,36,"G14320"],[37,41,"G14320"],[43,46,"G02350"],[48,55,"G20380"],[56,61,"G35710"],[62,65,"G25320"],[66,69,"G22500"],[70,72,"G17220"],[73,77,"G28730"],[78,81,"G25320"],[82,90,"G34490"],[91,94,"G33610"],[95,97,"G19120"],[98,104,"G19120"],[105,108,"G51000"],[109,111,"G47710"],[112,115,"G47710"]]}},{"n":9,"text":"not because we do not have authority, but in order that we might offer ourselves {as} an example to you to imitate us.","sp":{"w":[[0,3,"G37560"],[4,11,"G37540"],[12,14,"G21920"],[15,17,"G21920"],[18,21,"G37560"],[22,26,"G21920"],[27,36,"G18490"],[38,41,"G02350"],[42,44,"G24430"],[45,50,"G24430"],[51,55,"G24430"],[56,58,"G13250"],[59,64,"G13250"],[65,70,"G13250"],[71,80,"G14380"],[82,84,"G51790"],[86,88,"G51790"],[89,96,"G51790"],[97,99,"G47710"],[100,103,"G47710"],[104,106,"G34010"],[107,114,"G34010"],[115,117,"G14730"]]}},{"n":10,"text":"For even when we were with you, we were commanding you this, “If anyone is not willing to work, do not even let him eat.”","sp":{"w":[[0,3,"G10630"],[4,8,"G25320"],[9,13,"G37530"],[14,16,"G15100"],[17,21,"G15100"],[22,26,"G43140"],[27,30,"G47710"],[32,34,"G38530"],[35,39,"G38530"],[40,50,"G38530"],[51,54,"G47710"],[55,59,"G37780"],[62,64,"G14870"],[65,71,"G51000"],[72,74,"G23090"],[75,78,"G37560"],[79,86,"G23090"],[87,89,"G20380"],[90,94,"G20380"],[96,98,"G20680"],[99,102,"G33660"],[103,107,"G33660"],[108,111,"G20680"],[112,115,"G20680"],[116,119,"G20680"]]}},{"n":11,"text":"For we hear about some walking idly among you, not working, but meddling.","sp":{"w":[[0,3,"G10630"],[4,6,"G01910"],[7,11,"G01910"],[12,17,"G01910"],[18,22,"G51000"],[23,30,"G40430"],[31,35,"G08140"],[36,41,"G17220"],[42,45,"G47710"],[47,50,"G33670"],[51,58,"G20380"],[60,63,"G02350"],[64,72,"G40200"]]}},{"n":12,"text":"But such ones we are commanding and exhorting in the Lord Jesus Christ, that working with quietness, they might eat their own bread.","sp":{"w":[[0,3,"G11610"],[4,8,"G51080"],[9,13,"G35880"],[14,16,"G38530"],[17,20,"G38530"],[21,31,"G38530"],[32,35,"G25320"],[36,45,"G38700"],[46,48,"G17220"],[49,52,"G29620"],[53,57,"G29620"],[58,63,"G24240"],[64,70,"G55470"],[72,76,"G24430"],[77,84,"G20380"],[85,89,"G33260"],[90,99,"G22710"],[101,105,"G20680"],[106,111,"G20680"],[112,115,"G20680"],[116,121,"G14380"],[122,125,"G14380"],[126,131,"G07400"]]}},{"n":13,"text":"But you, brothers, do not become weary in doing what is right.","sp":{"w":[[0,3,"G11610"],[4,7,"G47710"],[9,17,"G00800"],[19,21,"G14555"],[22,25,"G33610"],[26,32,"G14555"],[33,38,"G14555"],[39,41,"G25690"],[42,47,"G25690"],[48,52,"G25690"],[53,55,"G25690"],[56,61,"G25690"]]}},{"n":14,"text":"Now if anyone does not obey our word through the letter, note this one—not to associate with him, so that he may be put to shame.","sp":{"w":[[0,3,"G11610"],[4,6,"G14870"],[7,13,"G51000"],[14,18,"G52190"],[19,22,"G37560"],[23,27,"G52190"],[28,31,"G14730"],[32,36,"G30560"],[37,44,"G12230"],[45,48,"G35880"],[49,55,"G19920"],[57,61,"G45930"],[62,66,"G37780"],[67,70,"G37780"],[71,74,"G33610"],[75,77,"G48740"],[78,87,"G48740"],[88,92,"G48740"],[93,96,"G08460"],[98,100,"G24430"],[101,105,"G24430"],[106,108,"G17880"],[109,112,"G17880"],[113,115,"G17880"],[116,119,"G17880"],[120,122,"G17880"],[123,128,"G17880"]]}},{"n":15,"text":"And do not consider {him} as an enemy, but warn him as a brother.","sp":{"w":[[0,3,"G25320"],[4,6,"G22330"],[7,10,"G33610"],[11,19,"G22330"],[21,24,"G22330"],[26,28,"G56130"],[29,31,"G21900"],[32,37,"G21900"],[39,42,"G02350"],[43,47,"G35600"],[48,51,"G35600"],[52,54,"G56130"],[55,56,"G00800"],[57,64,"G00800"]]}},{"n":16,"text":"Now may the Lord of peace himself give you peace through all in every way. The Lord {be} with you all.","br":1,"sp":{"w":[[0,3,"G11610"],[4,7,"G13250"],[8,11,"G35880"],[12,16,"G29620"],[17,19,"G15150"],[20,25,"G15150"],[26,33,"G08460"],[34,38,"G13250"],[39,42,"G47710"],[43,48,"G15150"],[49,56,"G12230"],[57,60,"G39560"],[61,63,"G17220"],[64,69,"G39560"],[70,73,"G51580"],[75,78,"G35880"],[79,83,"G29620"],[85,87,"G33260"],[89,93,"G33260"],[94,97,"G47710"],[98,101,"G39560"]]}},{"n":17,"text":"This greeting {is} in my own hand—Paul—which is a sign in every letter. In this manner I write.","sp":{"w":[[0,4,"G35880"],[5,13,"G07830"],[15,17,"G54950"],[19,21,"G54950"],[22,24,"G16990"],[25,28,"G16990"],[29,33,"G54950"],[34,38,"G39720"],[39,44,"G37390"],[45,47,"G15100"],[48,49,"G45920"],[50,54,"G45920"],[55,57,"G17220"],[58,63,"G39560"],[64,70,"G19920"],[72,74,"G37790"],[75,79,"G37790"],[80,86,"G37790"],[87,88,"G11250"],[89,94,"G11250"]]}},{"n":18,"text":"The grace of our Lord Jesus Christ {be} with you all.","sp":{"w":[[0,3,"G35880"],[4,9,"G54850"],[10,12,"G29620"],[13,16,"G14730"],[17,21,"G29620"],[22,27,"G24240"],[28,34,"G55470"],[36,38,"G33260"],[40,44,"G33260"],[45,48,"G47710"],[49,52,"G39560"]]}}]}]}
