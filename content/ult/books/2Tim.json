{"translation":"ult","osis":"2Tim","name":"2 Timothy","testament":"nt","title":"Second Timothy","chapters":[{"n":1,"verses":[{"n":1,"text":"Paul, an apostle of Christ Jesus through the will of God, according to the promise of life that {is} in Christ Jesus,","br":1,"sp":{"w":[[0,4,"G39720"],[6,8,"G06520"],[9,16,"G06520"],[17,19,"G55470"],[20,26,"G55470"],[27,32,"G24240"],[33,40,"G12230"],[41,44,"G23070"],[45,49,"G23070"],[50,52,"G23160"],[53,56,"G23160"],[58,67,"G25960"],[68,70,"G25960"],[71,74,"G18600"],[75,82,"G18600"],[83,85,"G22220"],[86,90,"G22220"],[91,95,"G35880"],[97,99,"G35880"],[101,103,"G17220"],[104,110,"G55470"],[111,116,"G24240"]]}},{"n":2,"text":"to Timothy, beloved child.","br":1,"sp":{"w":[[0,2,"G50950"],[3,10,"G50950"],[12,19,"G00270"],[20,25,"G50430"]]}},{"n":3,"text":"I have gratitude to God, whom I serve from my ancestors, with a pure conscience, as I have the constant remembrance concerning you in my prayers night and day,","br":1,"sp":{"w":[[0,1,"G21920"],[2,6,"G21920"],[7,16,"G54850"],[17,19,"G23160"],[20,23,"G23160"],[25,29,"G37390"],[30,31,"G30000"],[32,37,"G30000"],[38,42,"G05750"],[43,45,"G42690"],[46,55,"G42690"],[57,61,"G17220"],[62,63,"G48930"],[64,68,"G25130"],[69,79,"G48930"],[81,83,"G56130"],[84,85,"G21920"],[86,90,"G21920"],[91,94,"G35880"],[95,103,"G00880"],[104,115,"G34170"],[116,126,"G40120"],[127,130,"G47710"],[131,133,"G17220"],[134,136,"G14730"],[137,144,"G11620"],[145,150,"G35710"],[151,154,"G25320"],[155,158,"G22500"]]}},{"n":4,"text":"longing to see you, remembering your tears, so that I may be filled with joy,","sp":{"w":[[0,7,"G19710"],[8,10,"G37080"],[11,14,"G37080"],[15,18,"G47710"],[20,31,"G34030"],[32,36,"G47710"],[37,42,"G11440"],[44,46,"G24430"],[47,51,"G24430"],[52,53,"G41370"],[54,57,"G41370"],[58,60,"G41370"],[61,67,"G41370"],[68,72,"G54790"],[73,76,"G54790"]]}},{"n":5,"text":"having received remembrance of the sincere faith in you, which dwelled first in your grandmother Lois and your mother Eunice, and I am persuaded that {it is} also in you.","sp":{"w":[[0,6,"G29830"],[7,15,"G29830"],[16,27,"G52800"],[28,30,"G41020"],[31,34,"G35880"],[35,42,"G05050"],[43,48,"G41020"],[49,51,"G17220"],[52,55,"G47710"],[57,62,"G37480"],[63,70,"G17740"],[71,76,"G44120"],[77,79,"G17220"],[80,84,"G47710"],[85,96,"G31250"],[97,101,"G30900"],[102,105,"G25320"],[106,110,"G47710"],[111,117,"G33840"],[118,124,"G21310"],[126,129,"G11610"],[130,131,"G39820"],[132,134,"G39820"],[135,144,"G39820"],[145,149,"G37540"],[151,153,"G37540"],[154,156,"G37540"],[158,162,"G25320"],[163,165,"G17220"],[166,169,"G47710"]]}},{"n":6,"text":"For which reason, I am reminding you to rekindle the gift of God that is in you through the laying on of my hands.","br":1,"sp":{"w":[[0,3,"G12230"],[4,9,"G37390"],[10,16,"G01560"],[18,19,"G03630"],[20,22,"G03630"],[23,32,"G03630"],[33,36,"G47710"],[37,39,"G03290"],[40,48,"G03290"],[49,52,"G35880"],[53,57,"G54860"],[58,60,"G23160"],[61,64,"G23160"],[65,69,"G37390"],[70,72,"G15100"],[73,75,"G17220"],[76,79,"G47710"],[80,87,"G12230"],[88,91,"G35880"],[92,98,"G19360"],[99,101,"G19360"],[102,104,"G54950"],[105,107,"G14730"],[108,113,"G54950"]]}},{"n":7,"text":"For God did not give us a spirit of cowardice, but of power and of love and of self-control.","sp":{"w":[[0,3,"G10630"],[4,7,"G23160"],[8,11,"G13250"],[12,15,"G37560"],[16,20,"G13250"],[21,23,"G14730"],[24,25,"G41510"],[26,32,"G41510"],[33,35,"G11670"],[36,45,"G11670"],[47,50,"G02350"],[51,53,"G14110"],[54,59,"G14110"],[60,63,"G25320"],[64,66,"G00260"],[67,71,"G00260"],[72,75,"G25320"],[76,78,"G49950"],[79,83,"G49950"],[84,91,"G49950"]]}},{"n":8,"text":"Therefore, do not be ashamed of the testimony of our Lord, nor of me, his prisoner, but suffer together for the gospel, according to the power of God,","sp":{"w":[[0,9,"G37670"],[11,13,"G18700"],[14,17,"G33610"],[18,20,"G18700"],[21,28,"G18700"],[29,31,"G18700"],[32,35,"G35880"],[36,45,"G31420"],[46,48,"G29620"],[49,52,"G14730"],[53,57,"G29620"],[59,62,"G33660"],[63,65,"G14730"],[66,68,"G14730"],[70,73,"G08460"],[74,82,"G11980"],[84,87,"G02350"],[88,94,"G47770"],[95,103,"G47770"],[104,107,"G20980"],[108,111,"G20980"],[112,118,"G20980"],[120,129,"G25960"],[130,132,"G25960"],[133,136,"G14110"],[137,142,"G14110"],[143,145,"G23160"],[146,149,"G23160"]]}},{"n":9,"text":"the one having saved us and having called {us} to a holy calling—not according to our works, but according to his own purpose and grace, the {grace} having been given to us in Christ Jesus before eternal times,","sp":{"w":[[0,3,"G35880"],[4,7,"G35880"],[8,14,"G49820"],[15,20,"G49820"],[21,23,"G14730"],[24,27,"G25320"],[28,34,"G25640"],[35,41,"G25640"],[43,45,"G25640"],[47,49,"G28210"],[50,51,"G28210"],[52,56,"G00400"],[57,64,"G28210"],[65,68,"G37560"],[69,78,"G25960"],[79,81,"G25960"],[82,85,"G14730"],[86,91,"G20410"],[93,96,"G02350"],[97,106,"G25960"],[107,109,"G25960"],[110,113,"G23980"],[114,117,"G23980"],[118,125,"G42860"],[126,129,"G25320"],[130,135,"G54850"],[137,140,"G35880"],[142,147,"G35880"],[149,155,"G13250"],[156,160,"G13250"],[161,166,"G13250"],[167,169,"G14730"],[170,172,"G14730"],[173,175,"G17220"],[176,182,"G55470"],[183,188,"G24240"],[189,195,"G42530"],[196,203,"G01660"],[204,209,"G55500"]]}},{"n":10,"text":"and now having been revealed through the appearance of our Savior Christ Jesus, both having abolished death and having brought to light life and immortality through the gospel,","sp":{"w":[[0,3,"G11610"],[4,7,"G35680"],[8,14,"G53190"],[15,19,"G53190"],[20,28,"G53190"],[29,36,"G12230"],[37,40,"G35880"],[41,51,"G20150"],[52,54,"G49900"],[55,58,"G14730"],[59,65,"G49900"],[66,72,"G55470"],[73,78,"G24240"],[80,84,"G33030"],[85,91,"G26730"],[92,101,"G26730"],[102,107,"G22880"],[108,111,"G11610"],[112,118,"G54610"],[119,126,"G54610"],[127,129,"G54610"],[130,135,"G54610"],[136,140,"G22220"],[141,144,"G25320"],[145,156,"G08610"],[157,164,"G12230"],[165,168,"G35880"],[169,175,"G20980"]]}},{"n":11,"text":"for which I was appointed a herald and an apostle and a teacher,","sp":{"w":[[0,3,"G15190"],[4,9,"G37390"],[10,11,"G14730"],[12,15,"G50870"],[16,25,"G50870"],[26,27,"G27830"],[28,34,"G27830"],[35,38,"G25320"],[39,41,"G06520"],[42,49,"G06520"],[50,53,"G25320"],[54,55,"G13200"],[56,63,"G13200"]]}},{"n":12,"text":"for which reason I also suffer these things. But I am not ashamed, for I know in whom I have believed, and I have been persuaded that he is able to guard my deposit until that day.","sp":{"w":[[0,3,"G12230"],[4,9,"G37390"],[10,16,"G01560"],[17,18,"G39580"],[19,23,"G25320"],[24,30,"G39580"],[31,36,"G37780"],[37,43,"G37780"],[45,48,"G02350"],[49,50,"G18700"],[51,53,"G18700"],[54,57,"G37560"],[58,65,"G18700"],[67,70,"G10630"],[71,72,"G14920"],[73,77,"G14920"],[78,80,"G37390"],[81,85,"G37390"],[86,87,"G41000"],[88,92,"G41000"],[93,101,"G41000"],[103,106,"G25320"],[107,108,"G39820"],[109,113,"G39820"],[114,118,"G39820"],[119,128,"G39820"],[129,133,"G37540"],[134,136,"G15100"],[137,139,"G15100"],[140,144,"G14150"],[145,147,"G54420"],[148,153,"G54420"],[154,156,"G14730"],[157,164,"G38660"],[165,170,"G15190"],[171,175,"G15650"],[176,179,"G22500"]]}},{"n":13,"text":"Hold the pattern of healthy words that you heard from me, in faith and love {that are} in Christ Jesus.","br":1,"sp":{"w":[[0,4,"G21920"],[5,8,"G52960"],[9,16,"G52960"],[17,19,"G30560"],[20,27,"G51980"],[28,33,"G30560"],[34,38,"G37390"],[39,42,"G01910"],[43,48,"G01910"],[49,53,"G38440"],[54,56,"G14730"],[58,60,"G17220"],[61,66,"G41020"],[67,70,"G25320"],[71,75,"G00260"],[77,81,"G35880"],[82,85,"G35880"],[87,89,"G17220"],[90,96,"G55470"],[97,102,"G24240"]]}},{"n":14,"text":"Guard the good deposit through the Holy Spirit, the one dwelling in us.","sp":{"w":[[0,5,"G54420"],[6,9,"G35880"],[10,14,"G25700"],[15,22,"G38660"],[23,30,"G12230"],[31,34,"G41510"],[35,39,"G00400"],[40,46,"G41510"],[48,51,"G35880"],[52,55,"G35880"],[56,64,"G17740"],[65,67,"G17220"],[68,70,"G14730"]]}},{"n":15,"text":"You know this, that all the ones in Asia turned away from me, among whom are Phygelus and Hermogenes.","br":1,"sp":{"w":[[0,3,"G14920"],[4,8,"G14920"],[9,13,"G37780"],[15,19,"G37540"],[20,23,"G39560"],[24,27,"G35880"],[28,32,"G35880"],[33,35,"G17220"],[36,40,"G07730"],[41,47,"G06540"],[48,52,"G06540"],[53,57,"G06540"],[58,60,"G14730"],[62,67,"G37390"],[68,72,"G37390"],[73,76,"G15100"],[77,85,"G54360"],[86,89,"G25320"],[90,100,"G20610"]]}},{"n":16,"text":"May the Lord give mercy to the household of Onesiphorus, because he often refreshed me and was not ashamed of my chain,","br":1,"sp":{"w":[[0,3,"G13250"],[4,7,"G35880"],[8,12,"G29620"],[13,17,"G13250"],[18,23,"G16560"],[24,26,"G36240"],[27,30,"G36240"],[31,40,"G36240"],[41,43,"G36830"],[44,55,"G36830"],[57,64,"G37540"],[65,67,"G04040"],[68,73,"G41780"],[74,83,"G04040"],[84,86,"G14730"],[87,90,"G25320"],[91,94,"G18700"],[95,98,"G37560"],[99,106,"G18700"],[107,109,"G18700"],[110,112,"G14730"],[113,118,"G02540"]]}},{"n":17,"text":"but being in Rome, he diligently searched for me and found {me}.","sp":{"w":[[0,3,"G02350"],[4,9,"G10960"],[10,12,"G17220"],[13,17,"G45160"],[19,21,"G22120"],[22,32,"G47090"],[33,41,"G22120"],[42,45,"G22120"],[46,48,"G14730"],[49,52,"G25320"],[53,58,"G21470"],[60,62,"G21470"]]}},{"n":18,"text":"May the Lord give to him to find mercy from the Lord in that day. And as much as he served in Ephesus, you know very well.","sp":{"w":[[0,3,"G13250"],[4,7,"G35880"],[8,12,"G29620"],[13,17,"G13250"],[18,20,"G08460"],[21,24,"G08460"],[25,27,"G21470"],[28,32,"G21470"],[33,38,"G16560"],[39,43,"G38440"],[44,47,"G29620"],[48,52,"G29620"],[53,55,"G17220"],[56,60,"G15650"],[61,64,"G22500"],[66,69,"G25320"],[70,72,"G37450"],[73,77,"G37450"],[78,80,"G37450"],[81,83,"G12470"],[84,90,"G12470"],[91,93,"G17220"],[94,101,"G21810"],[103,106,"G47710"],[107,111,"G10970"],[112,116,"G09570"],[117,121,"G09570"]]}}]},{"n":2,"verses":[{"n":1,"text":"You, therefore, my child, be strengthened in the grace {that is} in Christ Jesus.","br":1,"sp":{"w":[[0,3,"G47710"],[5,14,"G37670"],[16,18,"G14730"],[19,24,"G50430"],[26,28,"G17430"],[29,41,"G17430"],[42,44,"G17220"],[45,48,"G35880"],[49,54,"G54850"],[56,60,"G35880"],[61,63,"G35880"],[65,67,"G17220"],[68,74,"G55470"],[75,80,"G24240"]]}},{"n":2,"text":"And what you have heard from me through many witnesses, place these things before faithful men who will be able to teach others also.","sp":{"w":[[0,3,"G25320"],[4,8,"G37390"],[9,12,"G01910"],[13,17,"G01910"],[18,23,"G01910"],[24,28,"G38440"],[29,31,"G14730"],[32,39,"G12230"],[40,44,"G41830"],[45,54,"G31440"],[56,61,"G39080"],[62,67,"G37780"],[68,74,"G37780"],[75,81,"G39080"],[82,90,"G41030"],[91,94,"G04440"],[95,98,"G37480"],[99,103,"G15100"],[104,106,"G15100"],[107,111,"G24250"],[112,114,"G13210"],[115,120,"G13210"],[121,127,"G20870"],[128,132,"G25320"]]}},{"n":3,"text":"Suffer together as a good soldier of Jesus Christ.","sp":{"w":[[0,6,"G47770"],[7,15,"G47770"],[16,18,"G56130"],[19,20,"G47570"],[21,25,"G25700"],[26,33,"G47570"],[34,36,"G24240"],[37,42,"G24240"],[43,49,"G55470"]]}},{"n":4,"text":"No one serving as a soldier is entangled in the affairs of life, so that he may please the one having enlisted him.","sp":{"w":[[0,2,"G37620"],[3,6,"G37620"],[7,14,"G47540"],[15,17,"G47540"],[18,19,"G47540"],[20,27,"G47540"],[28,30,"G17070"],[31,40,"G17070"],[41,43,"G42300"],[44,47,"G42300"],[48,55,"G42300"],[56,58,"G09790"],[59,63,"G09790"],[65,67,"G24430"],[68,72,"G24430"],[73,75,"G07000"],[76,79,"G07000"],[80,86,"G07000"],[87,90,"G35880"],[91,94,"G35880"],[95,101,"G47580"],[102,110,"G47580"],[111,114,"G47580"]]}},{"n":5,"text":"But also, if anyone competes, he is not crowned if he has not competed lawfully.","sp":{"w":[[0,3,"G11610"],[4,8,"G25320"],[10,12,"G14370"],[13,19,"G51000"],[20,28,"G01180"],[30,32,"G47370"],[33,35,"G47370"],[36,39,"G37560"],[40,47,"G47370"],[48,50,"G14370"],[51,53,"G01180"],[54,57,"G01180"],[58,61,"G33610"],[62,70,"G01180"],[71,79,"G35450"]]}},{"n":6,"text":"It is necessary for the hardworking farmer first to share in the fruits.","sp":{"w":[[0,2,"G12100"],[3,5,"G12100"],[6,15,"G12100"],[16,19,"G10920"],[20,23,"G35880"],[24,35,"G28720"],[36,42,"G10920"],[43,48,"G44120"],[49,51,"G33350"],[52,57,"G33350"],[58,60,"G33350"],[61,64,"G35880"],[65,71,"G25900"]]}},{"n":7,"text":"Think about what I am saying, for the Lord will give you understanding in everything.","sp":{"w":[[0,5,"G35390"],[6,11,"G35390"],[12,16,"G37390"],[17,18,"G30040"],[19,21,"G30040"],[22,28,"G30040"],[30,33,"G10630"],[34,37,"G35880"],[38,42,"G29620"],[43,47,"G13250"],[48,52,"G13250"],[53,56,"G47710"],[57,70,"G49070"],[71,73,"G17220"],[74,84,"G39560"]]}},{"n":8,"text":"Remember Jesus Christ, having been raised from the dead, from the seed of David, according to my gospel,","br":1,"sp":{"w":[[0,8,"G34210"],[9,14,"G24240"],[15,21,"G55470"],[23,29,"G14530"],[30,34,"G14530"],[35,41,"G14530"],[42,46,"G15370"],[47,50,"G34980"],[51,55,"G34980"],[57,61,"G15370"],[62,65,"G46900"],[66,70,"G46900"],[71,73,"G11380"],[74,79,"G11380"],[81,90,"G25960"],[91,93,"G25960"],[94,96,"G14730"],[97,103,"G20980"]]}},{"n":9,"text":"in which I am suffering, even to chains, like a criminal. But the word of God has not been bound.","sp":{"w":[[0,2,"G17220"],[3,8,"G37390"],[9,10,"G25530"],[11,13,"G25530"],[14,23,"G25530"],[25,29,"G33600"],[30,32,"G33600"],[33,39,"G11990"],[41,45,"G56130"],[46,47,"G25570"],[48,56,"G25570"],[58,61,"G02350"],[62,65,"G35880"],[66,70,"G30560"],[71,73,"G23160"],[74,77,"G23160"],[78,81,"G12100"],[82,85,"G37560"],[86,90,"G12100"],[91,96,"G12100"]]}},{"n":10,"text":"Because of this, I endure all things because of the elect so that they also may obtain salvation {that is} in Christ Jesus, with eternal glory.","sp":{"w":[[0,7,"G12230"],[8,10,"G12230"],[11,15,"G37780"],[17,18,"G52780"],[19,25,"G52780"],[26,29,"G39560"],[30,36,"G39560"],[37,44,"G12230"],[45,47,"G12230"],[48,51,"G35880"],[52,57,"G15880"],[58,60,"G24430"],[61,65,"G24430"],[66,70,"G08460"],[71,75,"G25320"],[76,79,"G51770"],[80,86,"G51770"],[87,96,"G49910"],[98,102,"G35880"],[103,105,"G35880"],[107,109,"G17220"],[110,116,"G55470"],[117,122,"G24240"],[124,128,"G33260"],[129,136,"G01660"],[137,142,"G13910"]]}},{"n":11,"text":"The word {is} trustworthy: “For if we died with {him}, we will also live with {him}.","q":1,"br":1,"sp":{"w":[[0,3,"G35880"],[4,8,"G30560"],[10,12,"G41030"],[14,25,"G41030"],[28,31,"G10630"],[32,34,"G14870"],[35,37,"G48800"],[38,42,"G48800"],[43,47,"G48800"],[49,52,"G48800"],[55,57,"G48000"],[58,62,"G48000"],[63,67,"G25320"],[68,72,"G48000"],[73,77,"G48000"],[79,82,"G48000"]]}},{"n":12,"text":"If we endure, we will also reign with {him}. If we deny {him}, he also will deny us.","q":1,"sp":{"w":[[0,2,"G14870"],[3,5,"G52780"],[6,12,"G52780"],[14,16,"G48210"],[17,21,"G48210"],[22,26,"G25320"],[27,32,"G48210"],[33,37,"G48210"],[39,42,"G48210"],[45,47,"G14870"],[48,50,"G07200"],[51,55,"G07200"],[57,60,"G07200"],[63,65,"G25480"],[66,70,"G25480"],[71,75,"G07200"],[76,80,"G07200"],[81,83,"G14730"]]}},{"n":13,"text":"If we are unfaithful, he remains faithful, for he is not able to deny himself.”","q":1,"sp":{"w":[[0,2,"G14870"],[3,5,"G05690"],[6,9,"G05690"],[10,20,"G05690"],[22,24,"G15650"],[25,32,"G33060"],[33,41,"G41030"],[43,46,"G10630"],[47,49,"G14100"],[50,52,"G14100"],[53,56,"G37560"],[57,61,"G14100"],[62,64,"G07200"],[65,69,"G07200"],[70,77,"G14380"]]}},{"n":14,"text":"Remind {them} of these things, declaring before God not to battle about words; {it is} useful for nothing, to the destruction of the ones hearing.","br":1,"sp":{"w":[[0,6,"G52790"],[8,12,"G52790"],[14,16,"G52790"],[17,22,"G37780"],[23,29,"G37780"],[31,40,"G12630"],[41,47,"G17990"],[48,51,"G23160"],[52,55,"G33610"],[56,58,"G30540"],[59,65,"G30540"],[66,71,"G30540"],[72,77,"G30540"],[80,82,"G55390"],[83,85,"G55390"],[87,93,"G55390"],[94,97,"G19090"],[98,105,"G37620"],[107,109,"G19090"],[110,113,"G26920"],[114,125,"G26920"],[126,128,"G35880"],[129,132,"G35880"],[133,137,"G35880"],[138,145,"G01910"]]}},{"n":15,"text":"Strive to present yourself approved to God, a worker not ashamed, cutting the word of truth straight.","sp":{"w":[[0,6,"G47040"],[7,9,"G39360"],[10,17,"G39360"],[18,26,"G45720"],[27,35,"G13840"],[36,38,"G23160"],[39,42,"G23160"],[44,45,"G20400"],[46,52,"G20400"],[53,56,"G04220"],[57,64,"G04220"],[66,73,"G37180"],[74,77,"G35880"],[78,82,"G30560"],[83,85,"G02250"],[86,91,"G02250"],[92,100,"G37180"]]}},{"n":16,"text":"But avoid profane, empty sayings, for they will advance further in ungodliness,","sp":{"w":[[0,3,"G11610"],[4,9,"G40260"],[10,17,"G09520"],[19,24,"G27570"],[25,32,"G27570"],[34,37,"G10630"],[38,42,"G42980"],[43,47,"G42980"],[48,55,"G42980"],[56,63,"G41190"],[64,66,"G07630"],[67,78,"G07630"]]}},{"n":17,"text":"and their word will have a spreading like gangrene, among whom are Hymenaeus and Philetus,","sp":{"w":[[0,3,"G25320"],[4,9,"G08460"],[10,14,"G30560"],[15,19,"G21920"],[20,24,"G21920"],[25,26,"G35420"],[27,36,"G35420"],[37,41,"G56130"],[42,50,"G10440"],[52,57,"G37390"],[58,62,"G37390"],[63,66,"G15100"],[67,76,"G52110"],[77,80,"G25320"],[81,89,"G53720"]]}},{"n":18,"text":"who have missed the mark concerning the truth, saying the resurrection has already happened, and {who} overturn the faith of some.","sp":{"w":[[0,3,"G37480"],[4,8,"G07950"],[9,15,"G07950"],[16,19,"G07950"],[20,24,"G07950"],[25,35,"G40120"],[36,39,"G35880"],[40,45,"G02250"],[47,53,"G30040"],[54,57,"G03860"],[58,70,"G03860"],[71,74,"G10960"],[75,82,"G22350"],[83,91,"G10960"],[93,96,"G25320"],[98,101,"G03960"],[103,111,"G03960"],[112,115,"G35880"],[116,121,"G41020"],[122,124,"G51000"],[125,129,"G51000"]]}},{"n":19,"text":"Nevertheless, the firm foundation of God stands, having this seal: “The Lord knew the ones being his,” and “Let everyone naming the name of the Lord depart from unrighteousness.”","sp":{"w":[[0,12,"G33050"],[14,17,"G35880"],[18,22,"G47310"],[23,33,"G23100"],[34,36,"G23160"],[37,40,"G23160"],[41,47,"G24760"],[49,55,"G21920"],[56,60,"G37780"],[61,65,"G49730"],[68,71,"G29620"],[72,76,"G29620"],[77,81,"G10970"],[82,85,"G35880"],[86,90,"G35880"],[91,96,"G15100"],[97,100,"G08460"],[103,106,"G25320"],[108,111,"G08680"],[112,120,"G39560"],[121,127,"G36870"],[128,131,"G35880"],[132,136,"G36860"],[137,139,"G29620"],[140,143,"G29620"],[144,148,"G29620"],[149,155,"G08680"],[156,160,"G05750"],[161,176,"G00930"]]}},{"n":20,"text":"Now in a great house, there are not only gold and silver containers, but also wood and clay, and some for honor and some for dishonor.","br":1,"sp":{"w":[[0,3,"G11610"],[4,6,"G17220"],[7,8,"G36140"],[9,14,"G31730"],[15,20,"G36140"],[22,27,"G15100"],[28,31,"G15100"],[32,35,"G37560"],[36,40,"G34400"],[41,45,"G55520"],[46,49,"G25320"],[50,56,"G06930"],[57,67,"G46320"],[69,72,"G02350"],[73,77,"G25320"],[78,82,"G35850"],[83,86,"G25320"],[87,91,"G37490"],[93,96,"G25320"],[97,101,"G37390"],[102,105,"G15190"],[106,111,"G50920"],[112,115,"G11610"],[116,120,"G37390"],[121,124,"G15190"],[125,133,"G08190"]]}},{"n":21,"text":"Therefore, if someone has cleansed himself from these, he will be a container for honor, having been sanctified, useful to the master, having been prepared for every good work.","sp":{"w":[[0,9,"G37670"],[11,13,"G14370"],[14,21,"G51000"],[22,25,"G15710"],[26,34,"G15710"],[35,42,"G14380"],[43,47,"G05750"],[48,53,"G37780"],[55,57,"G15100"],[58,62,"G15100"],[63,65,"G15100"],[66,67,"G46320"],[68,77,"G46320"],[78,81,"G15190"],[82,87,"G50920"],[89,95,"G00370"],[96,100,"G00370"],[101,111,"G00370"],[113,119,"G21730"],[120,122,"G12030"],[123,126,"G35880"],[127,133,"G12030"],[135,141,"G20900"],[142,146,"G20900"],[147,155,"G20900"],[156,159,"G15190"],[160,165,"G39560"],[166,170,"G00180"],[171,175,"G20410"]]}},{"n":22,"text":"But flee youthful lusts, and pursue righteousness, faith, love, peace with the ones calling on the Lord from a pure heart.","br":1,"sp":{"w":[[0,3,"G11610"],[4,8,"G53430"],[9,17,"G35120"],[18,23,"G19390"],[25,28,"G11610"],[29,35,"G13770"],[36,49,"G13430"],[51,56,"G41020"],[58,62,"G00260"],[64,69,"G15150"],[70,74,"G33260"],[75,78,"G35880"],[79,83,"G35880"],[84,91,"G19410"],[92,94,"G19410"],[95,98,"G35880"],[99,103,"G29620"],[104,108,"G15370"],[109,110,"G25880"],[111,115,"G25130"],[116,121,"G25880"]]}},{"n":23,"text":"But reject foolish and ignorant controversies, knowing that they give birth to battles.","sp":{"w":[[0,3,"G11610"],[4,10,"G38680"],[11,18,"G34740"],[19,22,"G25320"],[23,31,"G05210"],[32,45,"G22140"],[47,54,"G14920"],[55,59,"G37540"],[60,64,"G10800"],[65,69,"G10800"],[70,75,"G10800"],[76,78,"G10800"],[79,86,"G31630"]]}},{"n":24,"text":"But it is necessary for a slave of the Lord not to battle, but to be gentle toward all, able to teach, patient,","sp":{"w":[[0,3,"G11610"],[4,6,"G12100"],[7,9,"G12100"],[10,19,"G12100"],[20,23,"G14010"],[24,25,"G14010"],[26,31,"G14010"],[32,34,"G29620"],[35,38,"G29620"],[39,43,"G29620"],[44,47,"G37560"],[48,50,"G31640"],[51,57,"G31640"],[59,62,"G02350"],[63,65,"G15100"],[66,68,"G15100"],[69,75,"G22610"],[76,82,"G43140"],[83,86,"G39560"],[88,92,"G13170"],[93,95,"G13170"],[96,101,"G13170"],[103,110,"G04200"]]}},{"n":25,"text":"in meekness educating the ones opposing. God may perhaps give them repentance for knowledge of the truth,","sp":{"w":[[0,2,"G17220"],[3,11,"G42400"],[12,21,"G38110"],[22,25,"G35880"],[26,30,"G35880"],[31,39,"G04750"],[41,44,"G23160"],[45,48,"G13250"],[49,56,"G33790"],[57,61,"G13250"],[62,66,"G08460"],[67,77,"G33410"],[78,81,"G15190"],[82,91,"G19220"],[92,94,"G02250"],[95,98,"G02250"],[99,104,"G02250"]]}},{"n":26,"text":"and they may become sober again from the trap of the devil, having been captured by him for the will of that one.","sp":{"w":[[0,3,"G25320"],[4,8,"G03660"],[9,12,"G03660"],[13,19,"G03660"],[20,25,"G03660"],[26,31,"G03660"],[32,36,"G15370"],[37,40,"G35880"],[41,45,"G38030"],[46,48,"G12280"],[49,52,"G12280"],[53,58,"G12280"],[60,66,"G22210"],[67,71,"G22210"],[72,80,"G22210"],[81,83,"G52590"],[84,87,"G08460"],[88,91,"G15190"],[92,95,"G35880"],[96,100,"G23070"],[101,103,"G15650"],[104,108,"G15650"],[109,112,"G15650"]]}}]},{"n":3,"verses":[{"n":1,"text":"But know this, that in the last days difficult times will be present.","br":1,"sp":{"w":[[0,3,"G11610"],[4,8,"G10970"],[9,13,"G37780"],[15,19,"G37540"],[20,22,"G17220"],[23,26,"G22500"],[27,31,"G20780"],[32,36,"G22500"],[37,46,"G54670"],[47,52,"G25400"],[53,57,"G17640"],[58,60,"G17640"],[61,68,"G17640"]]}},{"n":2,"text":"For the men will be lovers of self, lovers of money, boastful, proud, blasphemous, disobedient to parents, ungrateful, unholy,","sp":{"w":[[0,3,"G10630"],[4,7,"G35880"],[8,11,"G04440"],[12,16,"G15100"],[17,19,"G15100"],[20,26,"G53670"],[27,29,"G53670"],[30,34,"G53670"],[36,42,"G53660"],[43,45,"G53660"],[46,51,"G53660"],[53,61,"G02130"],[63,68,"G52440"],[70,81,"G09890"],[83,94,"G05450"],[95,97,"G11180"],[98,105,"G11180"],[107,117,"G08840"],[119,125,"G04620"]]}},{"n":3,"text":"unloving, irreconcilable, slanderous, unrestrained, savage, not lovers of the good,","sp":{"w":[[0,8,"G07940"],[10,24,"G07860"],[26,36,"G12280"],[38,50,"G01930"],[52,58,"G04340"],[60,63,"G08650"],[64,70,"G08650"],[71,73,"G08650"],[74,77,"G08650"],[78,82,"G08650"]]}},{"n":4,"text":"traitors, reckless, puffed up, lovers of pleasure rather than lovers of God,","sp":{"w":[[0,8,"G42730"],[10,18,"G43120"],[20,26,"G51870"],[27,29,"G51870"],[31,37,"G53690"],[38,40,"G53690"],[41,49,"G53690"],[50,56,"G31230"],[57,61,"G22280"],[62,68,"G53770"],[69,71,"G53770"],[72,75,"G53770"]]}},{"n":5,"text":"having a form of godliness, but denying its power. And turn away from these.","sp":{"w":[[0,6,"G21920"],[7,8,"G34460"],[9,13,"G34460"],[14,16,"G21500"],[17,26,"G21500"],[28,31,"G11610"],[32,39,"G07200"],[40,43,"G08460"],[44,49,"G14110"],[51,54,"G25320"],[55,59,"G06650"],[60,64,"G06650"],[65,69,"G06650"],[70,75,"G37780"]]}},{"n":6,"text":"For from these are the ones entering into households and taking captive little women having been heaped with sins, being led away by various desires,","br":1,"sp":{"w":[[0,3,"G10630"],[4,8,"G15370"],[9,14,"G37780"],[15,18,"G15100"],[19,22,"G35880"],[23,27,"G35880"],[28,36,"G17440"],[37,41,"G15190"],[42,52,"G36140"],[53,56,"G25320"],[57,63,"G01630"],[64,71,"G01630"],[72,78,"G11330"],[79,84,"G11330"],[85,91,"G49870"],[92,96,"G49870"],[97,103,"G49870"],[104,108,"G02660"],[109,113,"G02660"],[115,120,"G00710"],[121,124,"G00710"],[125,129,"G00710"],[130,132,"G19390"],[133,140,"G41640"],[141,148,"G19390"]]}},{"n":7,"text":"always learning, and never being able to come to knowledge of the truth.","sp":{"w":[[0,6,"G38420"],[7,15,"G31290"],[17,20,"G25320"],[21,26,"G33680"],[27,32,"G14100"],[33,37,"G14100"],[38,40,"G20640"],[41,45,"G20640"],[46,48,"G15190"],[49,58,"G19220"],[59,61,"G02250"],[62,65,"G02250"],[66,71,"G02250"]]}},{"n":8,"text":"And the way Jannes and Jambres opposed Moses, so also these oppose the truth, men having been corrupted {in} the mind, unapproved concerning the faith.","sp":{"w":[[0,3,"G11610"],[4,7,"G51580"],[8,11,"G51580"],[12,18,"G23890"],[19,22,"G25320"],[23,30,"G23870"],[31,38,"G04360"],[39,44,"G34750"],[46,48,"G37790"],[49,53,"G25320"],[54,59,"G37780"],[60,66,"G04360"],[67,70,"G35880"],[71,76,"G02250"],[78,81,"G04440"],[82,88,"G27040"],[89,93,"G27040"],[94,103,"G27040"],[105,107,"G35630"],[109,112,"G35880"],[113,117,"G35630"],[119,129,"G00960"],[130,140,"G40120"],[141,144,"G35880"],[145,150,"G41020"]]}},{"n":9,"text":"But they will not advance further, for their foolishness will be obvious to all, as also that of those became.","sp":{"w":[[0,3,"G02350"],[4,8,"G42980"],[9,13,"G42980"],[14,17,"G37560"],[18,25,"G42980"],[26,33,"G41175"],[35,38,"G10630"],[39,44,"G08460"],[45,56,"G04540"],[57,61,"G15100"],[62,64,"G15100"],[65,72,"G15520"],[73,75,"G39560"],[76,79,"G39560"],[81,83,"G56130"],[84,88,"G25320"],[89,93,"G35880"],[94,96,"G15650"],[97,102,"G15650"],[103,109,"G10960"]]}},{"n":10,"text":"But you have followed my teaching, conduct, purpose, faith, patience, love, endurance,","br":1,"sp":{"w":[[0,3,"G11610"],[4,7,"G47710"],[8,12,"G38770"],[13,21,"G38770"],[22,24,"G14730"],[25,33,"G13190"],[35,42,"G00720"],[44,51,"G42860"],[53,58,"G41020"],[60,68,"G31150"],[70,74,"G00260"],[76,85,"G52810"]]}},{"n":11,"text":"persecutions, sufferings, such as happened to me in Antioch, in Iconium, in Lystra, what kind of persecutions I endured. And the Lord rescued me from {them} all.","sp":{"w":[[0,12,"G13750"],[14,24,"G38040"],[26,30,"G36340"],[31,33,"G36340"],[34,42,"G10960"],[43,45,"G14730"],[46,48,"G14730"],[49,51,"G17220"],[52,59,"G04900"],[61,63,"G17220"],[64,71,"G24300"],[73,75,"G17220"],[76,82,"G30820"],[84,88,"G36340"],[89,93,"G36340"],[94,96,"G36340"],[97,109,"G13750"],[110,111,"G52970"],[112,119,"G52970"],[121,124,"G25320"],[125,128,"G35880"],[129,133,"G29620"],[134,141,"G45060"],[142,144,"G14730"],[145,149,"G15370"],[151,155,"G39560"],[157,160,"G39560"]]}},{"n":12,"text":"But also, all the ones wanting to live godly in Christ Jesus will be persecuted.","sp":{"w":[[0,3,"G11610"],[4,8,"G25320"],[10,13,"G39560"],[14,17,"G35880"],[18,22,"G35880"],[23,30,"G23090"],[31,33,"G21980"],[34,38,"G21980"],[39,44,"G21530"],[45,47,"G17220"],[48,54,"G55470"],[55,60,"G24240"],[61,65,"G13770"],[66,68,"G13770"],[69,79,"G13770"]]}},{"n":13,"text":"But evil men and impostors will advance to the worse, leading astray and being led astray.","sp":{"w":[[0,3,"G11610"],[4,8,"G41900"],[9,12,"G04440"],[13,16,"G25320"],[17,26,"G11140"],[27,31,"G42980"],[32,39,"G42980"],[40,42,"G19090"],[43,46,"G35880"],[47,52,"G55010"],[54,61,"G41050"],[62,68,"G41050"],[69,72,"G25320"],[73,78,"G41050"],[79,82,"G41050"],[83,89,"G41050"]]}},{"n":14,"text":"But you, remain in what you learned and were convinced of, knowing from whom you learned,","sp":{"w":[[0,3,"G11610"],[4,7,"G47710"],[9,15,"G33060"],[16,18,"G17220"],[19,23,"G37390"],[24,27,"G31290"],[28,35,"G31290"],[36,39,"G25320"],[40,44,"G41040"],[45,54,"G41040"],[55,57,"G41040"],[59,66,"G14920"],[67,71,"G38440"],[72,76,"G51010"],[77,80,"G31290"],[81,88,"G31290"]]}},{"n":15,"text":"and that from infancy you have known the sacred writings, which are able to make you wise for salvation through faith {that is} in Christ Jesus.","sp":{"w":[[0,3,"G25320"],[4,8,"G37540"],[9,13,"G05750"],[14,21,"G10250"],[22,25,"G14920"],[26,30,"G14920"],[31,36,"G14920"],[37,40,"G11210"],[41,47,"G24130"],[48,56,"G11210"],[58,63,"G35880"],[64,67,"G14100"],[68,72,"G14100"],[73,75,"G46790"],[76,80,"G46790"],[81,84,"G47710"],[85,89,"G46790"],[90,93,"G15190"],[94,103,"G49910"],[104,111,"G12230"],[112,117,"G41020"],[119,123,"G35880"],[124,126,"G35880"],[128,130,"G17220"],[131,137,"G55470"],[138,143,"G24240"]]}},{"n":16,"text":"All Scripture {is} God-breathed and {is} profitable for teaching, for reproof, for correction, for training in righteousness,","br":1,"sp":{"w":[[0,3,"G39560"],[4,13,"G11240"],[15,17,"G23150"],[19,22,"G23150"],[23,31,"G23150"],[32,35,"G25320"],[37,39,"G56240"],[41,51,"G56240"],[52,55,"G43140"],[56,64,"G13190"],[66,69,"G43140"],[70,77,"G16500"],[79,82,"G43140"],[83,93,"G18820"],[95,98,"G43140"],[99,107,"G38090"],[108,110,"G17220"],[111,124,"G13430"]]}},{"n":17,"text":"so that the man of God may be complete, having been equipped for every good work.","sp":{"w":[[0,2,"G24430"],[3,7,"G24430"],[8,11,"G35880"],[12,15,"G04440"],[16,18,"G23160"],[19,22,"G23160"],[23,26,"G15100"],[27,29,"G15100"],[30,38,"G07390"],[40,46,"G18220"],[47,51,"G18220"],[52,60,"G18220"],[61,64,"G43140"],[65,70,"G39560"],[71,75,"G00180"],[76,80,"G20410"]]}}]},{"n":4,"verses":[{"n":1,"text":"I declare before God and Christ Jesus, the one being about to judge living and dead, and by his appearing and his kingdom:","br":1,"sp":{"w":[[0,1,"G12630"],[2,9,"G12630"],[10,16,"G17990"],[17,20,"G23160"],[21,24,"G25320"],[25,31,"G55470"],[32,37,"G24240"],[39,42,"G35880"],[43,46,"G35880"],[47,52,"G31950"],[53,58,"G31950"],[59,61,"G29190"],[62,67,"G29190"],[68,74,"G21980"],[75,78,"G25320"],[79,83,"G34980"],[85,88,"G25320"],[89,91,"G20150"],[92,95,"G08460"],[96,105,"G20150"],[106,109,"G25320"],[110,113,"G08460"],[114,121,"G09320"]]}},{"n":2,"text":"Preach the word; stand by opportunely, inopportunely; reprove, rebuke, exhort, with all patience and teaching.","sp":{"w":[[0,6,"G27840"],[7,10,"G35880"],[11,15,"G30560"],[17,22,"G21860"],[23,25,"G21860"],[26,37,"G21220"],[39,52,"G01710"],[54,61,"G16510"],[63,69,"G20080"],[71,77,"G38700"],[79,83,"G17220"],[84,87,"G39560"],[88,96,"G31150"],[97,100,"G25320"],[101,109,"G13220"]]}},{"n":3,"text":"For there will be a time when they will not bear with the healthy teaching. Instead, they will heap up for themselves teachers according to their own desires, itching {in} the ear,","sp":{"w":[[0,3,"G10630"],[4,9,"G15100"],[10,14,"G15100"],[15,17,"G15100"],[18,19,"G25400"],[20,24,"G25400"],[25,29,"G37530"],[30,34,"G04300"],[35,39,"G04300"],[40,43,"G37560"],[44,48,"G04300"],[49,53,"G04300"],[54,57,"G35880"],[58,65,"G51980"],[66,74,"G13190"],[76,83,"G02350"],[85,89,"G20020"],[90,94,"G20020"],[95,99,"G20020"],[100,102,"G20020"],[103,106,"G14380"],[107,117,"G14380"],[118,126,"G13200"],[127,136,"G25960"],[137,139,"G25960"],[140,145,"G35880"],[146,149,"G23980"],[150,157,"G19390"],[159,166,"G28330"],[168,170,"G01890"],[172,175,"G35880"],[176,179,"G01890"]]}},{"n":4,"text":"and they will turn the ear away from the truth and be turned away to the myths.","sp":{"w":[[0,3,"G25320"],[4,8,"G06540"],[9,13,"G06540"],[14,18,"G06540"],[19,22,"G35880"],[23,26,"G01890"],[27,31,"G06540"],[32,36,"G05750"],[37,40,"G35880"],[41,46,"G02250"],[47,50,"G11610"],[51,53,"G16240"],[54,60,"G16240"],[61,65,"G16240"],[66,68,"G19090"],[69,72,"G35880"],[73,78,"G34540"]]}},{"n":5,"text":"But you, be sober in all things. Suffer hardship. Do the work of an evangelist. Fulfill your service.","sp":{"w":[[0,3,"G11610"],[4,7,"G47710"],[9,11,"G35250"],[12,17,"G35250"],[18,20,"G17220"],[21,24,"G39560"],[25,31,"G39560"],[33,39,"G25530"],[40,48,"G25530"],[50,52,"G41600"],[53,56,"G20410"],[57,61,"G20410"],[62,64,"G20990"],[65,67,"G20990"],[68,78,"G20990"],[80,87,"G41350"],[88,92,"G47710"],[93,100,"G12480"]]}},{"n":6,"text":"For I am already being poured out as an offering, and the time of my departure is near.","br":1,"sp":{"w":[[0,3,"G10630"],[4,5,"G14730"],[6,8,"G46890"],[9,16,"G22350"],[17,22,"G46890"],[23,29,"G46890"],[30,33,"G46890"],[34,36,"G46890"],[37,39,"G46890"],[40,48,"G46890"],[50,53,"G25320"],[54,57,"G35880"],[58,62,"G25400"],[63,65,"G03590"],[66,68,"G14730"],[69,78,"G03590"],[79,81,"G21860"],[82,86,"G21860"]]}},{"n":7,"text":"I have fought the good fight; I have finished the race; I have kept the faith.","sp":{"w":[[0,1,"G00750"],[2,6,"G00750"],[7,13,"G00750"],[14,17,"G35880"],[18,22,"G25700"],[23,28,"G00730"],[30,31,"G50550"],[32,36,"G50550"],[37,45,"G50550"],[46,49,"G35880"],[50,54,"G14080"],[56,57,"G50830"],[58,62,"G50830"],[63,67,"G50830"],[68,71,"G35880"],[72,77,"G41020"]]}},{"n":8,"text":"From now on, the crown of righteousness is reserved for me, which the Lord, the righteous judge, will give to me on that day, and not only to me, but also to all the ones having loved his appearing.","sp":{"w":[[0,4,"G30630"],[5,8,"G30630"],[9,11,"G30630"],[13,16,"G35880"],[17,22,"G47350"],[23,25,"G13430"],[26,39,"G13430"],[40,42,"G06060"],[43,51,"G06060"],[52,55,"G14730"],[56,58,"G14730"],[60,65,"G37390"],[66,69,"G35880"],[70,74,"G29620"],[76,79,"G35880"],[80,89,"G13420"],[90,95,"G29230"],[97,101,"G05910"],[102,106,"G05910"],[107,109,"G14730"],[110,112,"G14730"],[113,115,"G17220"],[116,120,"G15650"],[121,124,"G22500"],[126,129,"G11610"],[130,133,"G37560"],[134,138,"G34400"],[139,141,"G14730"],[142,144,"G14730"],[146,149,"G02350"],[150,154,"G25320"],[155,157,"G35880"],[158,161,"G39560"],[162,165,"G35880"],[166,170,"G35880"],[171,177,"G00250"],[178,183,"G00250"],[184,187,"G08460"],[188,197,"G20150"]]}},{"n":9,"text":"Strive to come to me quickly,","br":1,"sp":{"w":[[0,6,"G47040"],[7,9,"G20640"],[10,14,"G20640"],[15,17,"G43140"],[18,20,"G14730"],[21,28,"G50300"]]}},{"n":10,"text":"for Demas has forsaken me, having loved the present age, and has gone to Thessalonica, Crescens to Galatia, Titus to Dalmatia.","sp":{"w":[[0,3,"G10630"],[4,9,"G12140"],[10,13,"G14590"],[14,22,"G14590"],[23,25,"G14730"],[27,33,"G00250"],[34,39,"G00250"],[40,43,"G35880"],[44,51,"G35680"],[52,55,"G01650"],[57,60,"G25320"],[61,64,"G41980"],[65,69,"G41980"],[70,72,"G15190"],[73,85,"G23320"],[87,95,"G29130"],[96,98,"G15190"],[99,106,"G10530"],[108,113,"G51030"],[114,116,"G15190"],[117,125,"G11490"]]}},{"n":11,"text":"Only Luke is with me. Taking Mark, bring {him} with you, for he is useful to me for service.","sp":{"w":[[0,4,"G34410"],[5,9,"G30650"],[10,12,"G15100"],[13,17,"G33260"],[18,20,"G14730"],[22,28,"G03530"],[29,33,"G31380"],[35,40,"G00710"],[42,45,"G00710"],[47,51,"G33260"],[52,55,"G45720"],[57,60,"G10630"],[61,63,"G15100"],[64,66,"G15100"],[67,73,"G21730"],[74,76,"G14730"],[77,79,"G14730"],[80,83,"G15190"],[84,91,"G12480"]]}},{"n":12,"text":"But I sent Tychicus to Ephesus.","sp":{"w":[[0,3,"G11610"],[4,5,"G06490"],[6,10,"G06490"],[11,19,"G51900"],[20,22,"G15190"],[23,30,"G21810"]]}},{"n":13,"text":"The cloak that I left at Troas with Carpus, coming, bring, and the scrolls, especially the parchments.","sp":{"w":[[0,3,"G35880"],[4,9,"G53410"],[10,14,"G37390"],[15,16,"G06200"],[17,21,"G06200"],[22,24,"G17220"],[25,30,"G51740"],[31,35,"G38440"],[36,42,"G25910"],[44,50,"G20640"],[52,57,"G53420"],[59,62,"G25320"],[63,66,"G35880"],[67,74,"G09750"],[76,86,"G31220"],[87,90,"G35880"],[91,101,"G32000"]]}},{"n":14,"text":"Alexander the coppersmith showed many evils to me. The Lord will repay him according to his works,","br":1,"sp":{"w":[[0,9,"G02230"],[10,13,"G35880"],[14,25,"G54710"],[26,32,"G17310"],[33,37,"G41830"],[38,43,"G25560"],[44,46,"G14730"],[47,49,"G14730"],[51,54,"G35880"],[55,59,"G29620"],[60,64,"G05910"],[65,70,"G05910"],[71,74,"G08460"],[75,84,"G25960"],[85,87,"G25960"],[88,91,"G08460"],[92,97,"G20410"]]}},{"n":15,"text":"whom you also guard yourself against, for he opposed our words very much.","sp":{"w":[[0,4,"G37390"],[5,8,"G47710"],[9,13,"G25320"],[14,19,"G54420"],[20,28,"G54420"],[29,36,"G54420"],[38,41,"G10630"],[42,44,"G04360"],[45,52,"G04360"],[53,56,"G22510"],[57,62,"G30560"],[63,67,"G30290"],[68,72,"G30290"]]}},{"n":16,"text":"At my first defense, no one appeared with me, but all forsook me. May it not be reckoned against them.","br":1,"sp":{"w":[[0,2,"G17220"],[3,5,"G14730"],[6,11,"G44130"],[12,19,"G06270"],[21,23,"G37620"],[24,27,"G37620"],[28,36,"G38540"],[37,41,"G14730"],[42,44,"G14730"],[46,49,"G02350"],[50,53,"G39560"],[54,61,"G14590"],[62,64,"G14730"],[66,69,"G30490"],[70,72,"G30490"],[73,76,"G33610"],[77,79,"G30490"],[80,88,"G30490"],[89,96,"G08460"],[97,101,"G08460"]]}},{"n":17,"text":"But the Lord stood with me and strengthened me, so that through me the proclamation might be fulfilled and all the Gentiles might hear. And I was rescued out of the mouth of the lion.","sp":{"w":[[0,3,"G11610"],[4,7,"G35880"],[8,12,"G29620"],[13,18,"G39360"],[19,23,"G39360"],[24,26,"G14730"],[27,30,"G25320"],[31,43,"G17430"],[44,46,"G14730"],[48,50,"G24430"],[51,55,"G24430"],[56,63,"G12230"],[64,66,"G14730"],[67,70,"G35880"],[71,83,"G27820"],[84,89,"G41350"],[90,92,"G41350"],[93,102,"G41350"],[103,106,"G25320"],[107,110,"G39560"],[111,114,"G35880"],[115,123,"G14840"],[124,129,"G01910"],[130,134,"G01910"],[136,139,"G25320"],[140,141,"G45060"],[142,145,"G45060"],[146,153,"G45060"],[154,157,"G15370"],[158,160,"G15370"],[161,164,"G47500"],[165,170,"G47500"],[171,173,"G30230"],[174,177,"G30230"],[178,182,"G30230"]]}},{"n":18,"text":"The Lord will rescue me from every evil work and will save {me} for his heavenly kingdom. To him {be} the glory forever {and} ever. Amen.","sp":{"w":[[0,3,"G35880"],[4,8,"G29620"],[9,13,"G45060"],[14,20,"G45060"],[21,23,"G14730"],[24,28,"G05750"],[29,34,"G39560"],[35,39,"G41900"],[40,44,"G20410"],[45,48,"G25320"],[49,53,"G49820"],[54,58,"G49820"],[60,62,"G49820"],[64,67,"G15190"],[68,71,"G08460"],[72,80,"G20320"],[81,88,"G09320"],[90,92,"G37390"],[93,96,"G37390"],[98,100,"G13910"],[102,105,"G35880"],[106,111,"G13910"],[112,119,"G01650"],[121,124,"G01650"],[126,130,"G01650"],[132,136,"G02810"]]}},{"n":19,"text":"Greet Prisca and Aquila, and the household of Onesiphorus.","br":1,"sp":{"w":[[0,5,"G07820"],[6,12,"G42510"],[13,16,"G25320"],[17,23,"G02070"],[25,28,"G25320"],[29,32,"G35880"],[33,42,"G36240"],[43,45,"G36830"],[46,57,"G36830"]]}},{"n":20,"text":"Erastus remained in Corinth, and Trophimus I left in Miletus, being sick.","sp":{"w":[[0,7,"G20370"],[8,16,"G33060"],[17,19,"G17220"],[20,27,"G28820"],[29,32,"G11610"],[33,42,"G51610"],[43,44,"G06200"],[45,49,"G06200"],[50,52,"G17220"],[53,60,"G33990"],[62,67,"G07700"],[68,72,"G07700"]]}},{"n":21,"text":"Strive to come before winter. Eubulus greets you, and Pudens and Linus and Claudia and the brothers.","sp":{"w":[[0,6,"G47040"],[7,9,"G20640"],[10,14,"G20640"],[15,21,"G42530"],[22,28,"G54940"],[30,37,"G21030"],[38,44,"G07820"],[45,48,"G47710"],[50,53,"G25320"],[54,60,"G42270"],[61,64,"G25320"],[65,70,"G30440"],[71,74,"G25320"],[75,82,"G28030"],[83,86,"G25320"],[87,90,"G35880"],[91,99,"G00800"]]}},{"n":22,"text":"The Lord {be} with your spirit. Grace {be} with you.","br":1,"sp":{"w":[[0,3,"G35880"],[4,8,"G29620"],[10,12,"G33260"],[14,18,"G33260"],[19,23,"G47710"],[24,30,"G41510"],[32,37,"G54850"],[39,41,"G33260"],[43,47,"G33260"],[48,51,"G47710"]]}}]}]}
