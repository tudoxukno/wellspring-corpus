,97,"G43140"],[98,105,"G51000"],[106,110,"G51000"],[112,116,"G25310"],[117,119,"G25310"],[120,124,"G25320"],[125,128,"G35880"],[129,133,"G29620"],[134,141,"G54830"],[142,145,"G47710"],[147,149,"G37790"],[150,154,"G25320"],[155,161,"G47710"],[162,165,"G47710"]]}},{"n":14,"text":"But above all these things, love, which is the bond of perfection.","sp":{"w":[[0,3,"G11610"],[4,9,"G19090"],[10,13,"G39560"],[14,19,"G37780"],[20,26,"G37780"],[28,32,"G00260"],[34,39,"G37390"],[40,42,"G15100"],[43,46,"G48860"],[47,51,"G48860"],[52,54,"G50470"],[55,65,"G50470"]]}},{"n":15,"text":"And let the peace of Christ rule in your hearts, to which also you were called in one body, and become thankful.","sp":{"w":[[0,3,"G25320"],[4,7,"G10180"],[8,11,"G35880"],[12,17,"G15150"],[18,20,"G55470"],[21,27,"G55470"],[28,32,"G10180"],[33,35,"G17220"],[36,40,"G47710"],[41,47,"G25880"],[49,51,"G15190"],[52,57,"G37390"],[58,62,"G25320"],[63,66,"G25640"],[67,71,"G25640"],[72,78,"G25640"],[79,81,"G17220"],[82,85,"G15200"],[86,90,"G49830"],[92,95,"G25320"],[96,102,"G10960"],[103,111,"G21700"]]}},{"n":16,"text":"Let the word of Christ dwell in you richly, in all wisdom teaching and admonishing one another with psalms, hymns, {and} spiritual songs, singing with thankfulness in your hearts to God.","sp":{"w":[[0,3,"G17740"],[4,7,"G35880"],[8,12,"G30560"],[13,15,"G55470"],[16,22,"G55470"],[23,28,"G17740"],[29,31,"G17220"],[32,35,"G47710"],[36,42,"G41460"],[44,46,"G17220"],[47,50,"G39560"],[51,57,"G46780"],[58,66,"G13210"],[67,70,"G25320"],[71,82,"G35600"],[83,86,"G14380"],[87,94,"G14380"],[95,99,"G55680"],[100,106,"G55680"],[108,113,"G52150"],[116,119,"G56030"],[121,130,"G41520"],[131,136,"G56030"],[138,145,"G01030"],[146,150,"G17220"],[151,163,"G54850"],[164,166,"G17220"],[167,171,"G47710"],[172,178,"G25880"],[179,181,"G23160"],[182,185,"G23160"]]}},{"n":17,"text":"And everything, whatever you might do in word or in deed, do all in the name of the Lord Jesus, giving thanks to God the Father through him.","sp":{"w":[[0,3,"G25320"],[4,14,"G39560"],[16,24,"G14370"],[25,28,"G41600"],[29,34,"G41600"],[35,37,"G41600"],[38,40,"G17220"],[41,45,"G30560"],[46,48,"G22280"],[49,51,"G17220"],[52,56,"G20410"],[58,60,"G39560"],[61,64,"G39560"],[65,67,"G17220"],[68,71,"G36860"],[72,76,"G36860"],[77,79,"G29620"],[80,83,"G29620"],[84,88,"G29620"],[89,94,"G24240"],[96,102,"G21680"],[103,109,"G21680"],[110,112,"G23160"],[113,116,"G23160"],[117,120,"G39620"],[121,127,"G39620"],[128,135,"G12230"],[136,139,"G08460"]]}},{"n":18,"text":"Wives, be subjected to your husbands, as is fitting in the Lord.","br":1,"sp":{"w":[[0,5,"G11350"],[7,9,"G52930"],[10,19,"G52930"],[20,22,"G04350"],[23,27,"G35880"],[28,36,"G04350"],[38,40,"G56130"],[41,43,"G04330"],[44,51,"G04330"],[52,54,"G17220"],[55,58,"G29620"],[59,63,"G29620"]]}},{"n":19,"text":"Husbands, love your wives, and do not be embittered against them.","sp":{"w":[[0,8,"G04350"],[10,14,"G00250"],[15,19,"G35880"],[20,25,"G11350"],[27,30,"G25320"],[31,33,"G40870"],[34,37,"G33610"],[38,40,"G40870"],[41,51,"G40870"],[52,59,"G43140"],[60,64,"G08460"]]}},{"n":20,"text":"Children, obey your parents in all things, for this is pleasing in the Lord.","sp":{"w":[[0,8,"G50430"],[10,14,"G52190"],[15,19,"G35880"],[20,27,"G11180"],[28,30,"G25960"],[31,34,"G39560"],[35,41,"G39560"],[43,46,"G10630"],[47,51,"G37780"],[52,54,"G15100"],[55,63,"G21010"],[64,66,"G17220"],[67,70,"G29620"],[71,75,"G29620"]]}},{"n":21,"text":"Fathers, do not provoke your children, so that they may not be discouraged.","sp":{"w":[[0,7,"G39620"],[9,11,"G20420"],[12,15,"G33610"],[16,23,"G20420"],[24,28,"G47710"],[29,37,"G50430"],[39,41,"G24430"],[42,46,"G24430"],[47,51,"G01200"],[52,55,"G01200"],[56,59,"G33610"],[60,62,"G01200"],[63,74,"G01200"]]}},{"n":22,"text":"Slaves, obey your masters according to the flesh in all things, not with eyeservice as people pleasers, but with sincerity of heart, fearing the Lord.","sp":{"w":[[0,6,"G14010"],[8,12,"G52190"],[13,17,"G35880"],[18,25,"G29620"],[26,35,"G25960"],[36,38,"G25960"],[39,42,"G45610"],[43,48,"G45610"],[49,51,"G25960"],[52,55,"G39560"],[56,62,"G39560"],[64,67,"G33610"],[68,72,"G17220"],[73,83,"G37870"],[84,86,"G56130"],[87,93,"G04410"],[94,102,"G04410"],[104,107,"G02350"],[108,112,"G17220"],[113,122,"G05720"],[123,125,"G25880"],[126,131,"G25880"],[133,140,"G53990"],[141,144,"G35880"],[145,149,"G29620"]]}},{"n":23,"text":"Whatever you might do, work from the soul as to the Lord and not to men,","sp":{"w":[[0,8,"G14370"],[9,12,"G41600"],[13,18,"G41600"],[19,21,"G41600"],[23,27,"G20380"],[28,32,"G15370"],[33,36,"G55900"],[37,41,"G55900"],[42,44,"G56130"],[45,47,"G29620"],[48,51,"G29620"],[52,56,"G29620"],[57,60,"G25320"],[61,64,"G37560"],[65,67,"G04440"],[68,71,"G04440"]]}},{"n":24,"text":"knowing that you will receive from the Lord the reward of the inheritance. You are serving the Lord Christ.","sp":{"w":[[0,7,"G14920"],[8,12,"G37540"],[13,16,"G06180"],[17,21,"G06180"],[22,29,"G06180"],[30,34,"G05750"],[35,38,"G29620"],[39,43,"G29620"],[44,47,"G35880"],[48,54,"G04690"],[55,57,"G28170"],[58,61,"G28170"],[62,73,"G28170"],[75,78,"G13980"],[79,82,"G13980"],[83,90,"G13980"],[91,94,"G35880"],[95,99,"G29620"],[100,106,"G55470"]]}},{"n":25,"text":"For the one doing unrighteousness will receive what he did unrighteously, and there is no favoritism.","sp":{"w":[[0,3,"G10630"],[4,7,"G35880"],[8,11,"G35880"],[12,17,"G00910"],[18,33,"G00910"],[34,38,"G28650"],[39,46,"G28650"],[47,51,"G37390"],[52,54,"G00910"],[55,58,"G00910"],[59,72,"G00910"],[74,77,"G25320"],[78,83,"G15100"],[84,86,"G15100"],[87,89,"G37560"],[90,100,"G43820"]]}}]},{"n":4,"verses":[{"n":1,"text":"Masters, give to your slaves {what is} right and fair, knowing that you also have a master in heaven.","br":1,"sp":{"w":[[0,7,"G29620"],[9,13,"G39300"],[14,16,"G14010"],[17,21,"G14010"],[22,28,"G14010"],[30,34,"G35880"],[35,37,"G35880"],[39,44,"G13420"],[45,48,"G25320"],[49,53,"G24710"],[55,62,"G14920"],[63,67,"G37540"],[68,71,"G47710"],[72,76,"G25320"],[77,81,"G21920"],[82,83,"G29620"],[84,90,"G29620"],[91,93,"G17220"],[94,100,"G37720"]]}},{"n":2,"text":"Continue steadfastly in prayer, staying alert in it in thanksgiving,","br":1,"sp":{"w":[[0,8,"G43420"],[9,20,"G43420"],[21,23,"G43350"],[24,30,"G43350"],[32,39,"G11270"],[40,45,"G11270"],[46,48,"G17220"],[49,51,"G08460"],[52,54,"G17220"],[55,67,"G21690"]]}},{"n":3,"text":"praying together for us also so that God may open a door to us for the word to speak the mystery of Christ, on account of which also I have been bound,","sp":{"w":[[0,7,"G43360"],[8,16,"G02600"],[17,20,"G40120"],[21,23,"G14730"],[24,28,"G25320"],[29,31,"G24430"],[32,36,"G24430"],[37,40,"G23160"],[41,44,"G04550"],[45,49,"G04550"],[50,51,"G23740"],[52,56,"G23740"],[57,59,"G14730"],[60,62,"G14730"],[63,66,"G30560"],[67,70,"G30560"],[71,75,"G30560"],[76,78,"G29800"],[79,84,"G29800"],[85,88,"G35880"],[89,96,"G34660"],[97,99,"G55470"],[100,106,"G55470"],[108,110,"G12230"],[111,118,"G12230"],[119,121,"G12230"],[122,127,"G37390"],[128,132,"G25320"],[133,134,"G12100"],[135,139,"G12100"],[140,144,"G12100"],[145,150,"G12100"]]}},{"n":4,"text":"in order that I may make it clear, as I ought to speak.","sp":{"w":[[0,2,"G24430"],[3,8,"G24430"],[9,13,"G24430"],[14,15,"G53190"],[16,19,"G53190"],[20,24,"G53190"],[25,27,"G08460"],[28,33,"G53190"],[35,37,"G56130"],[38,39,"G14730"],[40,45,"G12100"],[46,48,"G29800"],[49,54,"G29800"]]}},{"n":5,"text":"Walk in wisdom toward the ones outside, redeeming the time,","sp":{"w":[[0,4,"G40430"],[5,7,"G17220"],[8,14,"G46780"],[15,21,"G43140"],[22,25,"G35880"],[26,30,"G35880"],[31,38,"G18540"],[40,49,"G18050"],[50,53,"G35880"],[54,58,"G25400"]]}},{"n":6,"text":"your words always with grace, seasoned with salt, to know how it is necessary for you to answer each one.","sp":{"w":[[0,4,"G47710"],[5,10,"G30560"],[11,17,"G38420"],[18,22,"G17220"],[23,28,"G54850"],[30,38,"G07410"],[39,43,"G02170"],[44,48,"G02170"],[50,52,"G14920"],[53,57,"G14920"],[58,61,"G44590"],[62,64,"G12100"],[