"],[105,108,"G54790"]]}},{"n":12,"text":"giving thanks to the Father, the one having made you able to share the inheritance of the saints in the light.","sp":{"w":[[0,6,"G21680"],[7,13,"G21680"],[14,16,"G39620"],[17,20,"G39620"],[21,27,"G39620"],[29,32,"G35880"],[33,36,"G35880"],[37,43,"G24270"],[44,48,"G24270"],[49,52,"G47710"],[53,57,"G24270"],[58,60,"G33100"],[61,66,"G33100"],[67,70,"G35880"],[71,82,"G28190"],[83,85,"G00400"],[86,89,"G00400"],[90,96,"G00400"],[97,99,"G17220"],[100,103,"G35880"],[104,109,"G54570"]]}},{"n":13,"text":"He rescued us from the authority of the darkness and transferred {us} to the kingdom of his beloved Son,","sp":{"w":[[0,2,"G37390"],[3,10,"G45060"],[11,13,"G14730"],[14,18,"G15370"],[19,22,"G35880"],[23,32,"G18490"],[33,35,"G46550"],[36,39,"G46550"],[40,48,"G46550"],[49,52,"G25320"],[53,64,"G31790"],[66,68,"G31790"],[70,72,"G15190"],[73,76,"G35880"],[77,84,"G09320"],[85,87,"G52070"],[88,91,"G08460"],[92,99,"G00260"],[100,103,"G52070"]]}},{"n":14,"text":"in whom we have redemption, the forgiveness of sins.","sp":{"w":[[0,2,"G17220"],[3,7,"G37390"],[8,10,"G21920"],[11,15,"G21920"],[16,26,"G06290"],[28,31,"G35880"],[32,43,"G08590"],[44,46,"G02660"],[47,51,"G02660"]]}},{"n":15,"text":"He is the image of the invisible God, the firstborn of all creation.","sp":{"w":[[0,2,"G37390"],[3,5,"G15100"],[6,9,"G15040"],[10,15,"G15040"],[16,18,"G23160"],[19,22,"G23160"],[23,32,"G05170"],[33,36,"G23160"],[38,41,"G44160"],[42,51,"G44160"],[52,54,"G29370"],[55,58,"G39560"],[59,67,"G29370"]]}},{"n":16,"text":"For in him all things were created, in the heavens and on the earth, the visible and the invisible. Whether thrones or dominions or governments or authorities, all things have been created though him and for him.","sp":{"w":[[0,3,"G37540"],[4,6,"G17220"],[7,10,"G08460"],[11,14,"G39560"],[15,21,"G39560"],[22,26,"G29360"],[27,34,"G29360"],[36,38,"G17220"],[39,42,"G35880"],[43,50,"G37720"],[51,54,"G25320"],[55,57,"G19090"],[58,61,"G35880"],[62,67,"G10930"],[69,72,"G35880"],[73,80,"G37070"],[81,84,"G25320"],[85,88,"G35880"],[89,98,"G05170"],[100,107,"G15350"],[108,115,"G23620"],[116,118,"G15350"],[119,128,"G29630"],[129,131,"G15350"],[132,143,"G07460"],[144,146,"G15350"],[147,158,"G18490"],[160,163,"G39560"],[164,170,"G39560"],[171,175,"G29360"],[176,180,"G29360"],[181,188,"G29360"],[189,195,"G12230"],[196,199,"G08460"],[200,203,"G25320"],[204,207,"G15190"],[208,211,"G08460"]]}},{"n":17,"text":"And he is before all things, and in him all things hold together.","sp":{"w":[[0,3,"G25320"],[4,6,"G08460"],[7,9,"G15100"],[10,16,"G42530"],[17,20,"G39560"],[21,27,"G39560"],[29,32,"G25320"],[33,35,"G17220"],[36,39,"G08460"],[40,43,"G39560"],[44,50,"G39560"],[51,55,"G49210"],[56,64,"G49210"]]}},{"n":18,"text":"And he is the head of the body, the church. He is the beginning, the firstborn from among the dead, so that he himself might become first among all things.","sp":{"w":[[0,3,"G25320"],[4,6,"G08460"],[7,9,"G15100"],[10,13,"G35880"],[14,18,"G27760"],[19,21,"G49830"],[22,25,"G49830"],[26,30,"G49830"],[32,35,"G35880"],[36,42,"G15770"],[44,46,"G37390"],[47,49,"G15100"],[50,53,"G35880"],[54,63,"G07460"],[65,68,"G44160"],[69,78,"G44160"],[79,83,"G15370"],[84,89,"G15370"],[90,93,"G35880"],[94,98,"G34980"],[100,102,"G24430"],[103,107,"G24430"],[108,110,"G10960"],[111,118,"G08460"],[119,124,"G10960"],[125,131,"G10960"],[132,137,"G44090"],[138,143,"G17220"],[144,147,"G39560"],[148,154,"G39560"]]}},{"n":19,"text":"For in him all the fullness was pleased to dwell,","sp":{"w":[[0,3,"G37540"],[4,6,"G17220"],[7,10,"G08460"],[11,14,"G39560"],[15,18,"G35880"],[19,27,"G41380"],[28,31,"G21060"],[32,39,"G21060"],[40,42,"G27300"],[43,48,"G27300"]]}},{"n":20,"text":"and to reconcile through him all things to himself, having made peace through the blood of his cross, through him, whether the things on the earth or the things in the heavens.","sp":{"w":[[0,3,"G25320"],[4,6,"G06040"],[7,16,"G06040"],[17,24,"G12230"],[25,28,"G08460"],[29,32,"G39560"],[33,39,"G39560"],[40,42,"G15190"],[43,50,"G08460"],[52,58,"G15170"],[59,63,"G15170"],[64,69,"G15170"],[70,77,"G12230"],[78,81,"G35880"],[82,87,"G01290"],[88,90,"G47160"],[91,94,"G08460"],[95,100,"G47160"],[102,109,"G12230"],[110,113,"G08460"],[115,122,"G15350"],[123,126,"G35880"],[127,133,"G35880"],[134,136,"G19090"],[137,140,"G35880"],[141,146,"G10930"],[147,149,"G15350"],[150,153,"G35880"],[154,160,"G35880"],[161,163,"G17220"],[164,167,"G35880"],[168,175,"G37720"]]}},{"n":21,"text":"At one time you also were alienated and enemies in thought, in evil deeds.","sp":{"w":[[0,2,"G42180"],[3,6,"G42180"],[7,11,"G42180"],[12,15,"G47710"],[16,20,"G25320"],[21,25,"G15100"],[26,35,"G05260"],[36,39,"G25320"],[40,47,"G21900"],[48,50,"G12710"],[51,58,"G12710"],[60,62,"G17220"],[63,67,"G41900"],[68,73,"G20410"]]}},{"n":22,"text":"But now you have been reconciled by the body of his flesh through death to present you holy and blameless and above reproach before him,","sp":{"w":[[0,3,"G11610"],[4,7,"G35680"],[8,11,"G06040"],[12,16,"G06040"],[17,21,"G06040"],[22,32,"G06040"],[33,35,"G17220"],[36,39,"G35880"],[40,44,"G49830"],[45,47,"G45610"],[48,51,"G08460"],[52,57,"G45610"],[58,65,"G12230"],[66,71,"G22880"],[72,74,"G39360"],[75,82,"G39360"],[83,86,"G47710"],[87,91,"G00400"],[92,95,"G25320"],[96,105,"G02990"],[106,109,"G25320"],[110,115,"G04100"],[116,124,"G04100"],[125,131,"G27140"],[132,135,"G08460"]]}},{"n":23,"text":"if indeed you continue in the faith, founded and firm and not being moved from the hope of the gospel that you heard, the one having been proclaimed to every creature {that is} under heaven, of which I, Paul, became a servant.","sp":{"w":[[0,2,"G14870"],[3,9,"G10650"],[10,13,"G19610"],[14,22,"G19610"],[23,25,"G41020"],[26,29,"G41020"],[30,35,"G41020"],[37,44,"G23110"],[45,48,"G25320"],[49,53,"G14760"],[54,57,"G25320"],[58,61,"G33610"],[62,67,"G33340"],[68,73,"G33340"],[74,78,"G05750"],[79,82,"G35880"],[83,87,"G16800"],[88,90,"G20980"],[91,94,"G20980"],[95,101,"