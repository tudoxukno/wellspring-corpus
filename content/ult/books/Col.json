0"],[40,43,"G47710"],[44,48,"G17220"],[49,59,"G40860"],[60,66,"G40860"]]}},{"n":5,"text":"For even if I am absent in the flesh, yet I am with you in the spirit, rejoicing and seeing your good order and the strength of your faith in Christ.","sp":{"w":[[0,3,"G10630"],[4,8,"G25320"],[9,11,"G14870"],[12,13,"G05480"],[14,16,"G05480"],[17,23,"G05480"],[24,26,"G45610"],[27,30,"G45610"],[31,36,"G45610"],[38,41,"G02350"],[42,43,"G15100"],[44,46,"G15100"],[47,51,"G48620"],[52,55,"G47710"],[56,58,"G41510"],[59,62,"G41510"],[63,69,"G41510"],[71,80,"G54630"],[81,84,"G25320"],[85,91,"G09910"],[92,96,"G47710"],[97,101,"G50100"],[102,107,"G50100"],[108,111,"G25320"],[112,115,"G35880"],[116,124,"G47330"],[125,127,"G41020"],[128,132,"G47710"],[133,138,"G41020"],[139,141,"G15190"],[142,148,"G55470"]]}},{"n":6,"text":"Therefore, as you received Christ Jesus the Lord, walk in him,","br":1,"sp":{"w":[[0,9,"G37670"],[11,13,"G56130"],[14,17,"G38800"],[18,26,"G38800"],[27,33,"G55470"],[34,39,"G24240"],[40,43,"G35880"],[44,48,"G29620"],[50,54,"G40430"],[55,57,"G17220"],[58,61,"G08460"]]}},{"n":7,"text":"being rooted and built up in him and confirmed in the faith just as you were taught, abounding in thanksgiving.","sp":{"w":[[0,5,"G44920"],[6,12,"G44920"],[13,16,"G25320"],[17,22,"G20260"],[23,25,"G20260"],[26,28,"G17220"],[29,32,"G08460"],[33,36,"G25320"],[37,46,"G09500"],[47,49,"G41020"],[50,53,"G41020"],[54,59,"G41020"],[60,64,"G25310"],[65,67,"G25310"],[68,71,"G13210"],[72,76,"G13210"],[77,83,"G13210"],[85,94,"G40520"],[95,97,"G17220"],[98,110,"G21690"]]}},{"n":8,"text":"Beware lest someone will be the one taking you captive through philosophy and empty deceit, according to the tradition of men, according to the elemental teaching of the world, and not according to Christ.","br":1,"sp":{"w":[[0,6,"G09910"],[7,11,"G33610"],[12,19,"G51000"],[20,24,"G15100"],[25,27,"G15100"],[28,31,"G35880"],[32,35,"G35880"],[36,42,"G48120"],[43,46,"G47710"],[47,54,"G48120"],[55,62,"G12230"],[63,73,"G53850"],[74,77,"G25320"],[78,83,"G27560"],[84,90,"G05390"],[92,101,"G25960"],[102,104,"G25960"],[105,108,"G35880"],[109,118,"G38620"],[119,121,"G04440"],[122,125,"G04440"],[127,136,"G25960"],[137,139,"G25960"],[140,143,"G35880"],[144,153,"G47470"],[154,162,"G47470"],[163,165,"G28890"],[166,169,"G28890"],[170,175,"G28890"],[177,180,"G25320"],[181,184,"G37560"],[185,194,"G25960"],[195,197,"G25960"],[198,204,"G55470"]]}},{"n":9,"text":"For in him all the fullness of deity dwells in bodily form,","sp":{"w":[[0,3,"G37540"],[4,6,"G17220"],[7,10,"G08460"],[11,14,"G39560"],[15,18,"G35880"],[19,27,"G41380"],[28,30,"G23200"],[31,36,"G23200"],[37,43,"G27300"],[44,46,"G49850"],[47,53,"G49850"],[54,58,"G49850"]]}},{"n":10,"text":"and you are filled in him, who is the head of all rule and authority,","sp":{"w":[[0,3,"G25320"],[4,7,"G15100"],[8,11,"G15100"],[12,18,"G41370"],[19,21,"G17220"],[22,25,"G08460"],[27,30,"G37390"],[31,33,"G15100"],[34,37,"G35880"],[38,42,"G27760"],[43,45,"G07460"],[46,49,"G39560"],[50,54,"G07460"],[55,58,"G25320"],[59,68,"G18490"]]}},{"n":11,"text":"in whom you were also circumcised with a circumcision made without hands in the removal of the body of flesh in the circumcision of Christ,","sp":{"w":[[0,2,"G17220"],[3,7,"G37390"],[8,11,"G40590"],[12,16,"G40590"],[17,21,"G25320"],[22,33,"G40590"],[34,38,"G40610"],[39,40,"G40610"],[41,53,"G40610"],[54,58,"G08860"],[59,66,"G08860"],[67,72,"G08860"],[73,75,"G17220"],[76,79,"G35880"],[80,87,"G05550"],[88,90,"G49830"],[91,94,"G49830"],[95,99,"G49830"],[100,102,"G45610"],[103,108,"G45610"],[109,111,"G17220"],[112,115,"G35880"],[116,128,"G40610"],[129,131,"G55470"],[132,138,"G55470"]]}},{"n":12,"text":"having been buried with him in baptism and in whom you were raised up through faith in the power of God, the one having raised him from the dead.","sp":{"w":[[0,6,"G49160"],[7,11,"G49160"],[12,18,"G49160"],[19,23,"G49160"],[24,27,"G08460"],[28,30,"G17220"],[31,38,"G09090"],[39,42,"G25320"],[43,45,"G17220"],[46,50,"G37390"],[51,54,"G48910"],[55,59,"G48910"],[60,66,"G48910"],[67,69,"G48910"],[70,77,"G12230"],[78,83,"G41020"],[84,86,"G17530"],[87,90,"G17530"],[91,96,"G17530"],[97,99,"G23160"],[100,103,"G23160"],[105,108,"G35880"],[109,112,"G35880"],[113,119,"G14530"],[120,126,"G14530"],[127,130,"G08460"],[131,135,"G15370"],[136,139,"G34980"],[140,144,"G34980"]]}},{"n":13,"text":"And you, being dead in the trespasses and the uncircumcision of your flesh, he made you alive together with him, having forgiven us all of our trespasses,","sp":{"w":[[0,3,"G25320"],[4,7,"G47710"],[9,14,"G15100"],[15,19,"G34980"],[20,22,"G17220"],[23,26,"G35880"],[27,37,"G39000"],[38,41,"G25320"],[42,45,"G35880"],[46,60,"G02030"],[61,63,"G45610"],[64,68,"G47710"],[69,74,"G45610"],[76,78,"G48060"],[79,83,"G48060"],[84,87,"G47710"],[88,93,"G48060"],[94,102,"G48060"],[103,107,"G48620"],[108,111,"G08460"],[113,119,"G54830"],[120,128,"G54830"],[129,131,"G14730"],[132,135,"G39560"],[136,138,"G39000"],[139,142,"G35880"],[143,153,"G39000"]]}},{"n":14,"text":"having canceled the written record of the decrees against us, which were opposed to us, and he has taken {it} out from our midst, having nailed it to the cross;","sp":{"w":[[0,6,"G18130"],[7,15,"G18130"],[16,19,"G35880"],[20,27,"G54980"],[28,34,"G54980"],[35,37,"G13780"],[38,41,"G13780"],[42,49,"G13780"],[50,57,"G25960"],[58,60,"G14730"],[62,67,"G37390"],[68,72,"G15100"],[73,80,"G52270"],[81,83,"G14730"],[84,86,"G14730"],[88,91,"G25320"],[92,94,"G08460"],[95,98,"G01420"],[99,104,"G01420"],[106,108,"G01420"],[110,113,"G15370"],[114,118,"G15370"],[119,122,"G35880"],[123,128,"G33190"],[130,136,"G43380"],[137,143,"G43380"],[144,146,"G08460"],[147,149,"G47160"],[150,153,"G47160"],[154,159,"G47160"]]}},{"n":15,"text":"having stripped the rulers and the authorities, he made a public spectacle of {them}, having triumphed over them in it.","sp":{"w":[[0,6,"G05540"],[7,15,"G05540"],[16,19,"G35880"],[20,26,"G07460"],[27,30,"G25320"],[31,34,"G35880"],[35,46,"G18490"],[48,50,"G11650"],[51,55,"G11650"],[56,57,"G11650"],[58,64,"G39540"],[65,74,"G11650"],[75,77,"G11650"],[79,83,"G11650"],[86,92,"G23580"],[93,102,"G23580"],[103,107,"G23580"],[108,112,"G08460"],[113,115,"G17220"],[116,118,"G08460"]]}},{"n":16,"text":"Therefore, do not let anyone judge you in food or in drink or in regard to a festival or a new moon or Sabbaths,","br":1,"sp":{"w":[[0,9,"G37670"],[11,13,"G29190"],[14,17,"G33610"],[18,21,"G29190"],[22,28,"G51000"],[29,34,"G29190"],[35,38,"G47710"],[39,41,"G17220"],[42,46,"G10350"],[47,49,"G25320"],[50,52,"G17220"],[53,58,"G42130"],[59,61,"G22280"],[62,64,"G17220"],[65,71,"G33130"],[72,74,"G33130"],[75,76,"G18590"],[77,85,"G18590"],[86,88,"G22280"],[89,90,"G35610"],[91,94,"G35610"],[95,99,"G35610"],[100,102,"G22280"],[103,111,"G45210"]]}},{"n":17,"text":"which are a shadow of the things coming, but the body {is} of Christ.","sp":{"w":[[0,5,"G37390"],[6,9,"G15100"],[10,11,"G46390"],[12,18,"G46390"],[19,21,"G35880"],[22,25,"G35880"],[26,32,"G35880"],[33,39,"G31950"],[41,44,"G11610"],[45,48,"G35880"],[49,53,"G49830"],[55,57,"G55470"],[59,61,"G55470"],[62,68,"G55470"]]}},{"n":18,"text":"Let no one delighting in false humility and worship of the angels deprive you of your prize, standing on things he has seen, becoming puffed up without cause by the mind of his flesh","sp":{"w":[[0,3,"G26030"],[4,6,"G33670"],[7,10,"G33670"],[11,21,"G23090"],[22,24,"G17220"],[25,30,"G50120"],[31,39,"G50120"],[40,43,"G25320"],[44,51,"G23560"],[52,54,"G00320"],[55,58,"G00320"],[59,65,"G00320"],[66,73,"G26030"],[74,77,"G47710"],[78,80,"G26030"],[81,85,"G26030"],[86,91,"G26030"],[93,101,"G16870"],[102,104,"G16870"],[105,111,"G37390"],[112,114,"G37080"],[115,118,"G37080"],[119,123,"G37080"],[125,133,"G54480"],[134,140,"G54480"],[141,143,"G54480"],[144,151,"G15000"],[152,157,"G15000"],[158,160,"G52590"],[161,164,"G35880"],[165,169,"G35630"],[170,172,"G45610"],[173,176,"G08460"],[177,182,"G45610"]]}},{"n":19,"text":"and not holding fast to the head, from which the whole body, being supplied and held together through the joints and ligaments, grows with the growth from God.","sp":{"w":[[0,3,"G25320"],[4,7,"G37560"],[8,15,"G29020"],[16,20,"G29020"],[21,23,"G27760"],[24,27,"G27760"],[28,32,"G27760"],[34,38,"G15370"],[39,44,"G37390"],[45,48,"G35880"],[49,54,"G39560"],[55,59,"G49830"],[61,66,"G20230"],[67,75,"G20230"],[76,79,"G25320"],[80,84,"G48220"],[85,93,"G48220"],[94,101,"G12230"],[102,105,"G35880"],[106,112,"G08600"],[113,116,"G25320"],[117,126,"G48860"],[128,133,"G08370"],[134,138,"G08380"],[139,142,"G08380"],[143,149,"G08380"],[150,154,"G23160"],[155,158,"G23160"]]}},{"n":20,"text":"If you died with Christ from the elemental principles of the world, why, as living in the world, are you being subjected to its decrees:","br":1,"sp":{"w":[[0,2,"G14870"],[3,6,"G05990"],[7,11,"G05990"],[12,16,"G48620"],[17,23,"G55470"],[24,28,"G05750"],[29,32,"G35880"],[33,42,"G47470"],[43,53,"G47470"],[54,56,"G28890"],[57,60,"G28890"],[61,66,"G28890"],[68,71,"G51010"],[73,75,"G56130"],[76,82,"G21980"],[83,85,"G17220"],[86,89,"G28890"],[90,95,"G28890"],[97,100,"G13790"],[101,104,"G13790"],[105,110,"G13790"],[111,120,"G13790"],[121,123,"G13790"],[124,127,"G13790"],[128,135,"G13790"]]}},{"n":21,"text":"“You may not handle, nor taste, nor touch!”","sp":{"w":[[1,4,"G06810"],[5,8,"G06810"],[9,12,"G33610"],[13,19,"G06810"],[21,24,"G33660"],[25,30,"G10890"],[32,35,"G33660"],[36,41,"G23450"]]}},{"n":22,"text":"which are all for destruction with the use, according to the commands and teachings of men;","sp":{"w":[[0,5,"G37390"],[6,9,"G15100"],[10,13,"G39560"],[14,17,"G15190"],[18,29,"G53560"],[30,34,"G06710"],[35,38,"G06710"],[39,42,"G06710"],[44,53,"G25960"],[54,56,"G25960"],[57,60,"G35880"],[61,69,"G17780"],[70,73,"G25320"],[74,83,"G13190"],[84,86,"G04440"],[87,90,"G04440"]]}},{"n":23,"text":"which, having indeed a word of wisdom in self-made religion and false humility {and} severity of the body, are not of any value against indulgence of the flesh.","sp":{"w":[[0,5,"G37480"],[7,13,"G21920"],[14,20,"G33030"],[21,22,"G30560"],[23,27,"G30560"],[28,30,"G46780"],[31,37,"G46780"],[38,40,"G17220"],[41,45,"G14790"],[46,50,"G14790"],[51,59,"G14790"],[60,63,"G25320"],[64,69,"G50120"],[70,78,"G50120"],[80,83,"G08570"],[85,93,"G08570"],[94,96,"G49830"],[97,100,"G49830"],[101,105,"G49830"],[107,110,"G15100"],[111,114,"G37560"],[115,117,"G17220"],[118,121,"G51000"],[122,127,"G50920"],[128,135,"G43140"],[136,146,"G41400"],[147,149,"G45610"],[150,153,"G45610"],[154,159,"G45610"]]}}]},{"n":3,"verses":[{"n":1,"text":"If, therefore, you were raised with Christ, seek the things above, where Christ is sitting at the right hand of God.","br":1,"sp":{"w":[[0,2,"G14870"],[4,13,"G37670"],[15,18,"G48910"],[19,23,"G48910"],[24,30,"G48910"],[31,35,"G48910"],[36,42,"G55470"],[44,48,"G22120"],[49,52,"G35880"],[53,59,"G35880"],[60,65,"G05070"],[67,72,"G37570"],[73,79,"G55470"],[80,82,"G15100"],[83,90,"G25210"],[91,93,"G17220"],[94,97,"G11880"],[98,103,"G11880"],[104,108,"G11880"],[109,111,"G23160"],[112,115,"G23160"]]}},{"n":2,"text":"Think about the things above, not the things on the earth.","sp":{"w":[[0,5,"G54260"],[6,11,"G54260"],[12,15,"G35880"],[16,22,"G35880"],[23,28,"G05070"],[30,33,"G33610"],[34,37,"G35880"],[38,44,"G35880"],[45,47,"G19090"],[48,51,"G35880"],[52,57,"G10930"]]}},{"n":3,"text":"For you died, and your life has been hidden with Christ in God.","sp":{"w":[[0,3,"G10630"],[4,7,"G05990"],[8,12,"G05990"],[14,17,"G25320"],[18,22,"G47710"],[23,27,"G22220"],[28,31,"G29280"],[32,36,"G29280"],[37,43,"G29280"],[44,48,"G48620"],[49,55,"G55470"],[56,58,"G17220"],[59,62,"G23160"]]}},{"n":4,"text":"When Christ, your life, is revealed, then you also will be revealed with him in glory.","sp":{"w":[[0,4,"G37520"],[5,11,"G55470"],[13,17,"G47710"],[18,22,"G22220"],[24,26,"G53190"],[27,35,"G53190"],[37,41,"G51190"],[42,45,"G47710"],[46,50,"G25320"],[51,55,"G53190"],[56,58,"G53190"],[59,67,"G53190"],[68,72,"G48620"],[73,76,"G08460"],[77,79,"G17220"],[80,85,"G13910"]]}},{"n":5,"text":"Put to death, therefore, the members {that are} on the earth—sexual immorality, uncleanness, passion, evil desire, and envy, which is idolatry,","br":1,"sp":{"w":[[0,3,"G34990"],[4,6,"G34990"],[7,12,"G34990"],[14,23,"G37670"],[25,28,"G35880"],[29,36,"G31960"],[38,42,"G35880"],[43,46,"G35880"],[48,50,"G19090"],[51,54,"G35880"],[55,60,"G10930"],[61,67,"G42020"],[68,78,"G42020"],[80,91,"G01670"],[93,100,"G38060"],[102,106,"G25560"],[107,113,"G19390"],[115,118,"G25320"],[119,123,"G41240"],[125,130,"G37480"],[131,133,"G15100"],[134,142,"G14950"]]}},{"n":6,"text":"because of which the wrath of God is coming,","sp":{"w":[[0,7,"G12230"],[8,10,"G12230"],[11,16,"G37390"],[17,20,"G35880"],[21,26,"G37090"],[27,29,"G23160"],[30,33,"G23160"],[34,36,"G20640"],[37,43,"G20640"]]}},{"n":7,"text":"in which you also formerly walked when you were living in them.","sp":{"w":[[0,2,"G17220"],[3,8,"G37390"],[9,12,"G47710"],[13,17,"G25320"],[18,26,"G42180"],[27,33,"G40430"],[34,38,"G37530"],[39,42,"G21980"],[43,47,"G21980"],[48,54,"G21980"],[55,57,"G17220"],[58,62,"G37780"]]}},{"n":8,"text":"But now you must also lay aside all {such things}—wrath, anger, evil desire, slander, {and} obscene speech from your mouth.","sp":{"w":[[0,3,"G11610"],[4,7,"G35680"],[8,11,"G47710"],[12,16,"G06590"],[17,21,"G25320"],[22,25,"G06590"],[26,31,"G06590"],[32,35,"G39560"],[37,41,"G35880"],[42,48,"G35880"],[50,55,"G37090"],[57,62,"G23720"],[64,68,"G25490"],[69,75,"G25490"],[77,84,"G09880"],[87,90,"G01480"],[92,99,"G01480"],[100,106,"G01480"],[107,111,"G15370"],[112,116,"G47710"],[117,122,"G47500"]]}},{"n":9,"text":"Do not lie to one another, having taken off the old man with its practices","sp":{"w":[[0,2,"G55740"],[3,6,"G33610"],[7,10,"G55740"],[11,13,"G15190"],[14,17,"G02400"],[18,25,"G02400"],[27,33,"G05540"],[34,39,"G05540"],[40,43,"G05540"],[44,47,"G35880"],[48,51,"G38200"],[52,55,"G04440"],[56,60,"G48620"],[61,64,"G08460"],[65,74,"G42340"]]}},{"n":10,"tex