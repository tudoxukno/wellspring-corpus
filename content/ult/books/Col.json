{"translation":"ult","osis":"Col","name":"Colossians","testament":"nt","title":"Colossians","chapters":[{"n":1,"verses":[{"n":1,"text":"Paul, an apostle of Christ Jesus through the will of God, and Timothy our brother,","br":1,"sp":{"w":[[0,4,"G39720"],[6,8,"G06520"],[9,16,"G06520"],[17,19,"G55470"],[20,26,"G55470"],[27,32,"G24240"],[33,40,"G12230"],[41,44,"G23070"],[45,49,"G23070"],[50,52,"G23160"],[53,56,"G23160"],[58,61,"G25320"],[62,69,"G50950"],[70,73,"G35880"],[74,81,"G00800"]]}},{"n":2,"text":"to the saints and faithful brothers in Christ in Colossae. Grace to you, and peace from God our Father and the Lord Jesus Christ.","sp":{"w":[[0,2,"G00400"],[3,6,"G00400"],[7,13,"G00400"],[14,17,"G25320"],[18,26,"G41030"],[27,35,"G00800"],[36,38,"G17220"],[39,45,"G55470"],[46,48,"G17220"],[49,57,"G28570"],[59,64,"G54850"],[65,67,"G47710"],[68,71,"G47710"],[73,76,"G25320"],[77,82,"G15150"],[83,87,"G05750"],[88,91,"G23160"],[92,95,"G14730"],[96,102,"G39620"],[103,106,"G25320"],[107,110,"G29620"],[111,115,"G29620"],[116,121,"G24240"],[122,128,"G55470"]]}},{"n":3,"text":"We give thanks to God, the Father of our Lord Jesus Christ, always praying for you,","br":1,"sp":{"w":[[0,2,"G21680"],[3,7,"G21680"],[8,14,"G21680"],[15,17,"G23160"],[18,21,"G23160"],[23,26,"G39620"],[27,33,"G39620"],[34,36,"G29620"],[37,40,"G14730"],[41,45,"G29620"],[46,51,"G24240"],[52,58,"G55470"],[60,66,"G38420"],[67,74,"G43360"],[75,78,"G40120"],[79,82,"G47710"]]}},{"n":4,"text":"having heard of your faith in Christ Jesus and the love that you have for all the saints,","sp":{"w":[[0,6,"G01910"],[7,12,"G01910"],[13,15,"G01910"],[16,20,"G47710"],[21,26,"G41020"],[27,29,"G17220"],[30,36,"G55470"],[37,42,"G24240"],[43,46,"G25320"],[47,50,"G35880"],[51,55,"G00260"],[56,60,"G37390"],[61,64,"G21920"],[65,69,"G21920"],[70,73,"G15190"],[74,77,"G39560"],[78,81,"G35880"],[82,88,"G00400"]]}},{"n":5,"text":"because of the hope that is being reserved for you in the heavens, which you heard before in the word of truth, the gospel,","sp":{"w":[[0,7,"G12230"],[8,10,"G12230"],[11,14,"G35880"],[15,19,"G16800"],[20,24,"G35880"],[25,27,"G06060"],[28,33,"G06060"],[34,42,"G06060"],[43,46,"G06060"],[47,50,"G47710"],[51,53,"G17220"],[54,57,"G35880"],[58,65,"G37720"],[67,72,"G37390"],[73,76,"G42570"],[77,82,"G42570"],[83,89,"G42570"],[90,92,"G17220"],[93,96,"G35880"],[97,101,"G30560"],[102,104,"G02250"],[105,110,"G02250"],[112,115,"G35880"],[116,122,"G20980"]]}},{"n":6,"text":"which being present among you just as also in all the world, is bearing fruit and growing, just as also in you, from the day you heard {it} and learned about the grace of God in truth,","sp":{"w":[[0,5,"G35880"],[6,11,"G39180"],[12,19,"G39180"],[20,25,"G15190"],[26,29,"G47710"],[30,34,"G25310"],[35,37,"G25310"],[38,42,"G25320"],[43,45,"G17220"],[46,49,"G39560"],[50,53,"G35880"],[54,59,"G28890"],[61,63,"G15100"],[64,71,"G25920"],[72,77,"G25920"],[78,81,"G25320"],[82,89,"G08370"],[91,95,"G25310"],[96,98,"G25310"],[99,103,"G25320"],[104,106,"G17220"],[107,110,"G47710"],[112,116,"G05750"],[117,120,"G37390"],[121,124,"G22500"],[125,128,"G01910"],[129,134,"G01910"],[136,138,"G01910"],[140,143,"G25320"],[144,151,"G19210"],[152,157,"G19210"],[158,161,"G35880"],[162,167,"G54850"],[168,170,"G23160"],[171,174,"G23160"],[175,177,"G17220"],[178,183,"G02250"]]}},{"n":7,"text":"just as you learned {it} from Epaphras, our beloved fellow servant, who is a faithful servant of Christ on our behalf,","sp":{"w":[[0,4,"G25310"],[5,7,"G25310"],[8,11,"G31290"],[12,19,"G31290"],[21,23,"G31290"],[25,29,"G05750"],[30,38,"G18890"],[40,43,"G14730"],[44,51,"G00270"],[52,58,"G48890"],[59,66,"G48890"],[68,71,"G37390"],[72,74,"G15100"],[75,76,"G12490"],[77,85,"G41030"],[86,93,"G12490"],[94,96,"G55470"],[97,103,"G55470"],[104,106,"G52280"],[107,110,"G14730"],[111,117,"G52280"]]}},{"n":8,"text":"and the one having made known to us your love in the Spirit.","sp":{"w":[[0,3,"G25320"],[4,7,"G35880"],[8,11,"G35880"],[12,18,"G12130"],[19,23,"G12130"],[24,