0"],[164,167,"G34080"],[168,173,"G34080"],[175,178,"G06220"],[179,183,"G06220"],[184,193,"G06220"],[194,201,"G06220"],[202,206,"G06220"],[207,211,"G06220"],[212,214,"G06220"],[215,224,"G06220"],[225,230,"G28790"],[231,234,"G04850"],[235,240,"G04850"],[241,244,"G04850"],[245,253,"G04850"],[255,262,"G04850"],[263,268,"G04850"],[269,273,"G04850"],[274,277,"G04850"]]}},{"n":12,"text":"These people are shamelessly eating with you. At your fellowship meals they are like rocks hidden under the water that ships crash against. They only take care of themselves. They are {useless,} like clouds that the wind carries away before they can give rain. They are {useless,} like trees that don’t bear fruit at harvest time. {They are like trees} that will die twice because God will uproot them.","sp":{"w":[[0,5,"G37780"],[6,12,"G37780"],[13,16,"G15100"],[17,28,"G08700"],[29,35,"G49100"],[36,40,"G49100"],[41,44,"G49100"],[46,48,"G00260"],[49,53,"G47710"],[54,64,"G00260"],[65,70,"G00260"],[71,75,"G46940"],[76,79,"G46940"],[80,84,"G46940"],[85,90,"G46940"],[91,97,"G46940"],[98,103,"G46940"],[104,107,"G46940"],[108,113,"G46940"],[114,118,"G46940"],[119,124,"G46940"],[125,130,"G46940"],[131,138,"G46940"],[140,144,"G41650"],[145,149,"G41650"],[150,154,"G41650"],[155,159,"G41650"],[160,162,"G41650"],[163,173,"G14380"],[175,179,"G35070"],[180,183,"G35070"],[185,192,"G35070"],[195,199,"G35070"],[200,206,"G35070"],[207,211,"G39110"],[212,215,"G39110"],[216,220,"G39110"],[221,228,"G39110"],[229,233,"G39110"],[234,240,"G39110"],[241,245,"G39110"],[246,249,"G39110"],[250,254,"G39110"],[255,259,"G39110"],[261,265,"G11860"],[266,269,"G11860"],[271,278,"G11860"],[281,285,"G11860"],[286,291,"G11860"],[292,296,"G01750"],[297,300,"G01750"],[301,302,"G01750"],[303,307,"G01750"],[308,313,"G01750"],[314,316,"G53520"],[317,324,"G53520"],[325,329,"G53520"],[332,336,"G05990"],[337,340,"G05990"],[341,345,"G05990"],[346,351,"G05990"],[353,357,"G05990"],[358,362,"G05990"],[363,366,"G05990"],[367,372,"G13640"],[3