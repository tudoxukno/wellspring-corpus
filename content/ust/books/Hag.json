H3808"],[110,114,"c:H5704"],[115,124,"H5375"],[125,129,"H5375"],[131,135,"c:d:H7416"],[136,147,"c:d:H7416"],[148,153,"c:d:H7416"],[154,158,"c:H5704"],[159,162,"H3808"],[163,167,"c:H5704"],[168,177,"H5375"],[178,190,"H5375"],[192,196,"c:H6086"],[197,202,"d:H2132"],[203,208,"c:H6086"],[209,213,"c:H5704"],[214,217,"H3808"],[218,222,"c:H5704"],[223,232,"H5375"],[233,239,"H5375"],[241,244,"H4480a"],[245,249,"H4480a"],[250,253,"d:H2088"],[254,256,"d:H2088"],[258,259,"H1288"],[260,264,"H1288"],[265,270,"H1288"],[271,274,"H1288"],[276,280,"H1288"],[281,283,"H1288"],[284,293,"H1288"],[294,296,"H1288"],[297,302,"H1288"]]}},{"n":20,"text":"Yahweh then gave a second message to Haggai on that same day. He said,","sp":{"w":[[0,6,"H3068"],[7,11,"c:H1961"],[12,16,"c:H1961"],[17,18,"H8145"],[19,25,"H8145"],[26,33,"H1697"],[34,36,"H0413"],[37,43,"H2292a"],[44,46,"l:H2320"],[47,51,"l:H2320"],[52,56,"l:H2320"],[57,60,"l:H2320"],[62,64,"l:H0559"],[65,69,"l:H0559"]]}},{"n":21,"text":"“Tell Zerubbabel, the governor of Judah, this for me: ‘It is going to be as if I am shaking the sky and the earth.","sp":{"w":[[1,5,"H0413"],[6,16,"H2216"],[18,21,"H6346"],[22,30,"H6346"],[31,33,"H3063"],[34,39,"H3063"],[41,45,"l:H0559"],[46,49,"l:H0559"],[50,52,"l:H0559"],[55,57,"H0589"],[58,60,"H0589"],[61,66,"H0589"],[67,69,"H0589"],[70,72,"H0589"],[73,75,"H0589"],[76,78,"H0589"],[79,80,"H0589"],[81,83,"H7493"],[84,91,"H7493"],[92,95,"d:H8064"],[96,99,"d:H8064"],[100,103,"d:H0776"],[104,107,"d:H0776"],[108,113,"d:H0776"]]}},{"n":22,"text":"It will seem that way because I am going to stop kingdoms from ruling over other kingdoms. I am going to make strong nations weak. I am going to do this by making the nations fight wars against each other. When they do, they will completely destroy one another’s armies.’","sp":{"w":[[0,2,"c:H2015"],[3,7,"c:H2015"],[8,12,"c:H2015"],[13,17,"c:H2015"],[18,21,"c:H2015"],[22,29,"c:H2015"],[30,31,"c:H2015"],[32,34,"c:H2015"],[35,40,"c:H2015"],[41,43,"c:H2015"],[44,48,"c:H2015