8,"G01410"],[19,21,"G01410"],[22,30,"G01410"],[31,33,"G01410"],[34,39,"G01410"],[40,48,"G01410"],[49,59,"G01410"],[60,65,"G33260"],[66,69,"G35590"],[70,74,"G35590"],[75,81,"G35590"],[82,85,"G35590"],[86,89,"G15200"],[90,92,"G25320"],[93,96,"G12080"],[97,102,"G12080"],[103,105,"G35590"],[106,110,"G35590"],[111,116,"G35590"],[117,119,"G35590"],[121,125,"G38680"],[126,130,"G38680"],[131,138,"G38680"],[139,143,"G38680"],[144,146,"G38680"],[147,149,"G38680"],[150,154,"G38680"],[155,158,"G38680"]]}},{"n":11,"text":"because you know that someone like that has rejected the truth; he is sinning and condemns himself.","sp":{"w":[[0,7,"G14920"],[8,11,"G14920"],[12,16,"G14920"],[17,21,"G37540"],[22,29,"G51080"],[30,34,"G51080"],[35,39,"G51080"],[40,43,"G16120"],[44,52,"G16120"],[53,56,"G16120"],[57,62,"G16120"],[64,66,"G02640"],[67,69,"G02640"],[70,77,"G02640"],[78,81,"G08430"],[82,90,"G08430"],[91,98,"G08430"]]}},{"n":12,"text":"I plan to send Artemas or Tychicus to you. After one of them arrives, come quickly to me at the town of Nicopolis, because I have decided to stay there for the winter.","br":1,"sp":{"w":[[0,1,"G39920"],[2,6,"G39920"],[7,9,"G39920"],[10,14,"G39920"],[15,22,"G07340"],[23,25,"G22280"],[26,34,"G51900"],[35,37,"G43140"],[38,41,"G47710"],[43,48,"G37520"],[49,52,"G37520"],[53,55,"G37520"],[56,60,"G37520"],[61,68,"G37520"],[70,74,"G20640"],[75,82,"G47040"],[83,85,"G43140"],[86,88,"G14730"],[89,91,"G15190"],[92,95,"G35330"],[96,100,"G35330"],[101,103,"G35330"],[104,113,"G35330"],[115,122,"G10630"],[123,124,"G29190"],[125,129,"G29190"],[130,137,"G29190"],[138,140,"G39140"],[141,145,"G39140"],[146,151,"G15630"],[152,155,"G39140"],[156,159,"G39140"],[160,166,"G39140"]]}},{"n":13,"text":"Do everything you can to equip Zenas the law expert and Apollos for their journey, making sure that they have everything that they need.","sp":{"w":[[0,2,"G47090"],[3,13,"G47090"],[14,17,"G47090"],[18,21,"G47090"],[22,24,"G43110"],[25,30,"G43110"],[31,36,"G22110"],[37,40,"G35880"],