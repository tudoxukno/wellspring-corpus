{"id":"talmai","name":"Talmai","aliases":[],"sources":["nave","easton"],"topics":["nave:talmai"],"types":[{"type":"person","from":"UBS: Names of People"}],"standing":"single-index","indexes":["nave"],"thin":false,"groups":[],"definition":{"source":"easton","term":"Talmai","text":"Abounding in furrows. (1.) One of the Anakim of Hebron, who were slain by the men of Judah under Caleb (Num. 13:22; Josh. 15:14; Judg. 1:10). (2.) A king of Geshur, to whom Absalom fled after he had put Amnon to death (2 Sam. 3:3; 13:37). His daughter, Maachah, was one of David’s wives, and the mother of Absalom (1 Chr. 3:2)."},"lemmas":[{"strong":"H8526","lemma":"תַּלְמַי","xlit":"Talmay","gloss":"Talmai, the name of a Canaanite and a Syrian","kjv":"Talmai","count":6,"share":1},{"strong":"H4428","lemma":"מֶלֶךְ","xlit":"melek","gloss":"a king","kjv":"king, royal","count":3,"share":0.5},{"strong":"H1121","lemma":"בֵּן","xlit":"bên","gloss":"a son , in the widest sense , etc.)","kjv":"afflicted, age, ite, ed one","count":4,"share":0.67}],"verses":["Num.13.22","Josh.15.14","Judg.1.10","2Sam.3.3","2Sam.13.37","1Chr.3.2"],"witnesses":["n","n","n","n","n","n"],"agreed":0,"broader":[],"narrower":[],"related":[{"id":"sheshai","type":"cooccur","shared":3,"jaccard":0.5,"why":"3 verses are indexed under both"},{"id":"absalom","type":"cooccur","shared":3,"jaccard":0.043,"why":"3 verses are indexed under both"},{"id":"absalom","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"ahaz","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"amnesty","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"ar","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"arad","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"ashtaroth","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"}],"works":[{"work":"antiquities","title":"Antiquities of the Jews","count":1,"