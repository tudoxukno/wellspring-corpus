{"id":"jarmuth","name":"Jarmuth","aliases":[],"sources":["nave","easton"],"topics":["nave:jarmuth"],"types":[{"type":"place","from":"UBS: Names of Locations"}],"standing":"single-index","indexes":["nave"],"thin":false,"groups":[],"definition":{"source":"easton","term":"Jarmuth","text":"Height. (1.) A town in the plain of Judah (Josh. 15:35), originally the residence of one of the Canaanitish kings (10:3, 5, 23). It has been identified with the modern Yarmuk, a village about 7 miles north-east of Beit-Jibrin. (2.) A Levitical city of the tribe of Issachar (Josh. 21:29), supposed by some to be the Ramah of Samuel (1 Sam. 19:22)."},"lemmas":[{"strong":"H3412","lemma":"יַרְמוּת","xlit":"Yarmûwth","gloss":"Jarmuth, the name of two places in Palestine","kjv":"Jarmuth","count":7,"share":1},{"strong":"H4428","lemma":"מֶלֶךְ","xlit":"melek","gloss":"a king","kjv":"king, royal","count":4,"share":0.57}],"verses":["Josh.10.3","Josh.10.5","Josh.10.23","Josh.12.11","Josh.15.35","Josh.21.29","Neh.11.29"],"witnesses":["n","n","n","n","n","n","n"],"agreed":0,"broader":[],"narrower":[],"related":[{"id":"adoni-zedek","type":"cooccur","shared":3,"jaccard":0.097,"why":"3 verses are indexed under both"},{"id":"debir","type":"cooccur","shared":3,"jaccard":0.079,"why":"3 verses are indexed under both"},{"id":"hebron","type":"cooccur","shared":3,"jaccard":0.033,"why":"3 verses are indexed under both"},{"id":"absalom","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"ahaz","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"amnesty","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"ar","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"arad","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"},{"id":"ashtaroth","type":"lexical","strong":"H4428","why":"both lead with מֶלֶךְ (H4428)"}],"works":[]}
