{"id":"taanach","name":"Taanach","aliases":[],"sources":["nave","easton"],"topics":["nave:taanach"],"types":[{"type":"place","from":"places atlas"}],"standing":"single-index","indexes":["nave"],"thin":false,"groups":[],"definition":{"source":"easton","term":"Taanach","text":"A sandy place, an ancient royal city of the Canaanites, on the south-western border of the plain of Esdraelon, 4 miles south of Megiddo. Its king was conquered by Joshua (12:21). It was assigned to the Levites of the family of Kohath (17:11-18; 21:25). It is mentioned in the song of Deborah (Judg. 5:19). It is identified with the small modern village of Ta’annuk."},"lemmas":[{"strong":"H8590","lemma":"תַּעֲנָךְ","xlit":"Taʻănâk","gloss":"Taanak or Tanak, a place in Palestine","kjv":"Taanach, Tanach","count":7,"share":0.88},{"strong":"H1323","lemma":"בַּת","xlit":"bath","gloss":"a daughter","kjv":"apple, branch, company, daughter","count":3,"share":0.38},{"strong":"H3427","lemma":"יָשַׁב","xlit":"yâshab","gloss":"to sit down","kjv":"abide, continue, dwell, ease self","count":4,"share":0.5}],"verses":["Josh.12.21","Josh.17.11","Josh.21.25","Judg.1.27","Judg.5.19","1Kgs.4.12","1Chr.7.29","Josh.17.12"],"witnesses":["n","n","n","n","n","n","n","n"],"agreed":0,"broader":[],"narrower":[],"related":[{"id":"beth-shean","type":"cooccur","shared":4,"jaccard":0.364,"why":"4 verses are indexed under both"},{"id":"megiddo","type":"cooccur","shared":5,"jaccard":0.313,"why":"5 verses are indexed under both"},{"id":"manasseh-the-tribe-of","type":"cooccur","shared":3,"jaccard":0.03,"why":"3 verses are indexed under both"},{"id":"aholibamah","type":"lexical","strong":"H1323","why":"both lead with בַּת (H1323)"},{"id":"ajah","type":"lexical","strong":"H1323","why":"both lead with בַּת (H1323)"},{"id":"anah","type":"lexical","strong":"H1323","why":"both lead with בַּת (H1323)"},{"id":"asenath","type":"lexical","strong":"H1323","why":"both lead with בַּת (H1323)"},{"id":"beth-shean","type":"lexical","strong":"H1323",