{"id":"jehozadak","name":"Jehozadak","aliases":[],"sources":["nave","easton"],"topics":["nave:jehozadak"],"groups":[],"definition":{"source":"easton","term":"Jehozadak","text":"Jehovah-justified, the son of the high priest Seraiah at the time of the Babylonian exile (1 Chr. 6:14, 15). He was carried into captivity by Nebuchadnezzar, and probably died in Babylon. He was the father of Jeshua, or Joshua, who returned with Zerubbabel."},"lemmas":[{"strong":"H3087","lemma":"יְהוֹצָדָק","xlit":"Yᵉhôwtsâdâq","gloss":"Jehotsadak, an Israelite","kjv":"Jehozadek, Josedech","count":8,"share":0.62},{"strong":"H2216","lemma":"זְרֻבָּבֶל","xlit":"Zᵉrubbâbel","gloss":"Zerubbabel, an Israelite","kjv":"Zerubbabel","count":7,"share":0.54},{"strong":"H7597","lemma":"שְׁאַלְתִּיאֵל","xlit":"Shᵉʼaltîyʼêl","gloss":"Shealtiel, an Israelite","kjv":"Shalthiel, Shealtiel","count":6,"share":0.46},{"strong":"H3136","lemma":"יוֹצָדָק","xlit":"Yôwtsâdâq","gloss":"Jotsadak, an Israelite","kjv":"Jozadak","count":5,"share":0.38},{"strong":"H3091","lemma":"יְהוֹשׁוּעַ","xlit":"Yᵉhôwshûwaʻ","gloss":"Jehoshua , the Jewish leader","kjv":"Jehoshua, Jehoshuah, Joshua","count":6,"share":0.46},{"strong":"H6346","lemma":"פֶּחָה","xlit":"pechâh","gloss":"a prefect","kjv":"captain, deputy, governor","count":4,"share":0.31}],"verses":["1Chr.6.14","1Chr.6.15","Hag.1.1","Hag.1.12","Hag.1.14","Hag.2.2","Hag.2.4","Zech.6.11","Ezra.3.2","Ezra.3.8","Ezra.5.2","Ezra.10.18","Neh.12.26"],"related":[{"id":"shealtiel","type":"cooccur","shared":7,"jaccard":0.389,"why":"7 verses are indexed under both"},{"id":"zerubbabel","type":"cooccur","shared":6,"jaccard":0.162,"why":"6 verses are indexed under both"},{"id":"jeshua","type":"cooccur","shared":4,"jaccard":0.083,"why":"4 verses are indexed under both"},{"id":"joshua","type":"cooccur","shared":5,"jaccard":0.034,"why":"5 verses are indexed under both"},{"id":"temple-the-second","type":"cooccur","shared":4,"jaccard":0.028,"why":"4 verses are indexed under both"},{"id":"sheal