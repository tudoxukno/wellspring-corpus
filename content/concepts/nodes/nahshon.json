{"id":"nahshon","name":"Nahshon","aliases":[],"sources":["nave","easton"],"topics":["nave:nahshon"],"groups":[],"definition":{"source":"easton","term":"Nahshon","text":"Sorcerer, the son of Aminadab, and prince of the children of Judah at the time of the first numbering of the tribes in the wilderness (Ex. 6:23). His sister Elisheba was the wife of Aaron. He died in the wilderness (Num. 26:64, 65). His name occurs in the Greek form Naasson in the genealogy of Christ (Matt, 1:4; Luke 3:32)."},"lemmas":[{"strong":"H5177","lemma":"נַחְשׁוֹן","xlit":"Nachshôwn","gloss":"Nachshon, an Israelite","kjv":"Naashon, Nahshon","count":7,"share":1},{"strong":"H5992","lemma":"עַמִּינָדָב","xlit":"ʻAmmîynâdâb","gloss":"Amminadab, the name of four Israelites","kjv":"Amminadab","count":7,"share":1},{"strong":"H1714","lemma":"דֶּגֶל","xlit":"degel","gloss":"a flag","kjv":"banner, standard","count":2,"share":0.29},{"strong":"H7133","lemma":"קׇרְבָּן","xlit":"qorbân","gloss":"something brought near the altar","kjv":"oblation, that is offered, offering","count":2,"share":0.29},{"strong":"H5387","lemma":"נָשִׂיא","xlit":"nâsîyʼ","gloss":"an exalted one","kjv":"captain, chief, cloud, governor","count":2,"share":0.29},{"strong":"H7223","lemma":"רִאשׁוֹן","xlit":"riʼshôwn","gloss":"first, in place, time or rank","kjv":"ancestor, before, beginning, eldest","count":2,"share":0.29}],"verses":["Exod.6.23","Num.1.7","Num.2.3","Num.7.12","Num.7.17","Num.10.14","1Chr.2.10"],"related":[{"id":"naashon","type":"cooccur","shared":6,"jaccard":0.667,"why":"6 verses are indexed under both"},{"id":"amminadab","type":"cooccur","shared":3,"jaccard":0.188,"why":"3 verses are indexed under both"},{"id":"judah-the-tribe-of","type":"cooccur","shared":5,"jaccard":0.036,"why":"5 verses are indexed under both"},{"id":"amminadab","type":"lexical","strong":"H5177","why":"both lead with נַחְשׁוֹן (H5177)"},{"id":"naashon","type":"lexical","strong":"H5177","why":"both lead with נַחְשׁוֹן (H5177)"}],"works":[]}
